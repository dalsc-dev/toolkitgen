{
  "name": "toolkitgen",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/check-copy.mjs && node scripts/check-html-tags.mjs && node scripts/generate-llms-txt.mjs && node scripts/generate-tools-json.mjs && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/check-limits.mjs && node scripts/check-tool-count.mjs && node scripts/check-emoji.mjs && node scripts/check-raw-latex.mjs && node scripts/check-titles.mjs && node scripts/check-left-borders.mjs && node scripts/check-perf-budgets.mjs && node scripts/ping-indexnow.mjs",
    "preview": "astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "new:tool": "node scripts/scaffold-tool.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:limits": "node scripts/check-limits.mjs",
    "check:count": "node scripts/check-tool-count.mjs",
    "check:emoji": "node scripts/check-emoji.mjs",
    "check:latex": "node scripts/check-raw-latex.mjs",
    "check:titles": "node scripts/check-titles.mjs",
    "check:borders": "node scripts/check-left-borders.mjs",
    "check:audit": "node scripts/verify-all-tools.mjs",
    "check:perf": "node scripts/check-perf-budgets.mjs",
    "check:lighthouse": "node scripts/check-mobile-lighthouse.mjs",
    "check:e2e": "node scripts/test-e2e-tools.mjs",
    "check:url": "node scripts/check-url-parity.mjs",
    "check:similarity": "node scripts/check-duplicate-content.mjs",
    "check:hang": "node scripts/hang-guard.mjs",
    "check:soak": "node scripts/soak-test.mjs",
    "ping:indexnow": "node scripts/ping-indexnow.mjs",
    "audit:seo": "node scripts/audit-seo-aeo.mjs"
  },
  "browserslist": [
    "defaults and fully supports es6-module"
  ],
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/preact": "^4.0.5",
    "@tailwindcss/vite": "^4.0.12",
    "astro": "^5.4.2",
    "js-yaml": "^4.1.0",
    "katex": "^0.19.1",
    "preact": "^10.26.4",
    "tailwindcss": "^4.0.12",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.10",
    "playwright": "^1.65.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "wrangler": "^3.111.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
