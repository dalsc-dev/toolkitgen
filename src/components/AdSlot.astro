---
import { ADSENSE_CONFIG, resolveSlot } from '../lib/ads';

interface Props {
  slotId?: string;
  format?: 'auto' | 'autorelaxed' | 'rectangle' | 'horizontal' | 'fluid';
  layout?: string;
  minHeight?: string;
  className?: string;
}

const {
  slotId = 'toolBottomBanner',
  format,
  layout,
  minHeight,
  className = '',
} = Astro.props;

const resolved = resolveSlot(slotId);
const isAdConfigured = Boolean(resolved && resolved.slotId);
const effectiveFormat = format || resolved?.format || 'auto';
const effectiveLayout = layout || resolved?.layout;
const isInArticle = effectiveLayout === 'in-article' || effectiveFormat === 'fluid';
const isFullWidthResponsive = resolved?.fullWidthResponsive ?? (!isInArticle && effectiveFormat !== 'autorelaxed');
const effectiveMinHeight = minHeight || (isInArticle ? '250px' : '280px');
const containerDomId = `ad-slot-${slotId}`;
---

<div
  id={containerDomId}
  class={`ad-container relative w-full my-8 bg-slate-50/70 border border-slate-200/80 rounded-2xl p-3 flex flex-col items-center justify-center overflow-hidden transition-all ${className}`}
  style={`min-height: ${effectiveMinHeight}; contain: layout style;`}
  data-ad-slot={resolved?.slotId || 'auto'}
>
  <span class="text-[10px] uppercase font-bold tracking-widest text-slate-400 mb-2 select-none">Advertisement</span>
  
  {isAdConfigured ? (
    <ins
      class="adsbygoogle"
      style={isInArticle ? "display:block; text-align:center;" : "display:block; width:100%; min-height: 250px;"}
      data-ad-client={ADSENSE_CONFIG.publisherId}
      data-ad-slot={resolved!.slotId}
      data-ad-layout={effectiveLayout || undefined}
      data-ad-format={effectiveFormat}
      data-full-width-responsive={isFullWidthResponsive ? "true" : undefined}
    ></ins>
  ) : (
    <ins
      class="adsbygoogle"
      style="display:block; width:100%; min-height: 250px;"
      data-ad-client={ADSENSE_CONFIG.publisherId}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
  )}

  <script is:inline define:vars={{ containerDomId }}>
    (function() {
      function initSlot() {
        var container = document.getElementById(containerDomId);
        if (!container) return;
        var ins = container.querySelector('ins.adsbygoogle');
        if (!ins || ins.getAttribute('data-adsbygoogle-status')) return;

        function pushSlot() {
          if (ins.getAttribute('data-adsbygoogle-status')) return true;
          try {
            (window.adsbygoogle = window.adsbygoogle || []).push({});
            return true;
          } catch (e) {
            return false;
          }
        }

        if (typeof IntersectionObserver !== 'undefined') {
          var io = new IntersectionObserver(function(entries) {
            for (var i = 0; i < entries.length; i++) {
              var entry = entries[i];
              if (entry.isIntersecting && entry.boundingClientRect.width > 0) {
                if (pushSlot()) {
                  io.disconnect();
                  break;
                }
              }
            }
          }, { rootMargin: '300px 0px' });
          io.observe(container);
        } else {
          var defer = window.requestIdleCallback || function(cb) { setTimeout(cb, 1000); };
          defer(function() { pushSlot(); });
        }
      }

      var schedule = window.requestIdleCallback || function(cb) { setTimeout(cb, 500); };
      if (document.readyState === 'complete') {
        schedule(initSlot);
      } else {
        window.addEventListener('load', function() { schedule(initSlot); }, { once: true, passive: true });
      }
    })();
  </script>
</div>
