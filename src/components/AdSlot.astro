---
import { ADSENSE_CONFIG, resolveSlot } from '../lib/ads';

interface Props {
  slotId?: string;
  className?: string;
}

const {
  slotId = 'toolBottomBanner',
  className = '',
} = Astro.props;

const resolved = resolveSlot(slotId);
// Only render if a real numeric slot ID is configured
const hasNumericId = Boolean(resolved && resolved.slotId && /^\d+$/.test(resolved.slotId));
---

{hasNumericId && (
  <div class={`manual-ad-wrapper my-8 ${className}`}>
    <p class="ad-label" style="display:none; font-size:11px; color:#94a3b8; text-align:center; margin:0 0 6px 0; font-family:sans-serif; text-transform:uppercase; letter-spacing:0.05em;">Advertisement</p>
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={ADSENSE_CONFIG.publisherId}
      data-ad-slot={resolved!.slotId}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>
      (function() {
        var currentScript = document.currentScript;
        if (!currentScript) return;
        var parent = currentScript.parentElement;
        if (!parent) return;
        var ins = parent.querySelector('ins.adsbygoogle');
        var label = parent.querySelector('.ad-label');
        if (!ins) return;

        // Never push on non-production hosts
        var isProd = window.location.hostname === 'toolkitgen.com' || window.location.hostname.endsWith('.toolkitgen.com');
        if (!isProd) return;

        function checkStatus() {
          if (ins.getAttribute('data-ad-status') === 'filled') {
            if (label) label.style.display = 'block';
          } else {
            if (label) label.style.display = 'none';
          }
        }

        if (typeof MutationObserver !== 'undefined') {
          var mo = new MutationObserver(checkStatus);
          mo.observe(ins, { attributes: true, attributeFilter: ['data-ad-status'] });
        }

        function pushAd() {
          if (ins.getAttribute('data-adsbygoogle-status')) return;
          try {
            (window.adsbygoogle = window.adsbygoogle || []).push({});
          } catch (e) {}
        }

        if (typeof IntersectionObserver !== 'undefined') {
          var io = new IntersectionObserver(function(entries) {
            for (var i = 0; i < entries.length; i++) {
              if (entries[i].isIntersecting) {
                pushAd();
                io.disconnect();
                break;
              }
            }
          }, { rootMargin: '200px 0px' });
          io.observe(ins);
        } else {
          pushAd();
        }
      })();
    </script>
  </div>
)}
