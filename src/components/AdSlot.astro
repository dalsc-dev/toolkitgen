---
interface Props {
  slotId?: string;
  format?: 'auto' | 'rectangle' | 'horizontal';
  minHeight?: string;
  className?: string;
}

const {
  slotId = '1234567890',
  format = 'auto',
  minHeight = '280px',
  className = '',
} = Astro.props;
---

<div
  id={`ad-slot-${slotId}`}
  class={`ad-container relative w-full my-8 bg-slate-50/60 border border-slate-200/80 rounded-2xl p-3 flex flex-col items-center justify-center overflow-hidden transition-all ${className}`}
  style={`min-height: ${minHeight}; contain: layout style;`}
  data-ad-slot={slotId}
>
  <span class="text-[10px] uppercase font-bold tracking-widest text-slate-400 mb-2 select-none">Advertisement</span>
  
  <ins
    class="adsbygoogle"
    style="display:block; width:100%;"
    data-ad-client="ca-pub-4675079345370949"
    data-ad-slot={slotId}
    data-ad-format={format}
    data-full-width-responsive="true"
  ></ins>

  <script is:inline>
    (function() {
      try {
        if (typeof window !== 'undefined') {
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        }
      } catch (e) {
        // Suppress unhandled ad-block errors
      }
    })();
  </script>
</div>
