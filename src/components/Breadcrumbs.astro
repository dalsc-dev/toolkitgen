---
interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav class="flex text-sm text-slate-500 mb-6" aria-label="Breadcrumb">
  <ol class="inline-flex flex-wrap items-center space-x-1 md:space-x-2">
    <li class="inline-flex items-center">
      <a href="/" class="inline-flex items-center hover:text-[#EE6C4D] transition-colors">
        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
        </svg>
        Home
      </a>
    </li>
    {items.map((item, index) => (
      <li class="inline-flex items-center">
        <span class="mx-2 text-slate-400">/</span>
        {index === items.length - 1 ? (
          <span class="text-slate-800 font-semibold truncate max-w-xs sm:max-w-md" aria-current="page">{item.name}</span>
        ) : (
          <a href={item.url} class="hover:text-[#EE6C4D] transition-colors whitespace-nowrap">{item.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
