---
interface Props {
  variant?: 'info' | 'tip' | 'warning' | 'note';
  title?: string;
  class?: string;
}

const { variant = 'note', title, class: extraClass = '' } = Astro.props;

const variants = {
  info: {
    container: 'bg-blue-50/80 border-blue-200/80 text-blue-950',
    titleColor: 'text-blue-900',
    iconColor: 'text-blue-600',
    defaultTitle: 'Information',
    svg: `<svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`
  },
  tip: {
    container: 'bg-emerald-50/80 border-emerald-200/80 text-emerald-950',
    titleColor: 'text-emerald-900',
    iconColor: 'text-emerald-600',
    defaultTitle: 'Pro Tip',
    svg: `<svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>`
  },
  warning: {
    container: 'bg-amber-50/80 border-amber-200/80 text-amber-950',
    titleColor: 'text-amber-900',
    iconColor: 'text-amber-600',
    defaultTitle: 'Caution',
    svg: `<svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>`
  },
  note: {
    container: 'bg-slate-50 border-slate-200 text-slate-800',
    titleColor: 'text-slate-900',
    iconColor: 'text-[#EE6C4D]',
    defaultTitle: 'Note',
    svg: `<svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>`
  }
};

const v = variants[variant] || variants.note;
const heading = title || v.defaultTitle;
---

<div class={`my-6 rounded-xl border p-4 sm:p-5 shadow-2xs ${v.container} ${extraClass}`} role="note">
  <div class="flex items-start gap-3">
    <div class={`mt-0.5 ${v.iconColor}`} aria-hidden="true">
      <Fragment set:html={v.svg} />
    </div>
    <div class="flex-1 space-y-1">
      {heading && (
        <h4 class={`text-sm font-bold tracking-tight m-0 p-0 ${v.titleColor}`}>
          {heading}
        </h4>
      )}
      <div class="text-sm leading-relaxed text-inherit prose-p:my-1 prose-p:leading-relaxed">
        <slot />
      </div>
    </div>
  </div>
</div>
