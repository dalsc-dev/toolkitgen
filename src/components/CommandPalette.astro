---
// Command Palette Component with Lazy-Loaded Search Index & Fuzzy Matching
---

<div
  id="cmd-palette-modal"
  class="fixed inset-0 z-[100] bg-slate-900/60 backdrop-blur-sm hidden flex items-start justify-center pt-16 sm:pt-24 px-4 transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-label="Search Tools & Documentation"
>
  <div
    id="cmd-palette-card"
    class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-2xl overflow-hidden flex flex-col max-h-[80vh] animate-scale-up"
  >
    <!-- Search Bar Input Header -->
    <div class="flex items-center px-4 py-3.5 border-b border-slate-100 gap-3">
      <svg class="w-5 h-5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <input
        type="text"
        id="cmd-palette-input"
        placeholder="Type a tool name, formula, or keyword..."
        autocomplete="off"
        spellcheck="false"
        class="w-full bg-transparent border-none outline-none text-slate-800 placeholder-slate-400 text-base font-medium"
      />
      <button
        id="cmd-palette-close"
        aria-label="Close search"
        class="text-slate-400 hover:text-slate-600 p-1 rounded-lg hover:bg-slate-100 transition-colors"
      >
        <kbd class="text-xs font-mono bg-slate-100 border border-slate-200 px-1.5 py-0.5 rounded text-slate-500">ESC</kbd>
      </button>
    </div>

    <!-- Results List or Empty State -->
    <div
      id="cmd-palette-results"
      class="overflow-y-auto p-3 space-y-4 max-h-[calc(80vh-60px)] divide-y divide-slate-100"
    >
      <!-- Initial Quick State populated via JavaScript -->
      <div id="cmd-initial-state" class="space-y-4">
        <div>
          <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 px-3 py-1">Quick Actions</div>
          <button
            type="button"
            data-action="zen-mode"
            class="cmd-item w-full flex items-center justify-between p-3 rounded-xl hover:bg-slate-50 transition-colors text-left group"
          >
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
                </svg>
              </div>
              <div>
                <span class="text-sm font-semibold text-slate-800 group-hover:text-[#EE6C4D]">Toggle Zen Mode</span>
                <p class="text-xs text-slate-500">Switch high-contrast focused workspace</p>
              </div>
            </div>
            <span class="text-xs font-mono text-slate-400 bg-slate-100 px-2 py-1 rounded">Shift + Z</span>
          </button>
        </div>

        <div>
          <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 px-3 py-1">Popular Tools</div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mt-1">
            <a href="/tool/docker_compose_linter" class="cmd-item flex items-center gap-2.5 p-2.5 rounded-xl hover:bg-slate-50 transition-colors text-slate-700 hover:text-[#EE6C4D]">
              <div class="w-2 h-2 rounded-full bg-blue-500"></div>
              <span class="text-xs font-semibold truncate">Docker Compose Linter</span>
            </a>
            <a href="/tool/amsler_grid_macular" class="cmd-item flex items-center gap-2.5 p-2.5 rounded-xl hover:bg-slate-50 transition-colors text-slate-700 hover:text-[#EE6C4D]">
              <div class="w-2 h-2 rounded-full bg-teal-500"></div>
              <span class="text-xs font-semibold truncate">Amsler Grid Online Test</span>
            </a>
            <a href="/tool/airdrop_web_universal" class="cmd-item flex items-center gap-2.5 p-2.5 rounded-xl hover:bg-slate-50 transition-colors text-slate-700 hover:text-[#EE6C4D]">
              <div class="w-2 h-2 rounded-full bg-indigo-500"></div>
              <span class="text-xs font-semibold truncate">Web AirDrop Local Chunker</span>
            </a>
            <a href="/tool/black_scholes_heatmap" class="cmd-item flex items-center gap-2.5 p-2.5 rounded-xl hover:bg-slate-50 transition-colors text-slate-700 hover:text-[#EE6C4D]">
              <div class="w-2 h-2 rounded-full bg-amber-500"></div>
              <span class="text-xs font-semibold truncate">Black-Scholes Heatmap</span>
            </a>
          </div>
        </div>
      </div>

        <!-- Rendered search results go here -->
      <div id="cmd-dynamic-results" class="hidden space-y-4"></div>
    </div>

    <!-- Keyboard Navigation Footer Help -->
    <div class="px-4 py-2.5 bg-slate-50 border-t border-slate-100 text-[11px] text-slate-500 flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-3">
        <span><kbd class="font-mono bg-white border border-slate-200 px-1 py-0.5 rounded shadow-2xs">↑</kbd> <kbd class="font-mono bg-white border border-slate-200 px-1 py-0.5 rounded shadow-2xs">↓</kbd> to navigate</span>
        <span><kbd class="font-mono bg-white border border-slate-200 px-1.5 py-0.5 rounded shadow-2xs">ENTER</kbd> to select</span>
        <span><kbd class="font-mono bg-white border border-slate-200 px-1 py-0.5 rounded shadow-2xs">ESC</kbd> to close</span>
      </div>
      <span class="text-slate-400">Search runs in your browser</span>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    let searchIndex = null;
    let isLoading = false;
    let activeResultIndex = -1;
    let currentResults = [];

    const modal = document.getElementById('cmd-palette-modal');
    const input = document.getElementById('cmd-palette-input');
    const closeBtn = document.getElementById('cmd-palette-close');
    const resultsContainer = document.getElementById('cmd-dynamic-results');
    const initialState = document.getElementById('cmd-initial-state');

    async function loadSearchIndex() {
      if (searchIndex || isLoading) return;
      isLoading = true;
      try {
        const res = await fetch('/search-index.json');
        if (res.ok) {
          searchIndex = await res.json();
        }
      } catch (err) {
        console.error('Failed to load search index', err);
      } finally {
        isLoading = false;
      }
    }

    function openPalette(initialQuery = '') {
      modal?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      loadSearchIndex().then(() => {
        if (initialQuery) {
          if (input) {
            input.value = initialQuery;
            performSearch(initialQuery);
          }
        }
      });
      setTimeout(() => input?.focus(), 50);
    }

    function closePalette() {
      modal?.classList.add('hidden');
      document.body.style.overflow = '';
      if (input) input.value = '';
      resultsContainer?.classList.add('hidden');
      initialState?.classList.remove('hidden');
      activeResultIndex = -1;
      currentResults = [];
    }

    // Fuzzy scoring algorithm: title > aliases > tags > description
    function scoreItem(item, query) {
      const q = query.toLowerCase().trim();
      if (!q) return 0;
      const title = (item.title || '').toLowerCase();
      const desc = (item.description || '').toLowerCase();
      const aliases = (item.aliases || []).map(a => a.toLowerCase());
      const tags = (item.tags || []).map(t => t.toLowerCase());

      let score = 0;
      if (title === q) score += 1000;
      else if (title.startsWith(q)) score += 500;
      else if (title.includes(q)) score += 300;

      const words = q.split(/\s+/).filter(Boolean);
      if (words.length > 1 && words.every(w => title.includes(w))) {
        score += 250;
      }

      for (const alias of aliases) {
        if (alias === q) score += 180;
        else if (alias.includes(q)) score += 120;
      }

      for (const tag of tags) {
        if (tag === q) score += 100;
        else if (tag.includes(q)) score += 80;
      }

      if (desc.includes(q)) score += 50;
      else if (words.length > 1 && words.every(w => desc.includes(w))) {
        score += 30;
      }

      return score;
    }

    function performSearch(query) {
      const q = query.trim();
      if (!q || !searchIndex) {
        resultsContainer?.classList.add('hidden');
        initialState?.classList.remove('hidden');
        currentResults = [];
        activeResultIndex = -1;
        return;
      }

      initialState?.classList.add('hidden');
      resultsContainer?.classList.remove('hidden');

      const scored = [];
      for (const item of searchIndex) {
        const score = scoreItem(item, q);
        if (score > 0) {
          scored.push({ item, score });
        }
      }

      scored.sort((a, b) => b.score - a.score);
      currentResults = scored.slice(0, 20).map(s => s.item);
      activeResultIndex = currentResults.length > 0 ? 0 : -1;

      renderResults(currentResults, q);
    }

    function renderResults(results, query) {
      if (!resultsContainer) return;

      if (results.length === 0) {
        resultsContainer.innerHTML = `
          <div class="text-center py-12 px-4">
            <svg class="w-10 h-10 text-slate-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <p class="text-sm font-semibold text-slate-700">No tools found matching "${query}"</p>
            <p class="text-xs text-slate-400 mt-1">Try a different formula name, acronym or category.</p>
          </div>
        `;
        return;
      }

      // Group by category
      const groups = {};
      results.forEach((item, index) => {
        const cat = item.category || 'General';
        if (!groups[cat]) groups[cat] = [];
        groups[cat].push({ item, originalIndex: index });
      });

      let html = '';
      for (const [category, items] of Object.entries(groups)) {
        html += `
          <div>
            <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 px-3 py-1">${category}</div>
            <div class="space-y-1 mt-1">
        `;

        for (const { item, originalIndex } of items) {
          const isActive = originalIndex === activeResultIndex;
          html += `
            <a
              href="${item.url}"
              data-index="${originalIndex}"
              class="cmd-result-item flex items-center justify-between p-3 rounded-xl transition-all ${
                isActive ? 'bg-[#EE6C4D]/10 text-slate-900 ring-1 ring-[#EE6C4D]' : 'hover:bg-slate-50 text-slate-700'
              }"
            >
              <div class="min-w-0 flex-1 pr-3">
                <div class="text-sm font-bold text-slate-800 truncate">${item.title}</div>
                <p class="text-xs text-slate-500 truncate mt-0.5">${item.description}</p>
              </div>
              <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          `;
        }

        html += `
            </div>
          </div>
        `;
      }

      resultsContainer.innerHTML = html;
    }

    function updateActiveItem() {
      const allResultElements = resultsContainer?.querySelectorAll('.cmd-result-item');
      if (!allResultElements) return;

      allResultElements.forEach((el) => {
        const idx = parseInt(el.getAttribute('data-index') || '-1', 10);
        if (idx === activeResultIndex) {
          el.className = 'cmd-result-item flex items-center justify-between p-3 rounded-xl transition-all bg-[#EE6C4D]/10 text-slate-900 ring-1 ring-[#EE6C4D]';
          el.scrollIntoView({ block: 'nearest' });
        } else {
          el.className = 'cmd-result-item flex items-center justify-between p-3 rounded-xl transition-all hover:bg-slate-50 text-slate-700';
        }
      });
    }

    // Input listeners
    input?.addEventListener('input', (e) => {
      performSearch(e.target.value);
    });

    input?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (currentResults.length > 0) {
          activeResultIndex = (activeResultIndex + 1) % currentResults.length;
          updateActiveItem();
        }
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (currentResults.length > 0) {
          activeResultIndex = (activeResultIndex - 1 + currentResults.length) % currentResults.length;
          updateActiveItem();
        }
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (activeResultIndex >= 0 && activeResultIndex < currentResults.length) {
          window.location.href = currentResults[activeResultIndex].url;
        }
      } else if (e.key === 'Escape') {
        e.preventDefault();
        closePalette();
      }
    });

    closeBtn?.addEventListener('click', closePalette);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        closePalette();
      }
    });

    // Global keyboard triggers (Cmd+K, Ctrl+K, /)
    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        if (modal?.classList.contains('hidden')) {
          openPalette();
        } else {
          closePalette();
        }
      } else if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
        e.preventDefault();
        openPalette();
      }
    });

    // Check for triggers with [data-open-cmd]
    document.addEventListener('click', (e) => {
      const target = e.target.closest('[data-open-cmd]');
      if (target) {
        e.preventDefault();
        openPalette();
      }
      const zenTarget = e.target.closest('[data-action="zen-mode"]');
      if (zenTarget) {
        e.preventDefault();
        document.body.classList.toggle('zen-mode');
        localStorage.setItem('tk_zen_mode', document.body.classList.contains('zen-mode') ? 'true' : 'false');
        closePalette();
      }
    });

    // Check URL parameter /?q=term
    const urlParams = new URLSearchParams(window.location.search);
    const initialQ = urlParams.get('q');
    if (initialQ) {
      openPalette(initialQ);
    }

    // Expose globally
    window.openCommandPalette = openPalette;
    window.closeCommandPalette = closePalette;
  })();
</script>
