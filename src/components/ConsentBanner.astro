---
// Google Consent Mode v2 + GDPR / ePrivacy Compliant Banner & Preferences Modal
---

<!-- Consent Banner -->
<div
  id="consent-banner"
  class="fixed bottom-0 inset-x-0 md:bottom-6 md:left-6 md:right-auto md:max-w-md lg:max-w-lg z-[80] bg-white/95 backdrop-blur-md rounded-t-2xl md:rounded-2xl shadow-2xl border border-slate-200/90 p-5 md:p-6 hidden transition-all duration-300 pb-[max(1.25rem,env(safe-area-inset-bottom))]"
  role="region"
  aria-label="Privacy and Cookie Consent"
>
  <div class="flex items-start gap-3.5">
    <div class="w-9 h-9 rounded-xl bg-orange-50 text-[#EE6C4D] flex items-center justify-center shrink-0 mt-0.5" aria-hidden="true">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
      </svg>
    </div>
    <div class="space-y-1.5 flex-1 min-w-0">
      <h3 class="text-sm font-bold text-slate-900 tracking-tight">Privacy &amp; Cookie Choices</h3>
      <p class="text-xs text-slate-600 leading-relaxed">
        We use essential browser storage for site features. With your permission we also use cookies for analytics and advertising. See our <a href="/privacy" class="text-[#EE6C4D] underline hover:text-[#d75a3c] focus:outline-none focus:ring-1 focus:ring-[#EE6C4D] rounded">Privacy Policy</a>.
      </p>
    </div>
  </div>

  <div class="mt-4 pt-3 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3">
    <button
      type="button"
      id="consent-manage-open"
      class="text-xs font-semibold text-slate-600 hover:text-slate-900 underline hover:no-underline min-h-[44px] flex items-center px-1 focus:outline-none focus:ring-2 focus:ring-[#EE6C4D] rounded"
    >
      Manage choices
    </button>
    <div class="flex items-center gap-2">
      <button
        type="button"
        id="consent-reject"
        class="min-h-[44px] px-4 py-2 text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-200 rounded-xl transition-all focus:outline-none focus:ring-2 focus:ring-slate-400"
      >
        Essential Only
      </button>
      <button
        type="button"
        id="consent-accept"
        class="min-h-[44px] px-5 py-2 text-xs font-bold text-white bg-[#C44322] hover:bg-[#b03a1b] rounded-xl shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-[#C44322]"
      >
        Accept All
      </button>
    </div>
  </div>
</div>

<!-- Manage Choices Modal -->
<div
  id="consent-modal"
  class="fixed inset-0 z-[90] bg-slate-900/60 backdrop-blur-xs hidden flex items-center justify-center p-4 transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="consent-modal-title"
>
  <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl border border-slate-200 space-y-6 animate-fade-up">
    <div class="flex items-center justify-between border-b border-slate-100 pb-4">
      <h3 id="consent-modal-title" class="text-lg font-bold text-slate-900">
        Cookie &amp; Storage Preferences
      </h3>
      <button
        type="button"
        id="consent-modal-close"
        class="w-8 h-8 rounded-full bg-slate-100 text-slate-500 hover:text-slate-800 flex items-center justify-center transition-colors focus:outline-none focus:ring-2 focus:ring-[#EE6C4D]"
        aria-label="Close dialog without saving"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div class="space-y-4 max-h-[60vh] overflow-y-auto pr-1">
      <!-- Essential -->
      <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 flex items-start justify-between gap-4">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <h4 class="text-sm font-bold text-slate-900">Essential Browser Storage</h4>
            <span class="text-[10px] font-bold uppercase tracking-wider bg-slate-200 text-slate-700 px-2 py-0.5 rounded">Always Active</span>
          </div>
          <p class="text-xs text-slate-500 leading-relaxed">
            Required for local utility operations, offline scratchpad memory, and UI accessibility preferences. No identifiers are sent to remote servers.
          </p>
        </div>
      </div>

      <!-- Analytics -->
      <div class="p-4 rounded-2xl bg-white border border-slate-200/80 flex items-start justify-between gap-4">
        <div class="space-y-1">
          <h4 class="text-sm font-bold text-slate-900">Site Performance &amp; Analytics</h4>
          <p class="text-xs text-slate-500 leading-relaxed">
            Helps us understand aggregated traffic volume and page speed with privacy-preserving telemetry (Cloudflare Web Analytics).
          </p>
        </div>
        <label class="relative inline-flex items-center cursor-pointer shrink-0 mt-1">
          <input type="checkbox" id="consent-toggle-analytics" class="sr-only peer">
          <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-[#EE6C4D] rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#EE6C4D]"></div>
        </label>
      </div>

      <!-- Advertising -->
      <div class="p-4 rounded-2xl bg-white border border-slate-200/80 flex items-start justify-between gap-4">
        <div class="space-y-1">
          <h4 class="text-sm font-bold text-slate-900">Advertising &amp; Measurement</h4>
          <p class="text-xs text-slate-500 leading-relaxed">
            Allows Google AdSense to serve non-intrusive advertisements that fund the free development and hosting of this directory.
          </p>
        </div>
        <label class="relative inline-flex items-center cursor-pointer shrink-0 mt-1">
          <input type="checkbox" id="consent-toggle-ads" class="sr-only peer">
          <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-[#EE6C4D] rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#EE6C4D]"></div>
        </label>
      </div>
    </div>

    <div class="pt-2 border-t border-slate-100 flex items-center justify-end gap-3">
      <button
        type="button"
        id="consent-modal-save"
        class="min-h-[44px] px-6 py-2.5 text-xs font-bold text-white bg-slate-900 hover:bg-slate-800 rounded-xl shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-slate-900"
      >
        Save Preferences
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const banner = document.getElementById('consent-banner');
    const modal = document.getElementById('consent-modal');

    const btnAccept = document.getElementById('consent-accept');
    const btnReject = document.getElementById('consent-reject');
    const btnManageOpen = document.getElementById('consent-manage-open');
    const btnModalClose = document.getElementById('consent-modal-close');
    const btnModalSave = document.getElementById('consent-modal-save');
    const toggleAnalytics = document.getElementById('consent-toggle-analytics');
    const toggleAds = document.getElementById('consent-toggle-ads');

    function updateDockOffset(bannerOpen) {
      const currentDock = document.getElementById('floating-dock-pill');
      if (!currentDock) return;
      if (bannerOpen) {
        if (window.innerWidth < 768) {
          currentDock.style.display = 'none';
        } else {
          currentDock.style.display = 'flex';
        }
      } else {
        currentDock.style.display = 'flex';
      }
    }

    window.addEventListener('resize', () => {
      if (banner && !banner.classList.contains('hidden')) {
        updateDockOffset(true);
      }
    });

    function applyConsent(analytics, ads) {
      const state = {
        analytics: !!analytics,
        ads: !!ads,
        timestamp: new Date().toISOString()
      };
      localStorage.setItem('tg_cookie_consent_v2', JSON.stringify(state));

      if (typeof window.gtag === 'function') {
        window.gtag('consent', 'update', {
          'analytics_storage': analytics ? 'granted' : 'denied',
          'ad_storage': ads ? 'granted' : 'denied',
          'ad_user_data': ads ? 'granted' : 'denied',
          'ad_personalization': ads ? 'granted' : 'denied'
        });
      }

      if (typeof window.initThirdPartyServices === 'function') {
        window.initThirdPartyServices();
      }

      if (banner) banner.classList.add('hidden');
      if (modal) modal.classList.add('hidden');
      updateDockOffset(false);
    }

    function showBanner() {
      if (banner) {
        banner.classList.remove('hidden');
        updateDockOffset(true);
      }
    }

    function openModal() {
      try {
        const raw = localStorage.getItem('tg_cookie_consent_v2');
        if (raw) {
          const state = JSON.parse(raw);
          if (toggleAnalytics) toggleAnalytics.checked = !!state.analytics;
          if (toggleAds) toggleAds.checked = !!state.ads;
        } else {
          if (toggleAnalytics) toggleAnalytics.checked = false;
          if (toggleAds) toggleAds.checked = false;
        }
      } catch (e) {}

      if (modal) modal.classList.remove('hidden');
    }

    // Check existing consent
    try {
      const existing = localStorage.getItem('tg_cookie_consent_v2');
      if (!existing) {
        showBanner();
      } else {
        const parsed = JSON.parse(existing);
        if (typeof window.gtag === 'function') {
          window.gtag('consent', 'update', {
            'analytics_storage': parsed.analytics ? 'granted' : 'denied',
            'ad_storage': parsed.ads ? 'granted' : 'denied',
            'ad_user_data': parsed.ads ? 'granted' : 'denied',
            'ad_personalization': parsed.ads ? 'granted' : 'denied'
          });
        }
      }
    } catch (e) {
      showBanner();
    }

    btnAccept?.addEventListener('click', () => applyConsent(true, true));
    btnReject?.addEventListener('click', () => applyConsent(false, false));
    btnManageOpen?.addEventListener('click', () => openModal());
    btnModalClose?.addEventListener('click', () => {
      if (modal) modal.classList.add('hidden');
    });
    btnModalSave?.addEventListener('click', () => {
      applyConsent(toggleAnalytics?.checked, toggleAds?.checked);
    });

    // Handle Escape key on modal
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        modal.classList.add('hidden');
      }
    });

    // Expose reopen function globally for footer link
    window.openCookiePreferences = () => {
      openModal();
    };
  })();
</script>
