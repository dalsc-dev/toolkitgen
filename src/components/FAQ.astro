---
interface FAQItem {
  q: string;
  a: string;
}

interface Props {
  items: FAQItem[];
}

const { items } = Astro.props;
---

{items && items.length > 0 && (
  <section class="my-12">
    <div class="mb-6">
      <h2 class="text-2xl font-black text-slate-900 tracking-tight">Frequently Asked Questions</h2>
      <p class="text-sm text-slate-500 mt-1">Key technical, privacy, and usage answers regarding this tool.</p>
    </div>

    <div class="space-y-4">
      {items.map((item) => (
        <details class="group bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden transition-all duration-200 hover:border-slate-300">
          <summary class="flex items-center justify-between p-5 font-bold text-slate-900 cursor-pointer select-none text-base list-none">
            <span>{item.q}</span>
            <span class="ml-4 w-7 h-7 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 group-open:rotate-180 transition-transform shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </span>
          </summary>
          <div class="px-5 pb-5 text-sm text-slate-600 leading-relaxed border-t border-slate-100 pt-3">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </section>
)}
