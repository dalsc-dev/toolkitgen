---
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto bg-[#1e293b] text-slate-300 border-t border-slate-800">
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 mb-12">
      <!-- Col 1: Brand & Privacy Promise -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-[#EE6C4D] flex items-center justify-center text-white font-black text-sm">
            TG
          </div>
          <span class="text-xl font-extrabold text-white">Toolkit<span class="text-[#EE6C4D]">Gen</span></span>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed max-w-sm">
          A suite of 126 free online utilities, calculators, and diagnostic tools. Tool inputs are processed entirely in your web browser and never uploaded to remote servers.
        </p>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-950/60 border border-emerald-500/30 text-emerald-400 text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Zero Server-Side Logging
        </div>
      </div>

      <!-- Col 2: Hubs & Suites -->
      <div class="space-y-3">
        <h4 class="text-xs font-black uppercase tracking-wider text-slate-100">Specialized Hubs</h4>
        <ul class="space-y-2 text-sm text-slate-400">
          <li><a href="/hubs/freelancer" class="hover:text-white transition-colors">Freelancer & Creator OS</a></li>
          <li><a href="/hubs/startup" class="hover:text-white transition-colors">Founder's Forge Startup OS</a></li>
          <li><a href="/hubs/wellness" class="hover:text-white transition-colors">Mental Focus & Wellness</a></li>
          <li><a href="/tool" class="hover:text-white transition-colors">Browse All 126 Tools</a></li>
        </ul>
      </div>

      <!-- Col 3: Categories -->
      <div class="space-y-3">
        <h4 class="text-xs font-black uppercase tracking-wider text-slate-100">Categories</h4>
        <ul class="space-y-2 text-sm text-slate-400">
          <li><a href="/category/clinical-health" class="hover:text-white transition-colors">Health & Diagnostics</a></li>
          <li><a href="/category/hardware" class="hover:text-white transition-colors">Hardware & Monitors</a></li>
          <li><a href="/category/devops" class="hover:text-white transition-colors">DevOps & Code</a></li>
          <li><a href="/category/audio" class="hover:text-white transition-colors">Audio & Sound</a></li>
          <li><a href="/category/privacy" class="hover:text-white transition-colors">Security & Privacy</a></li>
        </ul>
      </div>

      <!-- Col 4: Trust & Compliance -->
      <div class="space-y-3">
        <h4 class="text-xs font-black uppercase tracking-wider text-slate-100">Transparency & Legal</h4>
        <ul class="space-y-2 text-sm text-slate-400">
          <li><a href="/about" class="hover:text-white transition-colors">About & Team</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors">Contact Support</a></li>
          <li><a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-white transition-colors">Terms of Service</a></li>
          <li><a href="/disclaimer" class="hover:text-white transition-colors">Medical & Financial Disclaimer</a></li>
          <li><a href="/sitemap.html" class="hover:text-white transition-colors">HTML Sitemap</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>&copy; {currentYear} ToolkitGen. All rights reserved. Calculations are for educational and informational purposes only.</p>
      <p class="flex items-center gap-4">
        <span>Hosted on Cloudflare Workers</span>
        <span>•</span>
        <span>Built with Astro &amp; Tailwind CSS</span>
      </p>
    </div>
  </div>
</footer>
