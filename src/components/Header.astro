---
interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
---

<header
  id="app-header"
  class="fixed top-3 md:top-5 left-0 right-0 mx-auto w-[calc(100%-2rem)] md:w-[95%] max-w-5xl z-[100] bg-white/85 backdrop-blur-md border border-slate-200 shadow-xl shadow-slate-200/40 rounded-3xl min-w-0 animate-nav-down"
>
  <nav
    id="main-nav-bar"
    class="w-full h-14 md:h-16 px-4 md:px-6 flex items-center justify-between min-w-0 relative"
    role="navigation"
    aria-label="Main Navigation"
  >
    <!-- Brand Logo Lockup -->
    <div class="flex items-center gap-2 min-w-0 relative z-10 flex-shrink-0">
      <a
        href="/"
        aria-label="Toolkit Gen Home"
        class="text-[#EE6C4D] hover:text-[#d75a3c] transition focus:outline-none rounded flex-shrink-0"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-8 h-8">
          <path
            d="M11.47 3.84a.75.75 0 0 1 1.06 0l8.69 8.69a.75.75 0 1 0 1.06-1.06l-8.689-8.69a2.25 2.25 0 0 0-3.182 0l-8.69 8.69a.75.75 0 0 0 1.061 1.06l8.69-8.69Z"
          ></path>
        </svg>
      </a>
      <a
        href="/"
        class="text-xl font-extrabold text-[#33333B] tracking-tight whitespace-nowrap hidden sm:block flex-shrink-0 outline-none focus:ring-2 focus:ring-slate-300 rounded"
      >
        Toolkit Gen
      </a>
    </div>

    <!-- Desktop Navigation Links -->
    <div class="hidden lg:flex items-center gap-3 xl:gap-5 flex-shrink-0 relative z-10">
      <!-- Trending Dropdown -->
      <div class="relative group flex-shrink-0">
        <a
          href="/#featured"
          class="nav-link text-sm font-bold text-gray-600 group-hover:text-[#EE6C4D] transition outline-none focus:ring-2 focus:ring-[#EE6C4D] rounded py-2"
        >
          Trending
        </a>
        <div
          class="opacity-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto absolute top-full left-1/2 -translate-x-1/2 pt-4 z-[9999] transition-opacity duration-200"
        >
          <div
            class="bg-white/95 backdrop-blur-xl rounded-2xl shadow-2xl shadow-slate-200/40 border border-slate-100 p-3 w-80 flex flex-col gap-1.5"
          >
            <h4 class="text-[10px] uppercase font-black tracking-wider text-slate-400 mb-1 px-2">Top Tools</h4>
            <a href="/tool/sqlite_wasm_explorer" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-slate-50 transition group/item">
              <div class="w-10 h-10 rounded-lg bg-indigo-50 flex items-center justify-center flex-shrink-0 text-indigo-500 group-hover/item:bg-white group-hover/item:shadow-sm transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path></svg>
              </div>
              <div>
                <h5 class="text-xs font-bold text-slate-800 group-hover/item:text-[#EE6C4D] transition-colors">SQLite WASM Explorer</h5>
                <p class="text-[10px] text-slate-500 line-clamp-1">In-browser SQL database sandbox</p>
              </div>
            </a>
            <a href="/tool/prompt_template_builder" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-slate-50 transition group/item">
              <div class="w-10 h-10 rounded-lg bg-purple-50 flex items-center justify-center flex-shrink-0 text-purple-500 group-hover/item:bg-white group-hover/item:shadow-sm transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
              </div>
              <div>
                <h5 class="text-xs font-bold text-slate-800 group-hover/item:text-[#EE6C4D] transition-colors">AI Prompt Builder</h5>
                <p class="text-[10px] text-slate-500 line-clamp-1">Design structured LLM prompts</p>
              </div>
            </a>
            <a href="/tool/black_scholes_heatmap" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-slate-50 transition group/item">
              <div class="w-10 h-10 rounded-lg bg-emerald-50 flex items-center justify-center flex-shrink-0 text-emerald-500 group-hover/item:bg-white group-hover/item:shadow-sm transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
              </div>
              <div>
                <h5 class="text-xs font-bold text-slate-800 group-hover/item:text-[#EE6C4D] transition-colors">Options Pricing Heatmap</h5>
                <p class="text-[10px] text-slate-500 line-clamp-1">Black-Scholes Greeks visualizer</p>
              </div>
            </a>
            <a href="/tool/visual_acuity_snellen" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-slate-50 transition group/item">
              <div class="w-10 h-10 rounded-lg bg-rose-50 flex items-center justify-center flex-shrink-0 text-rose-500 group-hover/item:bg-white group-hover/item:shadow-sm transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
              </div>
              <div>
                <h5 class="text-xs font-bold text-slate-800 group-hover/item:text-[#EE6C4D] transition-colors">Online Eye Chart</h5>
                <p class="text-[10px] text-slate-500 line-clamp-1">Snellen vision check on screen</p>
              </div>
            </a>
          </div>
        </div>
      </div>

      <!-- My Hub Dropdown -->
      <div class="relative group flex-shrink-0">
        <a
          href="/#my-hub"
          class="nav-link text-sm font-bold text-gray-600 group-hover:text-[#EE6C4D] transition outline-none focus:ring-2 focus:ring-[#EE6C4D] rounded py-2"
        >
          My Hub
        </a>
        <div
          class="opacity-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto absolute top-full left-1/2 -translate-x-1/2 pt-4 z-[9999] transition-opacity duration-200"
        >
          <div
            class="bg-white/95 backdrop-blur-xl rounded-2xl shadow-2xl shadow-slate-200/40 border border-slate-100 p-3 w-72 flex flex-col gap-1"
          >
            <h4 class="text-[10px] uppercase font-black tracking-wider text-slate-400 mb-1 px-2">Curated Hubs</h4>
            <a href="/hubs/startup" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-slate-50 transition group/item border border-transparent hover:border-slate-100">
              <div class="w-9 h-9 rounded-lg bg-orange-50 flex items-center justify-center flex-shrink-0 text-orange-500 group-hover/item:bg-white group-hover/item:shadow-sm transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
              </div>
              <div>
                <h5 class="text-xs font-bold text-slate-800 group-hover/item:text-[#EE6C4D] transition-colors">Startup &amp; VC</h5>
                <p class="text-[10px] text-slate-500">Cap tables, valuations</p>
              </div>
            </a>
            <a href="/hubs/freelancer" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-slate-50 transition group/item border border-transparent hover:border-slate-100">
              <div class="w-9 h-9 rounded-lg bg-blue-50 flex items-center justify-center flex-shrink-0 text-blue-500 group-hover/item:bg-white group-hover/item:shadow-sm transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              </div>
              <div>
                <h5 class="text-xs font-bold text-slate-800 group-hover/item:text-[#EE6C4D] transition-colors">Freelance &amp; Creator</h5>
                <p class="text-[10px] text-slate-500">Invoices, royalties</p>
              </div>
            </a>
            <a href="/hubs/wellness" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-slate-50 transition group/item border border-transparent hover:border-slate-100">
              <div class="w-9 h-9 rounded-lg bg-rose-50 flex items-center justify-center flex-shrink-0 text-rose-500 group-hover/item:bg-white group-hover/item:shadow-sm transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
              </div>
              <div>
                <h5 class="text-xs font-bold text-slate-800 group-hover/item:text-[#EE6C4D] transition-colors">Wellness &amp; Focus</h5>
                <p class="text-[10px] text-slate-500">Sleep debt, meditations</p>
              </div>
            </a>
          </div>
        </div>
      </div>

      <!-- All Tools Dropdown -->
      <div class="relative group flex-shrink-0">
        <a
          href="/tool"
          class="flex items-center gap-1.5 px-2 py-2 text-sm text-slate-600 group-hover:text-[#EE6C4D] font-bold transition-colors outline-none focus:ring-2 focus:ring-[#EE6C4D] rounded"
        >
          All Tools
          <span class="bg-orange-100 text-[#EE6C4D] text-[10px] px-1.5 py-0.5 rounded-full border border-orange-200">
            126
          </span>
        </a>
        <div
          class="opacity-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto absolute top-full left-1/2 -translate-x-1/2 pt-3 z-[9999] transition-opacity duration-200"
        >
          <div
            class="bg-white/95 backdrop-blur-xl rounded-2xl shadow-2xl shadow-slate-200/40 border border-slate-100 p-4 w-[480px]"
          >
            <div class="grid grid-cols-2 gap-2">
              <a href="/category/developer" class="flex flex-col gap-1.5 p-3 rounded-xl hover:bg-slate-50 transition group/item border border-transparent hover:border-slate-100">
                <div class="flex items-center gap-2">
                  <div class="w-8 h-8 rounded-lg bg-indigo-50 flex items-center justify-center text-indigo-500 group-hover/item:bg-white group-hover/item:shadow-sm transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
                  </div>
                  <h5 class="text-xs font-bold text-slate-800 group-hover/item:text-[#EE6C4D] transition-colors">Developer</h5>
                </div>
                <p class="text-[10px] text-slate-500 leading-relaxed line-clamp-2">cURL converter, regex, SQLite</p>
              </a>
              <a href="/category/finance" class="flex flex-col gap-1.5 p-3 rounded-xl hover:bg-slate-50 transition group/item border border-transparent hover:border-slate-100">
                <div class="flex items-center gap-2">
                  <div class="w-8 h-8 rounded-lg bg-emerald-50 flex items-center justify-center text-emerald-500 group-hover/item:bg-white group-hover/item:shadow-sm transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  </div>
                  <h5 class="text-xs font-bold text-slate-800 group-hover/item:text-[#EE6C4D] transition-colors">Finance</h5>
                </div>
                <p class="text-[10px] text-slate-500 leading-relaxed line-clamp-2">Black-Scholes, FIRE, pricing</p>
              </a>
              <a href="/category/health" class="flex flex-col gap-1.5 p-3 rounded-xl hover:bg-slate-50 transition group/item border border-transparent hover:border-slate-100">
                <div class="flex items-center gap-2">
                  <div class="w-8 h-8 rounded-lg bg-rose-50 flex items-center justify-center text-rose-500 group-hover/item:bg-white group-hover/item:shadow-sm transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                  </div>
                  <h5 class="text-xs font-bold text-slate-800 group-hover/item:text-[#EE6C4D] transition-colors">Health &amp; Vision</h5>
                </div>
                <p class="text-[10px] text-slate-500 leading-relaxed line-clamp-2">Snellen charts, astigmatism, HRV</p>
              </a>
              <a href="/category/hardware" class="flex flex-col gap-1.5 p-3 rounded-xl hover:bg-slate-50 transition group/item border border-transparent hover:border-slate-100">
                <div class="flex items-center gap-2">
                  <div class="w-8 h-8 rounded-lg bg-sky-50 flex items-center justify-center text-sky-500 group-hover/item:bg-white group-hover/item:shadow-sm transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                  </div>
                  <h5 class="text-xs font-bold text-slate-800 group-hover/item:text-[#EE6C4D] transition-colors">Hardware &amp; Audio</h5>
                </div>
                <p class="text-[10px] text-slate-500 leading-relaxed line-clamp-2">Latency loopback, mouse polling</p>
              </a>
            </div>
            <div class="mt-3 pt-3 border-t border-slate-100">
              <a
                href="/tool"
                class="flex items-center justify-between w-full p-3 rounded-xl bg-slate-50 hover:bg-[#EE6C4D] hover:text-white text-slate-700 transition-colors group/btn outline-none focus:ring-2 focus:ring-[#EE6C4D] focus:ring-offset-2"
              >
                <span class="text-xs font-bold">Explore Full Directory (126 Tools)</span>
                <svg class="w-4 h-4 transform group-hover/btn:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Guide / Sitemap Link -->
      <a
        href="/sitemap.html"
        class="nav-link text-sm font-bold text-gray-600 hover:text-[#EE6C4D] transition outline-none focus:ring-2 focus:ring-[#EE6C4D] rounded px-3 py-2"
      >
        Guide
      </a>

      <!-- Search Trigger Button -->
      <div class="relative ml-2 flex-shrink-0">
        <a
          href="/tool"
          aria-label="Search all tools"
          class="flex items-center justify-between w-44 lg:w-52 bg-slate-100/70 hover:bg-slate-100 border border-slate-200 rounded-full py-2 px-4 text-sm text-slate-400 transition-all outline-none focus:ring-2 focus:ring-[#EE6C4D]"
        >
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"></path>
            </svg>
            Search tools...
          </span>
          <kbd class="font-sans text-[10px] font-bold border border-slate-300 rounded px-1.5 py-0.5 bg-white text-slate-500 shadow-sm hidden xl:block">Ctrl K</kbd>
        </a>
      </div>
    </div>

    <!-- Mobile Navigation Actions -->
    <div class="flex items-center gap-2 lg:hidden relative z-10 flex-shrink-0">
      <a
        href="/tool"
        aria-label="Open Search"
        class="p-2 text-gray-600 hover:text-[#EE6C4D] outline-none focus:ring-2 focus:ring-[#EE6C4D] rounded"
      >
        <svg class="w-5 h-5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"></path>
        </svg>
      </a>
      <button
        id="mobile-menu-btn"
        class="p-2 text-gray-600 hover:text-[#EE6C4D] outline-none focus:ring-2 focus:ring-[#EE6C4D] rounded"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open Menu"
      >
        <svg class="h-6 w-6" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu Drawer -->
  <div
    id="mobile-menu"
    class="hidden absolute top-full left-0 mt-3 w-full bg-white/95 backdrop-blur-xl border border-slate-200 shadow-2xl rounded-2xl p-4 z-50"
  >
    <a href="/#hubs" class="block py-3 text-gray-700 hover:text-[#EE6C4D] font-bold border-b border-gray-50 outline-none focus:ring-2 focus:ring-[#EE6C4D] rounded px-1">
      Explore Hubs
    </a>
    <a href="/hubs/startup" class="block py-2.5 text-sm text-gray-600 hover:text-[#EE6C4D] font-semibold pl-4">
      Startup &amp; VC
    </a>
    <a href="/hubs/freelancer" class="block py-2.5 text-sm text-gray-600 hover:text-[#EE6C4D] font-semibold pl-4">
      Freelance &amp; Creator
    </a>
    <a href="/hubs/wellness" class="block py-2.5 text-sm text-gray-600 hover:text-[#EE6C4D] font-semibold pl-4 border-b border-gray-50">
      Wellness &amp; Focus
    </a>
    <a href="/tool" class="block py-3 text-gray-700 hover:text-[#EE6C4D] font-bold border-b border-gray-50 outline-none focus:ring-2 focus:ring-[#EE6C4D] rounded px-1">
      Directory (126 Tools)
    </a>
    <a href="/sitemap.html" class="block py-3 text-gray-700 hover:text-[#EE6C4D] font-bold border-b border-gray-50 outline-none focus:ring-2 focus:ring-[#EE6C4D] rounded px-1">
      Guide
    </a>
    <a href="/about" class="block py-3 text-gray-700 hover:text-[#EE6C4D] font-bold outline-none focus:ring-2 focus:ring-[#EE6C4D] rounded px-1">
      About Us
    </a>
  </div>

  <!-- Reading Progress Bar -->
  <div
    id="reading-progress-container"
    aria-hidden="true"
    class="absolute bottom-0 left-0 right-0 h-[3px] pointer-events-none z-50 overflow-hidden rounded-b-3xl"
  >
    <div
      id="reading-progress"
      class="w-full h-full bg-gradient-to-r from-[#EE6C4D] to-[#ff9e80] origin-left scale-x-0 transition-transform duration-150 ease-out"
    >
    </div>
  </div>
</header>

<script is:inline>
  // Mobile Menu Toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
    });
  }

  // Reading Progress Bar
  const progressBar = document.getElementById('reading-progress');
  if (progressBar) {
    window.addEventListener(
      'scroll',
      () => {
        const scrollTop = document.body.scrollTop || document.documentElement.scrollTop;
        const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        if (scrollHeight > 0) {
          const ratio = Math.min(1, Math.max(0, scrollTop / scrollHeight));
          progressBar.style.transform = `scaleX(${ratio})`;
        }
      },
      { passive: true }
    );
  }
</script>
