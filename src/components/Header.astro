---
import { getCollection } from 'astro:content';
import { CANONICAL_13_CATEGORIES } from '@lib/taxonomy';

const tools = await getCollection('tools');
const toolCount = tools.length;
---

<header
  id="app-header"
  class="sticky top-0 left-0 right-0 w-full z-50 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-xs"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <nav
      id="main-nav-bar"
      class="w-full h-16 flex items-center justify-between min-w-0 relative"
      role="navigation"
      aria-label="Main Navigation"
    >
      <!-- Brand Logo Lockup -->
      <div class="flex items-center gap-3 min-w-0 relative z-10 flex-shrink-0">
        <a
          href="/"
          aria-label="Toolkit Gen Home"
          class="text-[#EE6C4D] hover:text-[#d75a3c] transition focus:outline-none rounded flex-shrink-0 min-h-[44px] min-w-[44px] flex items-center justify-center"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-8 h-8">
            <path
              d="M11.47 3.84a.75.75 0 0 1 1.06 0l8.69 8.69a.75.75 0 1 0 1.06-1.06l-8.689-8.69a2.25 2.25 0 0 0-3.182 0l-8.69 8.69a.75.75 0 0 0 1.061 1.06l8.69-8.69Z"
            ></path>
          </svg>
        </a>
        <a
          href="/"
          class="text-xl font-extrabold text-[#33333B] tracking-tight whitespace-nowrap hidden sm:block flex-shrink-0 outline-none focus:ring-2 focus:ring-slate-300 rounded"
        >
          Toolkit Gen
        </a>
      </div>

      <!-- Desktop Navigation Links (Responsive, no wrap at 1024px) -->
      <div class="hidden lg:flex items-center gap-1 xl:gap-2 flex-shrink-0 relative z-10">
        <!-- All Tools Link -->
        <a
          href="/tool"
          class="nav-link text-xs xl:text-sm font-bold text-slate-700 hover:text-[#EE6C4D] transition outline-none focus:ring-2 focus:ring-[#EE6C4D] rounded py-2 px-3"
        >
          All Tools
        </a>

        <!-- Categories Dropdown (13 Canonical Categories) -->
        <div class="relative group flex-shrink-0">
          <button
            type="button"
            class="nav-link text-xs xl:text-sm font-bold text-slate-700 group-hover:text-[#EE6C4D] transition outline-none focus:ring-2 focus:ring-[#EE6C4D] rounded py-2 px-3 flex items-center gap-1 cursor-pointer"
            aria-expanded="false"
          >
            <span>Categories</span>
            <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-[#EE6C4D] transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div
            class="opacity-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto absolute top-full left-1/2 -translate-x-1/2 pt-2 z-50 transition-opacity duration-200"
          >
            <div
              class="bg-white rounded-2xl shadow-2xl border border-slate-200 p-4 w-[480px] grid grid-cols-2 gap-1.5 max-h-[460px] overflow-y-auto"
            >
              {CANONICAL_13_CATEGORIES.map((cat) => (
                <a
                  href={`/category/${cat.slug}`}
                  class="flex flex-col p-2 rounded-xl hover:bg-slate-50 transition-colors group/cat border border-transparent hover:border-slate-100"
                >
                  <span class="text-xs font-bold text-slate-800 group-hover/cat:text-[#EE6C4D] transition-colors">
                    {cat.name}
                  </span>
                  <span class="text-[10px] text-slate-500 line-clamp-1 leading-snug">
                    {cat.description}
                  </span>
                </a>
              ))}
              <div class="col-span-2 pt-2 border-t border-slate-100 mt-1">
                <a
                  href="/tool"
                  class="flex items-center justify-between p-2 rounded-xl bg-slate-50 hover:bg-[#EE6C4D] hover:text-white text-slate-700 text-xs font-bold transition-colors"
                >
                  <span>Explore Complete Directory ({toolCount} Tools)</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Curated Hubs Dropdown -->
        <div class="relative group flex-shrink-0">
          <a
            href="/#hubs"
            class="nav-link text-xs xl:text-sm font-bold text-slate-700 group-hover:text-[#EE6C4D] transition outline-none focus:ring-2 focus:ring-[#EE6C4D] rounded py-2 px-3 flex items-center gap-1"
          >
            <span>Hubs</span>
            <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-[#EE6C4D] transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </a>
          <div
            class="opacity-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto absolute top-full left-1/2 -translate-x-1/2 pt-2 z-50 transition-opacity duration-200"
          >
            <div
              class="bg-white rounded-2xl shadow-2xl border border-slate-200 p-3 w-72 flex flex-col gap-1"
            >
              <h4 class="text-[10px] uppercase font-black tracking-wider text-slate-400 mb-1 px-2">Operating Systems</h4>
              <a href="/hubs/startup" class="flex flex-col p-2.5 rounded-xl hover:bg-slate-50 transition group/item">
                <h5 class="text-xs font-bold text-slate-800 group-hover/item:text-[#EE6C4D] transition-colors">Founder's Forge Startup Suite</h5>
                <p class="text-[10px] text-slate-500 line-clamp-1">Cap table, burn rate, runway &amp; waterfall</p>
              </a>
              <a href="/hubs/freelancer" class="flex flex-col p-2.5 rounded-xl hover:bg-slate-50 transition group/item">
                <h5 class="text-xs font-bold text-slate-800 group-hover/item:text-[#EE6C4D] transition-colors">Freelancer &amp; Creator OS</h5>
                <p class="text-[10px] text-slate-500 line-clamp-1">Hourly rates, LTV/CAC &amp; scope risk</p>
              </a>
              <a href="/hubs/wellness" class="flex flex-col p-2.5 rounded-xl hover:bg-slate-50 transition group/item">
                <h5 class="text-xs font-bold text-slate-800 group-hover/item:text-[#EE6C4D] transition-colors">Mental Focus &amp; Wellness</h5>
                <p class="text-[10px] text-slate-500 line-clamp-1">Blink monitor, posture alarm &amp; NSDR</p>
              </a>
              <a href="/hubs/gaming" class="flex flex-col p-2.5 rounded-xl hover:bg-slate-50 transition group/item">
                <h5 class="text-xs font-bold text-slate-800 group-hover/item:text-[#EE6C4D] transition-colors">Gaming Lab Suite</h5>
                <p class="text-[10px] text-slate-500 line-clamp-1">Input lag, frame pacing, storage &amp; telemetry</p>
              </a>
            </div>
          </div>
        </div>

        <!-- Trending Link -->
        <a
          href="/#trending"
          class="nav-link text-xs xl:text-sm font-bold text-slate-700 hover:text-[#EE6C4D] transition outline-none focus:ring-2 focus:ring-[#EE6C4D] rounded py-2 px-3"
        >
          Trending
        </a>

        <!-- More Dropdown (Secondary pages for clean corporate nav) -->
        <div class="relative group flex-shrink-0">
          <button
            type="button"
            class="nav-link text-xs xl:text-sm font-bold text-slate-700 group-hover:text-[#EE6C4D] transition outline-none focus:ring-2 focus:ring-[#EE6C4D] rounded py-2 px-3 flex items-center gap-1 cursor-pointer"
            aria-expanded="false"
          >
            <span>More</span>
            <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-[#EE6C4D] transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div
            class="opacity-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto absolute top-full right-0 pt-2 z-50 transition-opacity duration-200"
          >
            <div
              class="bg-white rounded-2xl shadow-2xl border border-slate-200 p-2 w-52 flex flex-col gap-0.5"
            >
              <a href="/about" class="px-3 py-2 text-xs font-semibold text-slate-700 hover:text-[#EE6C4D] hover:bg-slate-50 rounded-xl transition-colors">
                About &amp; Principles
              </a>
              <a href="/sitemap.html" class="px-3 py-2 text-xs font-semibold text-slate-700 hover:text-[#EE6C4D] hover:bg-slate-50 rounded-xl transition-colors">
                HTML Directory Sitemap
              </a>
              <a href="/privacy" class="px-3 py-2 text-xs font-semibold text-slate-700 hover:text-[#EE6C4D] hover:bg-slate-50 rounded-xl transition-colors">
                Privacy Policy
              </a>
              <a href="/terms" class="px-3 py-2 text-xs font-semibold text-slate-700 hover:text-[#EE6C4D] hover:bg-slate-50 rounded-xl transition-colors">
                Terms of Service
              </a>
              <a href="/disclaimer" class="px-3 py-2 text-xs font-semibold text-slate-700 hover:text-[#EE6C4D] hover:bg-slate-50 rounded-xl transition-colors">
                Disclaimer
              </a>
              <a href="/contact" class="px-3 py-2 text-xs font-semibold text-slate-700 hover:text-[#EE6C4D] hover:bg-slate-50 rounded-xl transition-colors">
                Contact &amp; Support
              </a>
            </div>
          </div>
        </div>

        <!-- Search Trigger Button -->
        <button
          type="button"
          data-open-cmd
          aria-label="Search all tools"
          class="flex items-center justify-between w-36 xl:w-44 bg-slate-100 hover:bg-slate-200/80 border border-slate-200 rounded-full py-1.5 px-3 text-xs text-slate-500 transition-all outline-none focus:ring-2 focus:ring-[#EE6C4D] cursor-pointer ml-1"
        >
          <span class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-slate-400" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"></path>
            </svg>
            Search...
          </span>
          <kbd class="font-sans text-[10px] font-bold border border-slate-300 rounded px-1.5 py-0.5 bg-white text-slate-400 shadow-2xs">Ctrl K</kbd>
        </button>
      </div>

      <!-- Mobile Navigation Actions (Tap targets >= 44x44px) -->
      <div class="flex items-center gap-1 lg:hidden relative z-10 flex-shrink-0">
        <button
          type="button"
          data-open-cmd
          aria-label="Open Search"
          class="min-h-[44px] min-w-[44px] flex items-center justify-center text-slate-600 hover:text-[#EE6C4D] outline-none focus:ring-2 focus:ring-[#EE6C4D] rounded-full"
        >
          <svg class="w-5 h-5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"></path>
          </svg>
        </button>
        <button
          id="mobile-menu-btn"
          class="min-h-[44px] min-w-[44px] flex items-center justify-center text-slate-600 hover:text-[#EE6C4D] outline-none focus:ring-2 focus:ring-[#EE6C4D] rounded-full"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open Menu"
        >
          <svg class="h-6 w-6" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile Menu Drawer (Full width, clean category tree, tap targets >= 44px) -->
  <div
    id="mobile-menu"
    class="hidden w-full bg-white border-b border-slate-200 shadow-2xl p-4 sm:p-6 z-50 space-y-3 max-h-[85vh] overflow-y-auto"
  >
    <div class="space-y-1 pb-3 border-b border-slate-100">
      <a href="/tool" class="min-h-[44px] flex items-center px-3 py-2 text-slate-900 hover:text-[#EE6C4D] font-bold text-sm outline-none focus:ring-2 focus:ring-[#EE6C4D] rounded-xl">
        All Tools ({toolCount} Available)
      </a>
      <a href="/#trending" class="min-h-[44px] flex items-center px-3 py-2 text-slate-700 hover:text-[#EE6C4D] font-semibold text-sm outline-none focus:ring-2 focus:ring-[#EE6C4D] rounded-xl">
        Trending Utilities
      </a>
      <a href="/#hubs" class="min-h-[44px] flex items-center px-3 py-2 text-slate-700 hover:text-[#EE6C4D] font-semibold text-sm outline-none focus:ring-2 focus:ring-[#EE6C4D] rounded-xl">
        Curated Hubs
      </a>
    </div>

    <!-- Category Tree -->
    <div class="space-y-2 py-2">
      <h4 class="text-xs font-black uppercase tracking-wider text-slate-400 px-3">
        Categories ({CANONICAL_13_CATEGORIES.length})
      </h4>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-1">
        {CANONICAL_13_CATEGORIES.map((cat) => (
          <a
            href={`/category/${cat.slug}`}
            class="min-h-[44px] flex items-center px-3 py-2 text-xs font-semibold text-slate-700 hover:text-[#EE6C4D] hover:bg-slate-50 rounded-xl transition-colors"
          >
            {cat.name}
          </a>
        ))}
      </div>
    </div>

    <div class="pt-3 border-t border-slate-100 space-y-1">
      <h4 class="text-xs font-black uppercase tracking-wider text-slate-400 px-3">
        Company &amp; Legal
      </h4>
      <div class="grid grid-cols-2 gap-1">
        <a href="/about" class="min-h-[44px] flex items-center px-3 py-2 text-xs font-semibold text-slate-700 hover:text-[#EE6C4D]">
          About
        </a>
        <a href="/sitemap.html" class="min-h-[44px] flex items-center px-3 py-2 text-xs font-semibold text-slate-700 hover:text-[#EE6C4D]">
          Sitemap
        </a>
        <a href="/privacy" class="min-h-[44px] flex items-center px-3 py-2 text-xs font-semibold text-slate-700 hover:text-[#EE6C4D]">
          Privacy
        </a>
        <a href="/terms" class="min-h-[44px] flex items-center px-3 py-2 text-xs font-semibold text-slate-700 hover:text-[#EE6C4D]">
          Terms
        </a>
        <a href="/disclaimer" class="min-h-[44px] flex items-center px-3 py-2 text-xs font-semibold text-slate-700 hover:text-[#EE6C4D]">
          Disclaimer
        </a>
        <a href="/contact" class="min-h-[44px] flex items-center px-3 py-2 text-xs font-semibold text-slate-700 hover:text-[#EE6C4D]">
          Contact
        </a>
      </div>
    </div>

    <div class="pt-3 border-t border-slate-100 flex items-center justify-between px-3">
      <span class="text-xs text-slate-500 font-semibold">Zen Mode Theme</span>
      <button
        type="button"
        data-action="zen-mode"
        class="min-h-[44px] px-4 py-2 text-xs font-bold bg-slate-100 rounded-xl text-slate-700 hover:bg-slate-200"
      >
        Toggle
      </button>
    </div>
  </div>

  <!-- Reading Progress Bar (2px accent along the bottom edge) -->
  <div
    id="reading-progress-container"
    aria-hidden="true"
    class="absolute bottom-0 left-0 right-0 h-[2px] pointer-events-none z-50 overflow-hidden"
  >
    <div
      id="reading-progress"
      class="w-full h-full bg-[#EE6C4D] origin-left scale-x-0 transition-transform duration-100 ease-out"
    >
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    if (window.__headerInitDone) return;
    window.__headerInitDone = true;

    // Mobile Menu Toggle
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    if (menuBtn && mobileMenu) {
      menuBtn.addEventListener('click', () => {
        const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
        menuBtn.setAttribute('aria-expanded', String(!isExpanded));
        mobileMenu.classList.toggle('hidden');
      });
    }

    // Reading Progress Bar (rAF throttled)
    const readingProgressBar = document.getElementById('reading-progress');
    if (readingProgressBar) {
      let isTicking = false;
      window.addEventListener(
        'scroll',
        () => {
          if (!isTicking) {
            window.requestAnimationFrame(() => {
              const scrollTop = document.body.scrollTop || document.documentElement.scrollTop;
              const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
              if (scrollHeight > 0) {
                const ratio = Math.min(1, Math.max(0, scrollTop / scrollHeight));
                readingProgressBar.style.transform = `scaleX(${ratio})`;
              }
              isTicking = false;
            });
            isTicking = true;
          }
        },
        { passive: true }
      );
    }

    // Zen Mode Listener (from command palette)
    const zenActionBtns = document.querySelectorAll('[data-action="zen-mode"]');
    function toggleZenMode() {
      document.body.classList.toggle('zen-mode');
      localStorage.setItem('tk_zen_mode', document.body.classList.contains('zen-mode') ? 'true' : 'false');
    }
    zenActionBtns.forEach((btn) => btn.addEventListener('click', toggleZenMode));
  })();
</script>
