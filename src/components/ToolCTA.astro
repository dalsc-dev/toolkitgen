---
interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
  targetId?: string;
}

const {
  title = 'Ready to Run Diagnostic?',
  description = 'Perform calculations directly in your browser with local data processing.',
  buttonText = 'Launch Tool',
  targetId = 'tool-app-stage'
} = Astro.props;
---

<div class="my-10 p-8 sm:p-10 bg-slate-900 text-white rounded-3xl border border-slate-800 text-center shadow-xl relative overflow-hidden not-prose" role="region" aria-label="Tool Action Callout">
  <div class="absolute inset-0 bg-gradient-to-br from-orange-500/10 via-transparent to-transparent pointer-events-none" aria-hidden="true"></div>
  <div class="relative z-10 max-w-xl mx-auto space-y-4">
    <h3 class="text-2xl sm:text-3xl font-black text-white tracking-tight uppercase">
      {title}
    </h3>
    <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
      {description}
    </p>
    <div class="pt-2">
      <a
        id="tool-primary-cta-btn"
        href={`#${targetId}`}
        class="inline-flex items-center justify-center gap-2 bg-[#C44322] hover:bg-[#b03a1b] text-white font-black py-4 px-8 rounded-2xl transition transform hover:scale-[1.02] active:scale-[0.98] shadow-lg uppercase tracking-wider text-sm focus:outline-none focus:ring-2 focus:ring-white"
      >
        <span>{buttonText}</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
        </svg>
      </a>
    </div>
  </div>
</div>
