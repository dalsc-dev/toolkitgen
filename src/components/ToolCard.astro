---
interface Props {
  id: string;
  name: string;
  description: string;
  category: string;
  featured?: boolean;
  tags?: string[];
}

const { id, name, description, category, featured = false, tags = [] } = Astro.props;
---

<a
  href={`/tool/${id}`}
  class="group relative flex flex-col justify-between bg-white rounded-2xl p-6 border border-slate-200/80 shadow-sm hover:shadow-xl hover:-translate-y-1 hover:border-[#EE6C4D]/40 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-[#EE6C4D]"
  data-tool-id={id}
  data-category={category}
>
  <div>
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-[11px] font-bold uppercase tracking-wider bg-slate-100 text-slate-600 border border-slate-200/50">
        {category}
      </span>
      {featured && (
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-black uppercase tracking-wider bg-amber-50 text-amber-700 border border-amber-200/60">
          <svg class="w-3 h-3 text-amber-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
          Featured
        </span>
      )}
    </div>

    <h3 class="text-lg font-bold text-slate-900 group-hover:text-[#EE6C4D] transition-colors leading-snug">
      {name}
    </h3>

    <p class="mt-2 text-sm text-slate-500 line-clamp-3 leading-relaxed">
      {description}
    </p>
  </div>

  <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-[#EE6C4D]">
    <span class="inline-flex items-center gap-1.5 text-slate-400 group-hover:text-slate-600 transition-colors">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
      100% Client-Side
    </span>
    <span class="flex items-center gap-1 group-hover:translate-x-1 transition-transform">
      Launch Tool
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>
    </span>
  </div>
</a>
