---
import Badge from './Badge.astro';

interface Props {
  id: string;
  name: string;
  description: string;
  category: string;
  featured?: boolean;
  tags?: string[];
  class?: string;
}

const {
  id,
  name,
  description,
  category,
  featured = false,
  tags = [],
  class: extraClass = ''
} = Astro.props;

// Ensure clean name without site suffix
const displayName = name.replace(/\s*\|\s*Toolkit Gen.*$/i, '').trim();
---

<a
  href={`/tool/${id}`}
  class={`group relative flex flex-col justify-between h-full bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs hover:shadow-xl hover:-translate-y-1 hover:border-[#EE6C4D]/40 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-[#EE6C4D] ${extraClass}`}
  data-tool-id={id}
  data-category={category}
  data-tags={tags.join(',')}
>
  <div>
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-[11px] font-bold uppercase tracking-wider bg-slate-100 text-slate-600 border border-slate-200/50">
        {category}
      </span>
      {featured && (
        <Badge variant="featured" />
      )}
    </div>

    <h3 class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-[#EE6C4D] transition-colors leading-snug">
      {displayName}
    </h3>

    <p class="mt-2 text-xs sm:text-sm text-slate-500 line-clamp-2 leading-relaxed">
      {description}
    </p>
  </div>

  <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-[#EE6C4D]">
    <span class="inline-flex items-center gap-1.5 text-slate-400 group-hover:text-slate-600 transition-colors">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 flex-shrink-0" aria-hidden="true"></span>
      Runs in Browser
    </span>
    <span class="flex items-center gap-1 group-hover:translate-x-1 transition-transform">
      Launch Tool
      <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
      </svg>
    </span>
  </div>
</a>
