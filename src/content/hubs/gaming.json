  "hubHtml": "<div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12\">\n  <!-- Hub Hero Header -->\n  <header class=\"space-y-4 max-w-3xl\">\n    <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-indigo-50 border border-indigo-200 text-indigo-700\">\n      Specialized Engineering Suite\n    </div>\n    <h1 class=\"text-4xl sm:text-5xl font-black text-slate-900 tracking-tight\">\n      Gaming Lab Suite\n    </h1>\n    <p class=\"text-lg text-slate-600 leading-relaxed\">\n      Comprehensive browser-based diagnostic tools for display latency calibration, controller telemetry, frame-pacing verification, and storage planning. Built for competitive players and hardware enthusiasts with all processing executed locally in browser memory.\n    </p>\n  </header>\n\n  <!-- Section 1: Display Timing, Cadence & Refresh -->\n  <section class=\"space-y-6\">\n    <div class=\"border-b border-slate-200 pb-3\">\n      <h2 class=\"text-2xl font-black text-slate-900 tracking-tight\">Display Cadence, Refresh &amp; Television Calibration</h2>\n      <p class=\"text-sm text-slate-500 mt-0.5\">Benchmark display motion judder, verify 120Hz refresh rates, and calibrate HDR gaming modes.</p>\n    </div>\n    <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n      <a href=\"/tool/framerate_judder_pacing_test\" class=\"p-6 rounded-2xl border border-indigo-200 bg-indigo-50/20 hover:border-indigo-300 hover:shadow-lg transition-all space-y-3 group\">\n        <span class=\"text-xs font-bold uppercase tracking-wider text-indigo-700 bg-indigo-100/60 px-2.5 py-1 rounded-md border border-indigo-200\">Featured Diagnostic</span>\n        <h3 class=\"text-lg font-bold text-slate-900 group-hover:text-indigo-600 transition-colors\">Frame Rate Judder &amp; Pacing Test</h3>\n        <p class=\"text-sm text-slate-600 leading-relaxed\">Compare 30, 40, 60 FPS, and native motion sweeps, calculate 120Hz cadence dividers ($120 / 40 = 3$), and evaluate VRR / LFC boundaries.</p>\n      </a>\n\n      <a href=\"/tool/tv_gaming_capability_checker\" class=\"p-6 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-lg transition-all space-y-3 group\">\n        <span class=\"text-xs font-bold uppercase tracking-wider text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-100\">Display Setup</span>\n        <h3 class=\"text-lg font-bold text-slate-900 group-hover:text-emerald-600 transition-colors\">TV &amp; Gaming Display Capability Checker</h3>\n        <p class=\"text-sm text-slate-600 leading-relaxed\">Audit connected screens for 120Hz refresh rates, HDR color spaces, HDMI 2.1 video bandwidth, and HGiG calibration checklists.</p>\n      </a>\n\n      <a href=\"/tool/hdr_display_calibration_patterns\" class=\"p-6 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-lg transition-all space-y-3 group\">\n        <span class=\"text-xs font-bold uppercase tracking-wider text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-100\">Color &amp; HDR</span>\n        <h3 class=\"text-lg font-bold text-slate-900 group-hover:text-emerald-600 transition-colors\">HDR Display Calibration Patterns</h3>\n        <p class=\"text-sm text-slate-600 leading-relaxed\">Test 10-bit banding steps, white point clipping patterns, black crush gradients, and 4:4:4 chroma text legibility.</p>\n      </a>\n\n      <a href=\"/tool/tv_game_mode_input_lag_tester\" class=\"p-6 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-lg transition-all space-y-3 group\">\n        <span class=\"text-xs font-bold uppercase tracking-wider text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-100\">Latency</span>\n        <h3 class=\"text-lg font-bold text-slate-900 group-hover:text-emerald-600 transition-colors\">TV Game Mode &amp; Input Lag Tester</h3>\n        <p class=\"text-sm text-slate-600 leading-relaxed\">Benchmark perceived reaction latency, display refresh stability, and verify Auto Low Latency Mode (ALLM) activation.</p>\n      </a>\n\n      <a href=\"/tool/slowmo_latency_meter\" class=\"p-6 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-lg transition-all space-y-3 group\">\n        <span class=\"text-xs font-bold uppercase tracking-wider text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-100\">Optical Testing</span>\n        <h3 class=\"text-lg font-bold text-slate-900 group-hover:text-emerald-600 transition-colors\">Slow-Motion Video Input Lag Meter</h3>\n        <p class=\"text-sm text-slate-600 leading-relaxed\">Measure true end-to-end latency with smartphone 120fps and 240fps slow-motion video with in-browser frame stepping.</p>\n      </a>\n\n      <a href=\"/tool/monitor_refresh_tester\" class=\"p-6 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-lg transition-all space-y-3 group\">\n        <span class=\"text-xs font-bold uppercase tracking-wider text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-100\">Panel Sync</span>\n        <h3 class=\"text-lg font-bold text-slate-900 group-hover:text-emerald-600 transition-colors\">Monitor Refresh Rate Tester</h3>\n        <p class=\"text-sm text-slate-600 leading-relaxed\">Measure exact display refresh rate and detect frame skipping or micro-stutters across high-refresh panels.</p>\n      </a>\n    </div>\n  </section>\n\n  <!-- Section 2: Storage & Preload Architecture -->\n  <section class=\"space-y-6\">\n    <div class=\"border-b border-slate-200 pb-3\">\n      <h2 class=\"text-2xl font-black text-slate-900 tracking-tight\">Console Storage &amp; Preload Planning</h2>\n      <p class=\"text-sm text-slate-500 mt-0.5\">Plan network transfer windows, M.2 expansion, and internal console storage capacity.</p>\n    </div>\n    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n      <a href=\"/tool/console_storage_planner\" class=\"p-6 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-lg transition-all space-y-3 group\">\n        <div class=\"flex justify-between items-center\">\n          <span class=\"text-xs font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded-md border border-indigo-100\">Storage Optimization</span>\n          <span class=\"text-xs font-bold text-slate-400 group-hover:text-indigo-600 transition-colors\">Open Tool &rarr;</span>\n        </div>\n        <h3 class=\"text-xl font-bold text-slate-900 group-hover:text-indigo-600 transition-colors\">Console Storage Planner</h3>\n        <p class=\"text-sm text-slate-600 leading-relaxed\">Model real usable SSD space on PlayStation 5, Slim, Pro, and Xbox Series hardware, manage installed titles, and calculate space fit.</p>\n      </a>\n\n      <a href=\"/tool/game_download_time_calculator\" class=\"p-6 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-lg transition-all space-y-3 group\">\n        <div class=\"flex justify-between items-center\">\n          <span class=\"text-xs font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded-md border border-indigo-100\">Network Budgeting</span>\n          <span class=\"text-xs font-bold text-slate-400 group-hover:text-indigo-600 transition-colors\">Open Tool &rarr;</span>\n        </div>\n        <h3 class=\"text-xl font-bold text-slate-900 group-hover:text-indigo-600 transition-colors\">Game Download Time Calculator</h3>\n        <p class=\"text-sm text-slate-600 leading-relaxed\">Calculate download duration, 7.5% real-world protocol overhead, and transfer windows for major titles up to 200 GB.</p>\n      </a>\n    </div>\n  </section>\n\n  <!-- Section 3: Controller & Input Telemetry -->\n  <section class=\"space-y-6\">\n    <div class=\"border-b border-slate-200 pb-3\">\n      <h2 class=\"text-2xl font-black text-slate-900 tracking-tight\">Controller Health &amp; HID Diagnostics</h2>\n      <p class=\"text-sm text-slate-500 mt-0.5\">Inspect potentiometer wear, measure circularity error, and test controller polling rates.</p>\n    </div>\n    <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n      <a href=\"/tool/webhid_gamepad_diagnostics\" class=\"p-6 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-lg transition-all space-y-3 group\">\n        <span class=\"text-xs font-bold uppercase tracking-wider text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-100\">WebHID Telemetry</span>\n        <h3 class=\"text-lg font-bold text-slate-900 group-hover:text-emerald-600 transition-colors\">Gamepad Drift &amp; Input Diagnostic Suite</h3>\n        <p class=\"text-sm text-slate-600 leading-relaxed\">Direct 16-bit WebHID telemetry: inspect stick centering, measure unit-circle circularity error, and generate RMA scorecards.</p>\n      </a>\n\n      <a href=\"/tool/gamepad_button_input_tester\" class=\"p-6 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-lg transition-all space-y-3 group\">\n        <span class=\"text-xs font-bold uppercase tracking-wider text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-100\">Controller HID</span>\n        <h3 class=\"text-lg font-bold text-slate-900 group-hover:text-emerald-600 transition-colors\">Gamepad Button &amp; Input Tester</h3>\n        <p class=\"text-sm text-slate-600 leading-relaxed\">Test DualSense, Xbox, and HID gamepads in real time with analog trigger pressure gauges and stick coordinate radars.</p>\n      </a>\n\n      <a href=\"/tool/gamepad_drift_visualizer\" class=\"p-6 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-lg transition-all space-y-3 group\">\n        <span class=\"text-xs font-bold uppercase tracking-wider text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-100\">Sensor Health</span>\n        <h3 class=\"text-lg font-bold text-slate-900 group-hover:text-emerald-600 transition-colors\">Gamepad Drift Visualizer</h3>\n        <p class=\"text-sm text-slate-600 leading-relaxed\">Measure thumbstick circularity error, center resting bias, and deadzone wear profiles with precision radial plots.</p>\n      </a>\n\n      <a href=\"/tool/mouse_polling_rate_hz\" class=\"p-6 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-lg transition-all space-y-3 group\">\n        <span class=\"text-xs font-bold uppercase tracking-wider text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-100\">USB Telemetry</span>\n        <h3 class=\"text-lg font-bold text-slate-900 group-hover:text-emerald-600 transition-colors\">Mouse Polling Rate (Hz)</h3>\n        <p class=\"text-sm text-slate-600 leading-relaxed\">Verify optical sensor USB report frequency (125 Hz, 500 Hz, 1000 Hz, 4000 Hz, 8000 Hz) with live interval histograms.</p>\n      </a>\n\n      <a href=\"/tool/keyboard_latency_test\" class=\"p-6 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-lg transition-all space-y-3 group\">\n        <span class=\"text-xs font-bold uppercase tracking-wider text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-100\">Switch Timing</span>\n        <h3 class=\"text-lg font-bold text-slate-900 group-hover:text-emerald-600 transition-colors\">Keyboard Latency Test</h3>\n        <p class=\"text-sm text-slate-600 leading-relaxed\">Measure mechanical and membrane keyboard scan rates, key chatter, and USB matrix debounce intervals.</p>\n      </a>\n\n      <a href=\"/tool/frametime_csv_analyzer\" class=\"p-6 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-lg transition-all space-y-3 group\">\n        <span class=\"text-xs font-bold uppercase tracking-wider text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-100\">Benchmark Analysis</span>\n        <h3 class=\"text-lg font-bold text-slate-900 group-hover:text-emerald-600 transition-colors\">Frame-Time CSV Benchmark Analyzer</h3>\n        <p class=\"text-sm text-slate-600 leading-relaxed\">Import PresentMon or CapFrameX logs to calculate average FPS, 1% lows, 0.1% lows, and micro-stutter variance.</p>\n      </a>\n    </div>\n  </section>\n\n  <!-- Section 4: Engineering Troubleshooting Guides -->\n  <section class=\"space-y-6\">\n    <div class=\"border-b border-slate-200 pb-3\">\n      <h2 class=\"text-2xl font-black text-slate-900 tracking-tight\">Technical Diagnostic &amp; Calibration Guides</h2>\n      <p class=\"text-sm text-slate-500 mt-0.5\">In-depth technical guides with empirical calibration steps and engineering analysis.</p>\n    </div>\n    <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n      <a href=\"/guide/console-storage-planning-preload-guide\" class=\"p-6 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-lg transition-all space-y-3 group\">\n        <span class=\"text-xs font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded-md border border-indigo-100\">Storage Guide</span>\n        <h3 class=\"text-lg font-bold text-slate-900 group-hover:text-indigo-600 transition-colors\">Console Storage Planning &amp; Preload Guide</h3>\n        <p class=\"text-sm text-slate-600 leading-relaxed\">9th-gen console storage architectures, M.2 NVMe heatsink clearance requirements, and preload network modeling.</p>\n      </a>\n\n      <a href=\"/guide/30fps-vs-40fps-oled-judder-guide\" class=\"p-6 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-lg transition-all space-y-3 group\">\n        <span class=\"text-xs font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded-md border border-indigo-100\">Display Guide</span>\n        <h3 class=\"text-lg font-bold text-slate-900 group-hover:text-indigo-600 transition-colors\">30 FPS vs 40 FPS on OLED Displays</h3>\n        <p class=\"text-sm text-slate-600 leading-relaxed\">Sample-and-hold retinal stutter, 120Hz integer cadence mathematics ($120/40=3$), and VRR floor LFC analysis.</p>\n      </a>\n\n      <a href=\"/guide/ps5-xbox-tv-calibration-hgig-guide\" class=\"p-6 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-lg transition-all space-y-3 group\">\n        <span class=\"text-xs font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded-md border border-indigo-100\">Calibration Guide</span>\n        <h3 class=\"text-lg font-bold text-slate-900 group-hover:text-indigo-600 transition-colors\">PS5 &amp; Xbox Television HDR Calibration</h3>\n        <p class=\"text-sm text-slate-600 leading-relaxed\">HGiG clipping vs Dynamic Tone Mapping (DTM), ALLM activation, 120Hz output, and 48 Gbps HDMI 2.1 cable setup.</p>\n      </a>\n\n      <a href=\"/guide/dualsense-drift-battery-latency-guide\" class=\"p-6 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-lg transition-all space-y-3 group\">\n        <span class=\"text-xs font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded-md border border-indigo-100\">Controller Guide</span>\n        <h3 class=\"text-lg font-bold text-slate-900 group-hover:text-indigo-600 transition-colors\">DualSense Controller Maintenance &amp; Polling</h3>\n        <p class=\"text-sm text-slate-600 leading-relaxed\">Alps Alpine potentiometer carbon wear, circularity error thresholds, battery life (1560 vs 1050 mAh), and Bluetooth polling rates.</p>\n      </a>\n\n      <a href=\"/guide/slowmo-video-input-lag-testing-guide\" class=\"p-6 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-lg transition-all space-y-3 group\">\n        <span class=\"text-xs font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded-md border border-indigo-100\">Measurement Guide</span>\n        <h3 class=\"text-lg font-bold text-slate-900 group-hover:text-indigo-600 transition-colors\">Slow-Motion Video Input Lag Testing</h3>\n        <p class=\"text-sm text-slate-600 leading-relaxed\">DIY end-to-end latency measurement using smartphone 120fps and 240fps slow-motion cameras with frame-by-frame analysis.</p>\n      </a>\n\n      <a href=\"/guide/controller-stick-drift-deadzone\" class=\"p-6 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-lg transition-all space-y-3 group\">\n        <span class=\"text-xs font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded-md border border-indigo-100\">Hardware Guide</span>\n        <h3 class=\"text-lg font-bold text-slate-900 group-hover:text-indigo-600 transition-colors\">Stick Drift &amp; Deadzone Tuning</h3>\n        <p class=\"text-sm text-slate-600 leading-relaxed\">Diagnose potentiometer stick drift, evaluate deadzone percentages, and learn calibration fixes for Xbox, PS5, and Switch.</p>\n      </a>\n    </div>\n  </section>\n\n  <!-- Hub Notice -->\n  <div class=\"p-5 bg-slate-50 rounded-2xl border border-slate-200 text-xs text-slate-500 leading-relaxed\">\n    <strong>Platform Notice:</strong> Product names, console platforms, and hardware trademarks belong to their respective holders. Mentions are provided strictly for compatibility and diagnostic reference. ToolkitGen is an independent platform.\n  </div>\n</div>",
