---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import ConsentBanner from '@components/ConsentBanner.astro';
import CommandPalette from '@components/CommandPalette.astro';
import FloatingDock from '@components/FloatingDock.astro';
import { formatTitle, formatDescription } from '@lib/seo';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  jsonLd?: Record<string, any>;
  noindex?: boolean;
  containerClass?: string;
  hasMath?: boolean;
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  ogImage = 'https://toolkitgen.com/assets/favicon/favicon-96x96.png',
  jsonLd,
  noindex = false,
  containerClass = 'max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 sm:pt-28 pb-16',
  hasMath = false,
} = Astro.props;

const siteUrl = 'https://toolkitgen.com';
const canonicalUrl = canonical || (Astro.url.pathname === '/' ? siteUrl : `${siteUrl}${Astro.url.pathname.replace(/\/$/, '')}`);
const metaTitle = formatTitle(title);
const metaDescription = formatDescription(description);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{metaTitle}</title>
  <meta name="description" content={metaDescription} />
  <link rel="canonical" href={canonicalUrl} />

  {noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  )}

  <!-- OpenGraph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={metaTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="Toolkit Gen" />
  <meta property="og:image" content={ogImage} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={metaTitle} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Favicons -->
  <link rel="icon" type="image/png" sizes="96x96" href="/assets/favicon/favicon-96x96.png" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon/favicon.svg" />
  <link rel="shortcut icon" href="/assets/favicon/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/apple-touch-icon.png" />
  <meta name="theme-color" content="#ffffff" />

  <!-- Search Engine Verifications & Syndication -->
  <meta name="google-site-verification" content="G-NKR6PVM0M9" />
  <meta name="msvalidate.01" content="4675079345370949" />
  <link rel="alternate" type="application/rss+xml" title="Toolkit Gen RSS Feed" href="/rss.xml" />

  <!-- Google AdSense (Auto Ads & Immediate Revenue Optimization) -->
  {!noindex && (
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4675079345370949"
      crossorigin="anonymous"
      id="adsbygoogle-script"
    ></script>
  )}

  <!-- Google Analytics 4 -->
  {!noindex && (
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-NKR6PVM0M9"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-NKR6PVM0M9');
    </script>
  )}

  <!-- Service Worker Registration with Immediate Update Check -->
  <script is:inline>
    if ('serviceWorker' in navigator && window.location.protocol === 'https:') {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').then((reg) => {
          reg.update().catch(() => {});
        }).catch(() => {});
      });
    }
  </script>

  <!-- Structured Data JSON-LD -->
  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}

  <!-- Zen Mode Initialization -->
  <script is:inline>
    try {
      if (localStorage.getItem('tk_zen_mode') === 'true') {
        document.documentElement.classList.add('zen-mode');
      }
    } catch (e) {}
  </script>

  <!-- Shared AdSlot & Vignette Anti-Trap Watchdog -->
  <script is:inline>
    window.__initAdSlot = function(containerDomId) {
      function initSlot() {
        var container = document.getElementById(containerDomId);
        if (!container) return;
        var ins = container.querySelector('ins.adsbygoogle');
        if (!ins || ins.getAttribute('data-adsbygoogle-status')) return;

        function pushSlot() {
          if (ins.getAttribute('data-adsbygoogle-status')) return true;
          try {
            (window.adsbygoogle = window.adsbygoogle || []).push({});
            return true;
          } catch (e) {
            return false;
          }
        }

        if (typeof IntersectionObserver !== 'undefined') {
          var io = new IntersectionObserver(function(entries) {
            for (var i = 0; i < entries.length; i++) {
              var entry = entries[i];
              if (entry.isIntersecting && entry.boundingClientRect.width > 0) {
                if (pushSlot()) {
                  io.disconnect();
                  break;
                }
              }
            }
          }, { rootMargin: '300px 0px' });
          io.observe(container);
        } else {
          var defer = window.requestIdleCallback || function(cb) { setTimeout(cb, 1000); };
          defer(function() { pushSlot(); });
        }
      }

      var schedule = window.requestIdleCallback || function(cb) { setTimeout(cb, 500); };
      if (document.readyState === 'complete') {
        schedule(initSlot);
      } else {
        window.addEventListener('load', function() { schedule(initSlot); }, { once: true, passive: true });
      }
    };

    // Google AdSense Vignette Anti-Trap Watchdog
    (() => {
      function dismissStuckVignette() {
        if (window.location.hash.includes('google_vignette')) {
          try {
            history.replaceState(null, '', window.location.pathname + window.location.search);
          } catch (e) {}
        }
        const overlays = document.querySelectorAll('div[style*="z-index: 2147483647"], div[style*="z-index: 2000000000"]');
        overlays.forEach((el) => {
          const rect = el.getBoundingClientRect();
          if (rect.width >= window.innerWidth && rect.height >= window.innerHeight) {
            const closeBtn = el.querySelector('[aria-label*="Close"], button, #dismiss-button');
            if (!closeBtn) {
              el.style.display = 'none';
              el.style.pointerEvents = 'none';
            }
          }
        });
      }

      window.addEventListener('hashchange', () => {
        if (window.location.hash.includes('google_vignette')) {
          setTimeout(dismissStuckVignette, 2000);
        }
      }, { passive: true });

      if (window.location.hash.includes('google_vignette')) {
        setTimeout(dismissStuckVignette, 2000);
      }

      document.addEventListener('click', (e) => {
        const link = e.target.closest('a');
        if (link && link.href && link.href.includes('#google_vignette')) {
          link.href = link.href.replace('#google_vignette', '');
        }
      }, { capture: true, passive: true });
    })();
  </script>

  <!-- KaTeX CSS (loaded only when math is present) -->
  {hasMath && (
    <link rel="stylesheet" href="/assets/katex/katex.min.css" />
  )}

  <slot name="head" />
</head>
<body class="flex flex-col min-h-screen bg-[#f8fafc] text-[#33333b] antialiased overflow-x-clip">
  <!-- Accessibility Skip Link -->
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-[9999] bg-[#EE6C4D] text-white px-4 py-2 rounded-xl shadow-xl font-bold"
  >
    Skip to content
  </a>

  <Header currentPath={Astro.url.pathname} />

  <main id="main-content" class={`flex-grow w-full ${containerClass}`}>
    <slot />
  </main>

  <Footer />
  <ConsentBanner />
  <FloatingDock />
  <CommandPalette />

  <script is:inline>
    try {
      if (localStorage.getItem('tk_zen_mode') === 'true') {
        document.body.classList.add('zen-mode');
      }
    } catch (e) {}
  </script>
</body>
</html>
