---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import FloatingDock from '../components/FloatingDock.astro';
import CommandPalette from '../components/CommandPalette.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  containerClass?: string;
  jsonLd?: Record<string, any>;
  noindex?: boolean;
  hasMath?: boolean;
}

const {
  title = 'Toolkit Gen | Professional Online Tools and Calculators',
  description = 'Fast, free, and accessible in-browser utilities for developers, finance, health, and everyday calculations. Calculations run in your browser; your inputs are never uploaded to our servers.',
  canonical,
  ogImage = 'https://toolkitgen.com/assets/favicon/favicon-96x96.png',
  ogType = 'website',
  containerClass = 'max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 sm:pt-28 pb-16',
  jsonLd,
  noindex = false,
  hasMath = false,
} = Astro.props;

import { formatTitle, formatDescription } from '../lib/seo';

const siteUrl = 'https://toolkitgen.com';
const canonicalUrl = canonical || (Astro.url.pathname === '/' ? siteUrl : `${siteUrl}${Astro.url.pathname.replace(/\/$/, '')}`);
const metaTitle = formatTitle(title);
const metaDescription = formatDescription(description);

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const EXCLUDED_AD_PATHS = new Set([
  '/404',
  '/404.html',
  '/thanks',
  '/privacy',
  '/terms',
  '/disclaimer',
  '/about',
  '/contact',
  '/tool/stroboscope_tachometer',
  '/tool/seizure_flash_check',
  '/tool/flicker_fusion_threshold',
  '/tool/oled_burn_in_fixer',
  '/tool/oled_burnin_protector',
  '/tool/monitor_refresh_tester',
  '/tool/pwm_flicker_eye_health_scanner',
]);
const isAdExcluded = Boolean(noindex || EXCLUDED_AD_PATHS.has(currentPath));
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{metaTitle}</title>
  <meta name="description" content={metaDescription} />
  <link rel="canonical" href={canonicalUrl} />

  {noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  )}

  <!-- OpenGraph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={metaTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="Toolkit Gen" />
  <meta property="og:image" content={ogImage} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={metaTitle} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Favicons -->
  <link rel="icon" type="image/png" sizes="96x96" href="/assets/favicon/favicon-96x96.png" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon/favicon.svg" />
  <link rel="shortcut icon" href="/assets/favicon/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/apple-touch-icon.png" />
  <meta name="theme-color" content="#ffffff" />

  <!-- Search Engine Verifications & Syndication -->
  <meta name="google-site-verification" content="G-NKR6PVM0M9" />
  <meta name="msvalidate.01" content="4675079345370949" />
  <link rel="alternate" type="application/rss+xml" title="Toolkit Gen RSS Feed" href="/rss.xml" />

  <!-- Google Analytics 4 (Deferred after interactive) -->
  {!noindex && (
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-NKR6PVM0M9"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-NKR6PVM0M9');
    </script>
  )}

  <!-- Service Worker Registration with Immediate Update Check -->
  <script is:inline>
    if ('serviceWorker' in navigator && window.location.protocol === 'https:') {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').then((reg) => {
          reg.update().catch(() => {});
        }).catch(() => {});
      });
    }
  </script>

  <!-- Structured Data JSON-LD -->
  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}

  <!-- Zen Mode Initialization (Single Entry Point) -->
  <script is:inline>
    try {
      if (localStorage.getItem('tk_zen_mode') === 'true') {
        document.documentElement.classList.add('zen-mode');
      }
    } catch (e) {}
  </script>

  <!-- Google AdSense Vignette Anti-Trap Watchdog -->
  <script is:inline>
    (() => {
      function dismissStuckVignette() {
        if (window.location.hash.includes('google_vignette')) {
          try {
            history.replaceState(null, '', window.location.pathname + window.location.search);
          } catch (e) {}
        }
        const overlays = document.querySelectorAll('div[style*="z-index: 2147483647"], div[style*="z-index: 2000000000"]');
        overlays.forEach((el) => {
          const rect = el.getBoundingClientRect();
          if (rect.width >= window.innerWidth && rect.height >= window.innerHeight) {
            const closeBtn = el.querySelector('[aria-label*="Close"], button, #dismiss-button');
            if (!closeBtn) {
              el.style.display = 'none';
              el.style.pointerEvents = 'none';
            }
          }
        });
      }

      window.addEventListener('hashchange', () => {
        if (window.location.hash.includes('google_vignette')) {
          setTimeout(dismissStuckVignette, 1500);
        }
      }, { passive: true });

      if (window.location.hash.includes('google_vignette')) {
        setTimeout(dismissStuckVignette, 1500);
      }

      document.addEventListener('click', (e) => {
        const link = e.target.closest('a');
        if (link && link.href && link.href.includes('#google_vignette')) {
          link.href = link.href.replace('#google_vignette', '');
        }
      }, { capture: true, passive: true });
    })();
  </script>

  <!-- KaTeX CSS for Pre-rendered Formulas -->
  {hasMath && (
    <link rel="stylesheet" href="/assets/katex/katex.min.css" />
  )}
</head>

<body class="flex flex-col min-h-screen bg-[#f8fafc] text-[#33333b] antialiased overflow-x-clip">
  <!-- Accessibility Skip Link -->
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-[100] px-4 py-2 bg-slate-900 text-white font-bold rounded-lg shadow-lg focus:outline-none focus:ring-2 focus:ring-[#EE6C4D]"
  >
    Skip to content
  </a>

  <Header currentPath={Astro.url.pathname} />

  <main id="main-content" class={`flex-grow w-full ${containerClass}`}>
    <slot />
  </main>

  <Footer />
  <ConsentBanner />
  <FloatingDock />
  <CommandPalette />

  <!-- Primary Google AdSense Auto Ads (Deferred after consent & idle/interaction) -->
  {!isAdExcluded && (
    <script is:inline>
      (function() {
        if (window.__autoAdsLoaded) return;
        function loadAutoAds() {
          if (window.__autoAdsLoaded) return;
          if (localStorage.getItem('tk_cookie_consent') === 'denied') return;
          window.__autoAdsLoaded = true;

          window.removeEventListener('pointerdown', loadAutoAds);
          window.removeEventListener('keydown', loadAutoAds);
          window.removeEventListener('touchstart', loadAutoAds);
          window.removeEventListener('scroll', loadAutoAds);

          var s = document.createElement('script');
          s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4675079345370949';
          s.async = true;
          s.crossOrigin = 'anonymous';
          s.id = 'adsbygoogle-script';
          document.head.appendChild(s);
        }

        window.addEventListener('pointerdown', loadAutoAds, { once: true, passive: true });
        window.addEventListener('keydown', loadAutoAds, { once: true, passive: true });
        window.addEventListener('touchstart', loadAutoAds, { once: true, passive: true });
        window.addEventListener('scroll', loadAutoAds, { once: true, passive: true });

        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(function() {
            setTimeout(loadAutoAds, 2500);
          });
        } else {
          setTimeout(loadAutoAds, 3500);
        }
      })();
    </script>
  )}
</body>
</html>
