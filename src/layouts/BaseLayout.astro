---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import ConsentBanner from '@components/ConsentBanner.astro';
import CommandPalette from '@components/CommandPalette.astro';
import FloatingDock from '@components/FloatingDock.astro';
import { formatTitle, formatDescription } from '@lib/seo';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  jsonLd?: Record<string, any>;
  noindex?: boolean;
  containerClass?: string;
  hasMath?: boolean;
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  ogImage = 'https://toolkitgen.com/assets/favicon/favicon-96x96.png',
  jsonLd,
  noindex = false,
  containerClass = 'max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 sm:pt-28 pb-16',
  hasMath = false,
} = Astro.props;

const siteUrl = 'https://toolkitgen.com';
const canonicalUrl = canonical || (Astro.url.pathname === '/' ? siteUrl : `${siteUrl}${Astro.url.pathname.replace(/\/$/, '')}`);
const metaTitle = formatTitle(title);
const metaDescription = formatDescription(description);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{metaTitle}</title>
  <meta name="description" content={metaDescription} />
  <link rel="canonical" href={canonicalUrl} />

  {noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  )}

  <!-- OpenGraph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={metaTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="Toolkit Gen" />
  <meta property="og:image" content={ogImage} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={metaTitle} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Favicons -->
  <link rel="icon" type="image/png" sizes="96x96" href="/assets/favicon/favicon-96x96.png" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon/favicon.svg" />
  <link rel="shortcut icon" href="/assets/favicon/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/apple-touch-icon.png" />
  <meta name="theme-color" content="#ffffff" />

  <!-- Google Consent Mode v2 Default -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      'ad_storage': 'denied',
      'ad_user_data': 'denied',
      'ad_personalization': 'denied',
      'analytics_storage': 'denied',
      'wait_for_update': 500
    });
  </script>

  <!-- Third-party scripts deferred until consent + idle/interaction -->
  {!noindex && (
    <script is:inline>
      (() => {
        let gaLoaded = false;
        let adsLoaded = false;

        function initThirdParty() {
          try {
            const raw = localStorage.getItem('tg_cookie_consent_v2');
            if (!raw) return;
            const consent = JSON.parse(raw);

            // Google Analytics (if analytics allowed)
            if (consent.analytics && !gaLoaded) {
              gaLoaded = true;
              const ga = document.createElement('script');
              ga.async = true;
              ga.src = 'https://www.googletagmanager.com/gtag/js?id=G-NKR6PVM0M9';
              document.head.appendChild(ga);
              window.dataLayer = window.dataLayer || [];
              function gtag(){dataLayer.push(arguments);}
              gtag('js', new Date());
              gtag('config', 'G-NKR6PVM0M9');
            }

            // Google AdSense (if ads allowed)
            if (consent.ads && !adsLoaded) {
              adsLoaded = true;
              const ads = document.createElement('script');
              ads.async = true;
              ads.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4675079345370949';
              ads.crossOrigin = 'anonymous';
              document.head.appendChild(ads);
            }
          } catch (e) {}
        }

        window.initThirdPartyServices = initThirdParty;

        // Trigger upon first interaction or after idle
        ['scroll', 'mousemove', 'touchstart', 'keydown'].forEach((ev) => {
          window.addEventListener(ev, initThirdParty, { once: true, passive: true });
        });
        if ('requestIdleCallback' in window) {
          requestIdleCallback(initThirdParty, { timeout: 4000 });
        } else {
          setTimeout(initThirdParty, 3000);
        }
      })();
    </script>
  )}

  <!-- Speculation Rules API for next-page prerendering -->
  <script type="speculationrules">
  {
    "prerender": [
      {
        "source": "list",
        "urls": ["/tool", "/hubs/wellness", "/hubs/startup", "/hubs/freelancer"]
      }
    ]
  }
  </script>

  <!-- Service Worker Registration -->
  <script is:inline>
    if ('serviceWorker' in navigator && window.location.protocol === 'https:' && !window.location.hostname.endsWith('.local')) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      });
    }
  </script>

  <!-- Structured Data JSON-LD -->
  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}

  <!-- Inline Zen Mode Initialization Script -->
  <script is:inline>
    if (localStorage.getItem('tk_zen_mode') === 'true') {
      document.documentElement.classList.add('zen-mode');
      document.body && document.body.classList.add('zen-mode');
    }
  </script>
  <!-- KaTeX CSS (loaded only when math is present) -->
  {hasMath && (
    <link rel="stylesheet" href="/assets/katex/katex.min.css" />
  )}

  <!-- Client-side Security & Production Hardening -->
  <script is:inline>
    (() => {
      if (window.location.protocol === 'https:') {
        // 1. Console Output Suppression in Production
        const noop = () => {};
        ['log', 'debug', 'info', 'warn', 'trace', 'table'].forEach((fn) => {
          if (window.console && window.console[fn]) {
            window.console[fn] = noop;
          }
        });

        // 2. Anti-Inspection & DevTools Shortcuts Deterrent
        document.addEventListener('contextmenu', (e) => {
          if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA')) return;
          e.preventDefault();
        });

        document.addEventListener('keydown', (e) => {
          if (
            e.key === 'F12' ||
            ((e.ctrlKey || e.metaKey) && (e.key === 'u' || e.key === 'U')) ||
            ((e.ctrlKey || e.metaKey) && (e.key === 's' || e.key === 'S')) ||
            ((e.ctrlKey || e.metaKey) && e.shiftKey && (e.key === 'I' || e.key === 'i' || e.key === 'J' || e.key === 'j' || e.key === 'C' || e.key === 'c'))
          ) {
            e.preventDefault();
            e.stopPropagation();
          }
        });
      }
    })();
  </script>

  <slot name="head" />
</head>
<body class="flex flex-col min-h-screen bg-[#f8fafc] text-[#33333b] antialiased overflow-x-clip">
  <!-- Accessibility Skip Link -->
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-[9999] bg-[#EE6C4D] text-white px-4 py-2 rounded-xl shadow-xl font-bold"
  >
    Skip to content
  </a>

  <Header currentPath={Astro.url.pathname} />

  <main id="main-content" class={`flex-grow w-full ${containerClass}`}>
    <slot />
  </main>

  <Footer />
  <ConsentBanner />
  <FloatingDock />
  <CommandPalette />

  <script is:inline>
    if (localStorage.getItem('tk_zen_mode') === 'true') {
      document.body.classList.add('zen-mode');
    }
  </script>
</body>
</html>
