---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import AdSlot from '@components/AdSlot.astro';
import ToolCTA from '@components/ToolCTA.astro';
import Callout from '@components/Callout.astro';
import { generateJsonLd } from '@lib/schema';

interface FAQItem {
  q: string;
  a: string;
}

interface HowToStep {
  name: string;
  text: string;
}

interface RelatedItem {
  id: string;
  name?: string;
  title?: string;
  category?: string;
  description?: string;
}

interface Props {
  id: string;
  name?: string;
  title: string;
  description: string;
  category: string;
  quickAnswer: string;
  faq?: FAQItem[];
  howTo?: HowToStep[];
  related?: RelatedItem[];
  allTools?: RelatedItem[];
  datePublished?: string;
  dateModified?: string;
  hasMath?: boolean;
}

const {
  id,
  name,
  title,
  description,
  category,
  quickAnswer,
  faq = [],
  howTo = [],
  related = [],
  allTools = [],
  datePublished = '2025-01-15T00:00:00Z',
  dateModified = '2026-11-19T00:00:00Z',
  hasMath = false,
} = Astro.props;

// Clean tool name without suffix
const cleanName = (name || title || id)
  .replace(/\s*\|\s*Toolkit Gen.*$/i, '')
  .trim();

// Browser tab title with suffix
const browserTitle = title.includes('|') ? title : `${cleanName} | Toolkit Gen`;

const canonicalUrl = `https://toolkitgen.com/tool/${id}`;
const categorySlug = category.toLowerCase().replace(/[^a-z0-9]+/g, '-');

// Compliance notices
const isVisionTool = category === 'Vision / Optometry' || id.includes('vision') || id.includes('amsler') || id.includes('astigmatism') || id.includes('snellen') || id.includes('color_blindness');
const isHearingTool = id.includes('hearing') || id.includes('audiogram') || id.includes('tinnitus') || id.includes('noise_dosimeter');
const isCameraOrMicTool = category === 'Camera / Sensor' || id.includes('cam') || id.includes('camera') || id.includes('mic') || id.includes('voice') || id.includes('eye_') || id.includes('posture');

const breadcrumbs = [
  { name: category, url: `/category/${categorySlug}` },
  { name: cleanName, url: `/tool/${id}` },
];

const jsonLd = generateJsonLd({
  type: 'tool',
  title: cleanName,
  description,
  url: canonicalUrl,
  category,
  datePublished,
  dateModified,
  howTo,
  faq,
  breadcrumbs: [
    { name: 'Home', url: '/' },
    { name: 'Directory', url: '/tool' },
    { name: cleanName, url: `/tool/${id}` },
  ],
});

// Compute Hot Right Now (2 tools)
const hotTools = allTools
  .filter((t) => t.id !== id)
  .slice(0, 2);

// Compute Recommended Tool (1 tool)
const recommendedTool = related.length > 0
  ? related[0]
  : allTools.find((t) => t.id !== id) || { id: 'sqlite_wasm_explorer', name: 'SQLite WASM Explorer', description: 'In-browser SQL sandbox and analyzer.', category: 'DevOps & Code' };

// Compute Recommended Diagnostics (5 tools)
const diagnosticTools = (related.length >= 5 ? related.slice(0, 5) : [
  ...related,
  ...allTools.filter((t) => t.id !== id && !related.some((r) => r.id === t.id)),
]).slice(0, 5);

const encodedTitle = encodeURIComponent(cleanName);
const encodedUrl = encodeURIComponent(canonicalUrl);
---

<BaseLayout
  title={browserTitle}
  description={description}
  canonical={canonicalUrl}
  ogType="article"
  jsonLd={jsonLd}
  hasMath={hasMath}
>
  <div class="max-w-5xl mx-auto space-y-10">
    <!-- a. Breadcrumb -->
    <Breadcrumbs items={breadcrumbs} />

    <!-- Tool Header Block (b, c, d) -->
    <header id="tool-header-block" class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200/80 shadow-sm space-y-6">
      <!-- b. Badges & Single Trust Line -->
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-4">
        <div class="flex flex-wrap items-center gap-2">
          <a
            href={`/category/${categorySlug}`}
            class="px-2.5 py-1 rounded-md text-[11px] font-black uppercase tracking-wider bg-orange-50 text-[#EE6C4D] border border-orange-200/60 hover:bg-orange-100 transition-colors"
          >
            {category}
          </a>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200/60">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            Runs in browser
          </span>
          <span class="px-2.5 py-1 rounded-md text-[11px] font-bold text-slate-600 bg-slate-100 border border-slate-200/60">
            Free
          </span>
        </div>

        <!-- Single Trust Line -->
        <p class="text-xs text-slate-500 font-medium tracking-wide">
          Runs in your browser. Inputs are not uploaded.
        </p>
      </div>

      <!-- c. H1, Short Description & Action Buttons -->
      <div class="space-y-4">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 tracking-tight leading-tight">
          {cleanName}
        </h1>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-3xl">
          {description}
        </p>

        <!-- Action Buttons: Bookmark, Pin to Hub, Share, Copy Link -->
        <div class="flex flex-wrap items-center gap-2.5 pt-2" id="tool-action-bar">
          <button
            type="button"
            id="tool-bookmark-btn"
            data-tool-id={id}
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-200 transition-all outline-none focus:ring-2 focus:ring-[#EE6C4D]"
          >
            <svg id="bookmark-icon" class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
            </svg>
            <span id="bookmark-text">Bookmark</span>
          </button>

          <button
            type="button"
            id="tool-pinhub-btn"
            data-tool-id={id}
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-200 transition-all outline-none focus:ring-2 focus:ring-[#EE6C4D]"
          >
            <svg id="pinhub-icon" class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            <span id="pinhub-text">Pin to Hub</span>
          </button>

          <button
            type="button"
            id="tool-share-btn"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-200 transition-all outline-none focus:ring-2 focus:ring-[#EE6C4D]"
          >
            <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
            </svg>
            Share
          </button>

          <button
            type="button"
            id="tool-copy-link-btn"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-200 transition-all outline-none focus:ring-2 focus:ring-[#EE6C4D]"
          >
            <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
            </svg>
            <span id="copy-link-text">Copy Link</span>
          </button>
        </div>
      </div>

      <!-- d. "Hot right now" strip (2 related trending tools) + "Scroll to App" jump link -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-4 border-t border-slate-100">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-[11px] font-black uppercase tracking-wider text-slate-400">Hot right now:</span>
          {hotTools.map((ht) => (
            <a
              href={`/tool/${ht.id}`}
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-700 hover:text-[#EE6C4D] transition-colors"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-[#EE6C4D]"></span>
              {ht.name || ht.title || ht.id}
            </a>
          ))}
        </div>

        <a
          href="#tool-app-stage"
          class="inline-flex items-center gap-1.5 text-xs font-bold text-[#C44322] hover:underline self-start sm:self-auto"
        >
          <span>Scroll to App</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
          </svg>
        </a>
      </div>
    </header>

    {isVisionTool && (
      <Callout variant="warning" title="Clinical Health Notice">
        Informational only; not a clinical diagnosis. Consult an eye care professional.
      </Callout>
    )}

    {isHearingTool && (
      <Callout variant="warning" title="Audiometry Notice">
        Informational only; not a clinical diagnosis. Consult a qualified hearing care professional or audiologist.
      </Callout>
    )}

    {isCameraOrMicTool && (
      <Callout variant="info" title="Browser Privacy Notice">
        Audio and video are processed locally in your browser and are not recorded or transmitted.
      </Callout>
    )}

    <!-- e. Tool interactive stage (the tool itself) -->
    <section id="tool-app-stage" class="tool-card bg-white rounded-3xl p-6 sm:p-10 border border-slate-200/80 shadow-xl overflow-hidden scroll-mt-28">
      <slot name="tool-ui" />
    </section>

    <!-- f. "Read How to Use & Info" expandable article -->
    <section id="tool-documentation-section" class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200/80 shadow-sm space-y-8">
      <!-- Quick Answer Summary Box -->
      <Callout variant="note" title="Quick Summary">
        <div set:html={quickAnswer} />
      </Callout>

      <!-- How to Use Steps -->
      {howTo && howTo.length > 0 && (
        <div class="space-y-4">
          <h2 class="text-xl font-bold text-slate-900 tracking-tight">How to Use {cleanName}</h2>
          <ol class="list-decimal pl-5 space-y-2 text-sm text-slate-700 leading-relaxed">
            {howTo.map((step) => (
              <li>
                <strong>{step.name}:</strong> {step.text}
              </li>
            ))}
          </ol>
        </div>
      )}

      <!-- Full Article Markdown Documentation Slot -->
      <article class="prose max-w-none prose-slate pt-4 border-t border-slate-100">
        <slot name="article" />
      </article>

      <!-- Unified Contained Tool CTA -->
      <ToolCTA
        title={`Run ${cleanName}`}
        description="Calculations execute directly in your browser with local data processing."
        buttonText="Begin Calibration"
        targetId="tool-app-stage"
      />

      <div class="pt-4 border-t border-slate-100 text-xs text-slate-400 flex items-center justify-between">
        <span>Last updated: {new Date(dateModified).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        <span>Calculations execute locally in browser memory.</span>
      </div>
    </section>

    <!-- g. "Recommended Tool" card -->
    {recommendedTool && (
      <section id="recommended-tool-card" class="bg-gradient-to-br from-slate-900 to-slate-800 text-white rounded-3xl p-6 sm:p-8 shadow-xl border border-slate-700 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
        <div class="space-y-2 max-w-xl">
          <span class="text-[10px] font-black uppercase tracking-widest text-[#EE6C4D] bg-[#EE6C4D]/10 border border-[#EE6C4D]/20 px-2.5 py-1 rounded-md">
            Recommended Tool • {recommendedTool.category || category}
          </span>
          <h3 class="text-xl font-bold text-white mt-2">
            {recommendedTool.name || recommendedTool.title}
          </h3>
          <p class="text-xs text-slate-300 leading-relaxed line-clamp-2">
            {recommendedTool.description || 'Explore this complementary browser-based utility.'}
          </p>
        </div>
        <a
          href={`/tool/${recommendedTool.id}`}
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#EE6C4D] hover:bg-orange-600 text-white text-xs font-bold rounded-xl shadow-md transition-all self-start sm:self-auto shrink-0"
        >
          <span>Launch Utility</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </section>
    )}

    <!-- h. "Recommended Diagnostics" (5 related tools) -->
    <section id="recommended-diagnostics" class="space-y-4">
      <h3 class="text-lg font-bold text-slate-900 uppercase tracking-wider text-xs border-b border-slate-200/80 pb-3">
        Recommended Diagnostics &amp; Utilities
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {diagnosticTools.map((dt) => (
          <a
            href={`/tool/${dt.id}`}
            class="group p-4 bg-white rounded-2xl border border-slate-200/80 shadow-xs hover:shadow-md hover:border-[#EE6C4D]/40 transition-all flex flex-col justify-between"
          >
            <div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">{dt.category || category}</span>
              <h4 class="text-sm font-bold text-slate-900 group-hover:text-[#EE6C4D] transition-colors mt-1">
                {dt.name || dt.title || dt.id}
              </h4>
              <p class="text-xs text-slate-500 mt-1 line-clamp-2 leading-relaxed">
                {dt.description}
              </p>
            </div>
            <span class="text-xs font-bold text-[#EE6C4D] mt-3 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              <span>Open Tool</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
              </svg>
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- i. FAQ: 4 to 6 tool-specific questions written from tool behavior -->
    {faq && faq.length > 0 && (
      <section id="tool-faq" class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200/80 shadow-sm space-y-6">
        <h3 class="text-2xl font-black text-slate-900 tracking-tight">Frequently Asked Questions</h3>
        <div class="space-y-3">
          {faq.map((item) => (
            <details class="group bg-slate-50 rounded-2xl border border-slate-200/80 open:bg-white open:shadow-md transition-all duration-200">
              <summary class="flex justify-between items-center font-bold text-slate-800 p-4 cursor-pointer list-none select-none text-sm">
                <span>{item.q}</span>
                <span class="transition-transform group-open:rotate-180 text-slate-400">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </span>
              </summary>
              <div class="text-slate-600 px-4 pb-4 pt-1 text-xs leading-relaxed border-t border-slate-100">
                {item.a}
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Unified Utility & Feedback Panel (Consolidated Feedback, Sharing & Contact) -->
    <div id="tool-utility-panel" class="bg-slate-50 rounded-2xl p-6 sm:p-8 border border-slate-200/90 shadow-2xs space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
        <!-- j. "Was this documentation helpful?" (Yes/No feedback widget) -->
        <div id="tool-help-feedback" class="space-y-3">
          <div class="space-y-1">
            <h4 class="text-sm font-bold text-slate-900">Was this documentation helpful?</h4>
            <p class="text-xs text-slate-500">Your feedback helps improve this tool and documentation.</p>
          </div>
          <div id="feedback-buttons" class="flex items-center gap-2.5">
            <button
              type="button"
              id="btn-feedback-yes"
              class="px-4 py-2 bg-white border border-slate-200 rounded-xl text-xs font-bold text-slate-700 hover:bg-emerald-50 hover:border-emerald-300 hover:text-emerald-700 transition-colors shadow-2xs"
            >
              Yes, thanks
            </button>
            <button
              type="button"
              id="btn-feedback-no"
              class="px-4 py-2 bg-white border border-slate-200 rounded-xl text-xs font-bold text-slate-700 hover:bg-rose-50 hover:border-rose-300 hover:text-rose-700 transition-colors shadow-2xs"
            >
              Not really
            </button>
          </div>
          <p id="feedback-confirmation" class="text-xs font-bold text-emerald-600 hidden">
            Thank you for your feedback! It helps us refine this tool documentation.
          </p>
        </div>

        <!-- k. "Share Your Workspace" (Reddit, X, Snap for IG) -->
        <div id="share-workspace" class="space-y-3">
          <div class="space-y-1">
            <h4 class="text-sm font-bold text-slate-900">Share Tool</h4>
            <p class="text-xs text-slate-500">Share this utility with colleagues or export your current tool parameters.</p>
          </div>
          <div class="flex flex-wrap items-center gap-2.5">
            <a
              href={`https://reddit.com/submit?url=${encodedUrl}&title=${encodedTitle}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Share on Reddit"
              class="px-3.5 py-2 bg-white border border-slate-200 hover:bg-orange-50 hover:border-orange-300 hover:text-orange-700 text-slate-700 rounded-xl text-xs font-bold transition-all shadow-2xs flex items-center gap-1.5"
            >
              Reddit
            </a>
            <a
              href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Share on X"
              class="px-3.5 py-2 bg-white border border-slate-200 hover:bg-slate-100 text-slate-700 rounded-xl text-xs font-bold transition-all shadow-2xs flex items-center gap-1.5"
            >
              Post
            </a>
            <button
              type="button"
              id="btn-snap-ig"
              class="px-3.5 py-2 bg-white border border-slate-200 hover:bg-slate-100 text-slate-700 rounded-xl text-xs font-bold transition-all shadow-2xs flex items-center gap-1.5"
            >
              Snap for IG
            </button>
          </div>
        </div>
      </div>

      <!-- l. "Have a suggestion or found a bug?" Email Developer mailto link -->
      <div id="tool-bug-feedback" class="pt-4 border-t border-slate-200/80 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-slate-600">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-[#EE6C4D] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"></path></svg>
          <span>Have a feature idea or spotted an issue in <strong>{cleanName}</strong>?</span>
        </div>
        <a
          href={`mailto:toolkitgen@gmail.com?subject=Toolkit%20Gen%20Feedback:%20${encodedTitle}`}
          class="inline-flex items-center gap-1.5 font-bold text-slate-700 hover:text-[#EE6C4D] bg-white border border-slate-200 hover:border-[#EE6C4D] px-3.5 py-1.5 rounded-lg transition-colors shadow-2xs self-start sm:self-auto"
        >
          <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          <span>Email Developer</span>
        </a>
      </div>
    </div>

    <!-- m. Labeled AdSlot with reserved height (never above the tool) -->
    <AdSlot slotId="tool-bottom-banner" minHeight="250px" />
  </div>
</BaseLayout>

<script is:inline define:vars={{ toolId: id, canonicalUrl }}>
  (() => {
    // Bookmark button logic (localStorage tk_bookmarks)
    const bookmarkBtn = document.getElementById('tool-bookmark-btn');
    const bookmarkText = document.getElementById('bookmark-text');
    const bookmarkIcon = document.getElementById('bookmark-icon');

    function updateBookmarkState() {
      try {
        const bookmarks = JSON.parse(localStorage.getItem('tk_bookmarks') || '[]');
        const isBookmarked = bookmarks.includes(toolId);
        if (bookmarkText) bookmarkText.textContent = isBookmarked ? 'Bookmarked' : 'Bookmark';
        if (bookmarkIcon) {
          bookmarkIcon.setAttribute('fill', isBookmarked ? '#f59e0b' : 'none');
          bookmarkIcon.setAttribute('stroke', isBookmarked ? '#f59e0b' : 'currentColor');
        }
      } catch (e) {}
    }

    bookmarkBtn?.addEventListener('click', () => {
      try {
        let bookmarks = JSON.parse(localStorage.getItem('tk_bookmarks') || '[]');
        if (bookmarks.includes(toolId)) {
          bookmarks = bookmarks.filter((b) => b !== toolId);
        } else {
          bookmarks.push(toolId);
        }
        localStorage.setItem('tk_bookmarks', JSON.stringify(bookmarks));
        updateBookmarkState();
      } catch (e) {}
    });

    // Pin to Hub button logic (localStorage tk_hub_pinned)
    const pinBtn = document.getElementById('tool-pinhub-btn');
    const pinText = document.getElementById('pinhub-text');

    function updatePinState() {
      try {
        const pinned = JSON.parse(localStorage.getItem('tk_hub_pinned') || '[]');
        const isPinned = pinned.includes(toolId);
        if (pinText) pinText.textContent = isPinned ? 'Pinned to Hub' : 'Pin to Hub';
      } catch (e) {}
    }

    pinBtn?.addEventListener('click', () => {
      try {
        let pinned = JSON.parse(localStorage.getItem('tk_hub_pinned') || '[]');
        if (pinned.includes(toolId)) {
          pinned = pinned.filter((p) => p !== toolId);
        } else {
          pinned.push(toolId);
        }
        localStorage.setItem('tk_hub_pinned', JSON.stringify(pinned));
        updatePinState();
      } catch (e) {}
    });

    // Share Button
    const shareBtn = document.getElementById('tool-share-btn');
    shareBtn?.addEventListener('click', () => {
      if (navigator.share) {
        navigator.share({ title: document.title, url: canonicalUrl }).catch(() => {});
      } else {
        navigator.clipboard.writeText(canonicalUrl);
        alert('Link copied to clipboard!');
      }
    });

    // Copy Link Button
    const copyBtn = document.getElementById('tool-copy-link-btn');
    const copyText = document.getElementById('copy-link-text');
    copyBtn?.addEventListener('click', () => {
      navigator.clipboard.writeText(canonicalUrl);
      if (copyText) {
        copyText.textContent = 'Copied!';
        setTimeout(() => (copyText.textContent = 'Copy Link'), 1500);
      }
    });

    // Documentation helpful feedback (Yes/No with localStorage)
    const btnYes = document.getElementById('btn-feedback-yes');
    const btnNo = document.getElementById('btn-feedback-no');
    const feedbackBox = document.getElementById('feedback-buttons');
    const feedbackConfirm = document.getElementById('feedback-confirmation');

    const feedbackKey = `tk_feedback_${toolId}`;
    if (localStorage.getItem(feedbackKey)) {
      feedbackBox?.classList.add('hidden');
      feedbackConfirm?.classList.remove('hidden');
    }

    function recordFeedback(val) {
      localStorage.setItem(feedbackKey, val);
      feedbackBox?.classList.add('hidden');
      feedbackConfirm?.classList.remove('hidden');
    }

    btnYes?.addEventListener('click', () => recordFeedback('yes'));
    btnNo?.addEventListener('click', () => recordFeedback('no'));

    // Snap for IG Screenshot
    const snapBtn = document.getElementById('btn-snap-ig');
    snapBtn?.addEventListener('click', () => {
      window.print();
    });

    // Initial state setup
    updateBookmarkState();
    updatePinState();
  })();
</script>
