---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import AdSlot from '@components/AdSlot.astro';
import FAQ from '@components/FAQ.astro';
import { generateJsonLd } from '@lib/schema';

interface FAQItem {
  q: string;
  a: string;
}

interface HowToStep {
  name: string;
  text: string;
}

interface Props {
  id: string;
  title: string;
  description: string;
  category: string;
  quickAnswer: string;
  faq?: FAQItem[];
  howTo?: HowToStep[];
  related?: Array<{ id: string; name: string }>;
  datePublished?: string;
  dateModified?: string;
}

const {
  id,
  title,
  description,
  category,
  quickAnswer,
  faq = [],
  howTo = [],
  related = [],
  datePublished,
  dateModified,
} = Astro.props;

const canonicalUrl = `https://toolkitgen.com/tool/${id}`;

const breadcrumbs = [
  { name: category, url: `/category/${category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}` },
  { name: title, url: `/tool/${id}` },
];

const jsonLd = generateJsonLd({
  type: 'tool',
  title,
  description,
  url: canonicalUrl,
  category,
  datePublished,
  dateModified,
  howTo,
  faq,
  breadcrumbs: [
    { name: 'Home', url: '/' },
    { name: 'Directory', url: '/tool' },
    { name: title, url: `/tool/${id}` },
  ],
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
  ogType="article"
  jsonLd={jsonLd}
>
  <!-- Breadcrumbs -->
  <Breadcrumbs items={breadcrumbs} />

  <!-- 12-Column Responsive Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Left Sidebar: Specs & Security Verification (2 cols) -->
    <aside class="hidden lg:block lg:col-span-2 space-y-6 sticky top-24">
      <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm text-center">
        <h3 class="text-[11px] font-black uppercase tracking-widest text-slate-400 border-b border-slate-100 pb-3 mb-4">
          Execution Profile
        </h3>
        <dl class="space-y-3 font-mono text-xs text-left">
          <div class="flex flex-col border-b border-slate-50 pb-2">
            <dt class="text-[10px] text-slate-400 uppercase tracking-wider">Runtime</dt>
            <dd class="font-bold text-slate-800">Browser / Wasm</dd>
          </div>
          <div class="flex flex-col border-b border-slate-50 pb-2">
            <dt class="text-[10px] text-slate-400 uppercase tracking-wider">Privacy Model</dt>
            <dd class="font-bold text-emerald-600">Zero Cloud Upload</dd>
          </div>
          <div class="flex flex-col border-b border-slate-50 pb-2">
            <dt class="text-[10px] text-slate-400 uppercase tracking-wider">Offline State</dt>
            <dd class="font-bold text-blue-600">Fully Supported</dd>
          </div>
          <div class="flex flex-col">
            <dt class="text-[10px] text-slate-400 uppercase tracking-wider">Latency</dt>
            <dd class="font-bold text-slate-800">0ms (Local)</dd>
          </div>
        </dl>
      </div>

      <div class="bg-gradient-to-br from-emerald-50 to-teal-50 rounded-2xl p-4 border border-emerald-100 text-xs text-emerald-900 space-y-2">
        <div class="flex items-center gap-2 font-bold text-emerald-800">
          <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM11 14a1 1 0 11-2 0 1 1 0 012 0zm0-7a1 1 0 10-2 0v3a1 1 0 102 0V7z" clip-rule="evenodd" /></svg>
          Privacy Guarantee
        </div>
        <p class="leading-relaxed text-emerald-700 text-[11px]">
          No inputs leave your device. All calculations, files, and signals stay within your local sandbox.
        </p>
      </div>
    </aside>

    <!-- Center Column: Tool Stage + Article Content (7 cols) -->
    <div class="col-span-1 lg:col-span-7 space-y-10">
      <!-- Answer-First Definition Summary for Featured Snippets / AI Engines -->
      <section class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-sm">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight mb-3">
          {title}
        </h1>
        <div class="p-4 bg-slate-50 border-l-4 border-[#EE6C4D] rounded-r-xl text-slate-700 text-sm leading-relaxed font-medium">
          <strong>Quick Summary:</strong> {quickAnswer}
        </div>
      </section>

      <!-- Interactive Tool UI Island Slot -->
      <div class="tool-island-container">
        <slot name="tool-ui" />
      </div>

      <!-- Mid-Page Non-Intrusive AdSlot (Never pushes tool down) -->
      <AdSlot slotId="tool-mid-article" minHeight="280px" />

      <!-- Long-Form Guide / Documentation Article -->
      <article class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200/80 shadow-sm prose max-w-none">
        <slot name="article" />
      </article>

      <!-- Visible FAQ Accordion -->
      <FAQ items={faq} />
    </div>

    <!-- Right Sidebar: Related Tools & Sticky Ad (3 cols) -->
    <aside class="col-span-1 lg:col-span-3 space-y-6 lg:sticky lg:top-24">
      <!-- Related Tools Widget -->
      {related && related.length > 0 && (
        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm">
          <h3 class="text-xs font-black uppercase tracking-wider text-slate-900 border-b border-slate-100 pb-3 mb-4">
            Related Utilities
          </h3>
          <ul class="space-y-3">
            {related.map((rel) => (
              <li>
                <a
                  href={`/tool/${rel.id}`}
                  class="group flex items-center justify-between text-xs font-semibold text-slate-700 hover:text-[#EE6C4D] transition-colors p-2 rounded-lg hover:bg-slate-50"
                >
                  <span class="truncate pr-2">{rel.name}</span>
                  <svg class="w-3.5 h-3.5 text-slate-400 group-hover:translate-x-1 group-hover:text-[#EE6C4D] transition-all shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Sticky Sidebar Ad Slot -->
      <AdSlot slotId="tool-sidebar-sticky" minHeight="250px" />
    </aside>
  </div>
</BaseLayout>
