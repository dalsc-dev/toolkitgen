---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import ToolCard from '@components/ToolCard.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import AdSlot from '@components/AdSlot.astro';
import { generateJsonLd } from '@lib/schema';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  const guides = await getCollection('guides');
  const catMap = new Map<string, { name: string; tools: typeof tools }>();

  for (const t of tools) {
    const slug = t.data.category.toLowerCase().replace(/[^a-z0-9]+/g, '-');
    if (!catMap.has(slug)) {
      catMap.set(slug, { name: t.data.category, tools: [] });
    }
    catMap.get(slug)!.tools.push(t);
  }

  return Array.from(catMap.entries()).map(([slug, data]) => {
    const categoryGuides = guides.filter((g) => g.data.hubSlug === slug);
    return {
      params: { cat: slug },
      props: {
        categoryName: data.name,
        categorySlug: slug,
        tools: data.tools,
        guides: categoryGuides,
      },
    };
  });
}

interface Props {
  categoryName: string;
  categorySlug: string;
  tools: Array<CollectionEntry<'tools'>>;
  guides: Array<CollectionEntry<'guides'>>;
}

const { categoryName, categorySlug, tools, guides = [] } = Astro.props;
const canonicalUrl = `https://toolkitgen.com/category/${categorySlug}`;

const jsonLd = generateJsonLd({
  type: 'website',
  title: `${categoryName} Tools & Troubleshooting Hub | Toolkit Gen`,
  description: `Browse all free client-side tools and diagnostic guides under ${categoryName}. Calculations run in your browser. Inputs are not uploaded.`,
  url: canonicalUrl,
  breadcrumbs: [
    { name: 'Home', url: '/' },
    { name: 'Directory', url: '/tool' },
    { name: categoryName, url: canonicalUrl },
  ],
});
---

<BaseLayout
  title={`${categoryName} Tools & Diagnostic Hub | Toolkit Gen`}
  description={`Browse free online utilities, calculators, and symptom troubleshooting guides in ${categoryName}. Calculations run in your browser, and inputs are not uploaded.`}
  canonical={canonicalUrl}
  jsonLd={jsonLd}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10 py-6">
    <Breadcrumbs items={[
      { name: 'Directory', url: '/tool' },
      { name: categoryName, url: canonicalUrl },
    ]} />

    <!-- Hub Header Block -->
    <header class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200/80 shadow-sm space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-4">
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-1 rounded-md text-[11px] font-black uppercase tracking-wider bg-orange-50 text-[#EE6C4D] border border-orange-200/60">
            Category Hub
          </span>
          <span class="px-2.5 py-1 rounded-md text-[11px] font-bold text-slate-600 bg-slate-100 border border-slate-200/60">
            {tools.length} In-Browser Utilities
          </span>
        </div>
        <span class="text-xs text-slate-400">
          Audited In-Browser Execution
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 tracking-tight leading-tight">
        {categoryName} Tools &amp; Diagnostics
      </h1>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-3xl">
        Curated client-side web tools and in-depth diagnostic guides in the {categoryName} collection. Calculations execute in browser memory with local data processing.
      </p>
    </header>

    <!-- Symptom Troubleshooting Guides (if any exist for this hub) -->
    {guides.length > 0 && (
      <section class="space-y-4">
        <div class="flex items-center justify-between border-b border-slate-200 pb-3">
          <h2 class="text-base font-bold text-slate-900 uppercase tracking-wider text-xs">
            {categoryName} Symptom Troubleshooting Guides ({guides.length})
          </h2>
          <span class="text-xs text-slate-400">In-Depth Hardware &amp; Engineering Analyses</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {guides.map((g) => (
            <a
              href={`/guide/${g.data.slug}`}
              class="group p-6 bg-white rounded-3xl border border-slate-200/80 shadow-2xs hover:shadow-md hover:border-[#EE6C4D]/40 transition-all flex flex-col justify-between"
            >
              <div class="space-y-2">
                <span class="text-[10px] font-bold uppercase tracking-wider text-[#EE6C4D] bg-orange-50 px-2 py-0.5 rounded border border-orange-200/60">
                  Hardware Guide
                </span>
                <h3 class="text-base font-bold text-slate-900 group-hover:text-[#EE6C4D] transition-colors leading-snug">
                  {g.data.title}
                </h3>
                <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed">
                  {g.data.description}
                </p>
              </div>
              <span class="text-xs font-bold text-[#EE6C4D] mt-4 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                <span>Read Troubleshooting Guide</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Category Tools Grid -->
    <section class="space-y-4">
      <div class="border-b border-slate-200 pb-3">
        <h2 class="text-base font-bold text-slate-900 uppercase tracking-wider text-xs">
          Interactive {categoryName} Utilities ({tools.length})
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {tools.map((tool) => (
          <ToolCard
            id={tool.data.id}
            name={tool.data.name}
            description={tool.data.description}
            category={tool.data.category}
            featured={tool.data.featured}
            tags={tool.data.tags}
          />
        ))}
      </div>
    </section>

    <!-- In-Article Editorial Unit -->
    <AdSlot slotId="inArticle2" />
  </div>
</BaseLayout>
