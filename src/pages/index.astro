---
import BaseLayout from '@layouts/BaseLayout.astro';
import ToolCard from '@components/ToolCard.astro';
import AdSlot from '@components/AdSlot.astro';
import { getCollection } from 'astro:content';
import { generateJsonLd } from '@lib/schema';
import { HERO_COPY, HOME_INTRO } from '@lib/copy';

const tools = await getCollection('tools');

const jsonLd = generateJsonLd({
  type: 'website',
  title: 'Toolkit Gen | Professional Online Tools and Calculators',
  description: HERO_COPY.sub,
  url: 'https://toolkitgen.com',
});
---

<BaseLayout
  title="Toolkit Gen | Professional Online Tools and Calculators"
  description={HERO_COPY.sub}
  canonical="https://toolkitgen.com"
  jsonLd={jsonLd}
  containerClass="w-full"
>
  <!-- Hero Section with Exact Legacy Radial Gradients & Animated Blobs -->
  <section class="hero-gradient relative pt-28 pb-20 lg:pt-36 lg:pb-28 overflow-hidden text-center text-white">
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none" aria-hidden="true">
      <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-[#EE6C4D] rounded-full mix-blend-multiply filter blur-[128px] opacity-20 animate-blob"></div>
      <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-purple-500 rounded-full mix-blend-multiply filter blur-[128px] opacity-20 animate-blob animation-delay-2000"></div>
    </div>

    <div class="max-w-5xl mx-auto px-4 relative z-30">
      <!-- Search Intent Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 border border-white/15 backdrop-blur-sm mb-6 animate-fade-up select-none">
        <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
        </svg>
        <span class="text-xs font-semibold text-slate-200 tracking-wide uppercase">Runs in Your Browser</span>
      </div>

      <!-- H1 with Orange Gradient Accent -->
      <h1 class="text-4xl sm:text-5xl md:text-7xl font-extrabold text-white mb-6 tracking-tight leading-tight break-words">
        Professional <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#EE6C4D] to-orange-300">Online Tools</span> and Calculators
      </h1>

      <!-- Subheadline -->
      <p class="text-base sm:text-lg md:text-xl text-slate-300 mb-10 max-w-2xl mx-auto leading-relaxed animate-fade-up break-words" style="animation-delay: 0.2s;">
        {HERO_COPY.sub}
      </p>

      <!-- Search Input Container -->
      <div class="max-w-2xl mx-auto animate-fade-up px-2 sm:px-0" style="animation-delay: 0.3s;">
        <div class="relative group w-full flex items-center bg-white shadow-2xl rounded-2xl transition-all hover:ring-4 hover:ring-[#EE6C4D]/30">
          <div class="pl-4 sm:pl-5 flex items-center pointer-events-none">
            <svg class="w-5 h-5 sm:w-6 sm:h-6 text-gray-400 group-hover:text-[#EE6C4D] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <input
            type="search"
            id="tool-search-input"
            placeholder="Search tools by keyword, formula, or discipline..."
            class="w-full text-left pl-3 sm:pl-4 py-4 sm:py-5 text-gray-700 placeholder-gray-400 text-base sm:text-lg bg-transparent border-none outline-none rounded-2xl"
          />
          <kbd class="hidden sm:inline-block mr-4 text-xs bg-slate-100 border border-slate-200 rounded px-2 py-1 text-slate-400 font-mono">Ctrl K</kbd>
        </div>

        <!-- Trust Badges -->
        <div class="mt-8 hidden sm:flex flex-wrap justify-center gap-3 sm:gap-6 text-sm text-slate-300">
          <div class="flex items-center gap-2 px-3 py-1.5 bg-white/5 rounded-full border border-white/10 backdrop-blur-md">
            <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
            <span>No Account Required</span>
          </div>
          <div class="flex items-center gap-2 px-3 py-1.5 bg-white/5 rounded-full border border-white/10 backdrop-blur-md">
            <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
            <span>Free to Use</span>
          </div>
          <div class="flex items-center gap-2 px-3 py-1.5 bg-white/5 rounded-full border border-white/10 backdrop-blur-md">
            <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
            <span>Inputs Processed Locally</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Body Content Container -->
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">
    <!-- Intro Statement -->
    <section class="max-w-4xl mx-auto text-center space-y-3">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
        {HOME_INTRO.heading}
      </h2>
      <p class="text-slate-600 text-base leading-relaxed">
        {HOME_INTRO.body}
      </p>
    </section>

    <!-- Hubs Highlights -->
    <section id="hubs">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-2xl font-black text-slate-900 tracking-tight">Specialized Hubs &amp; OS Suites</h2>
          <p class="text-sm text-slate-500 mt-0.5">Multi-engine workflows built for specific disciplines.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/hubs/freelancer" class="group bg-gradient-to-br from-indigo-50/70 to-purple-50/70 rounded-3xl p-6 sm:p-8 border border-indigo-100 hover:border-indigo-300 shadow-sm hover:shadow-xl transition-all duration-300">
          <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 bg-white/80 px-2.5 py-1 rounded-md border border-indigo-100">Suite</span>
          <h3 class="text-xl font-bold text-slate-900 mt-4 group-hover:text-indigo-600 transition-colors">Freelancer &amp; Creator OS</h3>
          <p class="text-sm text-slate-600 mt-2 leading-relaxed">Integrated rate calculator, LTV/CAC models, contract builder, and global tax calculators.</p>
          <span class="inline-flex items-center gap-1.5 text-xs font-bold text-indigo-600 mt-5 group-hover:translate-x-1 transition-transform">
            Open OS Dashboard &rarr;
          </span>
        </a>

        <a href="/hubs/startup" class="group bg-gradient-to-br from-amber-50/70 to-orange-50/70 rounded-3xl p-6 sm:p-8 border border-amber-100 hover:border-amber-300 shadow-sm hover:shadow-xl transition-all duration-300">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-700 bg-white/80 px-2.5 py-1 rounded-md border border-amber-100">Suite</span>
          <h3 class="text-xl font-bold text-slate-900 mt-4 group-hover:text-amber-700 transition-colors">Founder's Forge Startup OS</h3>
          <p class="text-sm text-slate-600 mt-2 leading-relaxed">Runway calculators, AI server burn death simulators, co-founder equity splits, and SaaS metrics.</p>
          <span class="inline-flex items-center gap-1.5 text-xs font-bold text-amber-700 mt-5 group-hover:translate-x-1 transition-transform">
            Open Startup Suite &rarr;
          </span>
        </a>

        <a href="/hubs/wellness" class="group bg-gradient-to-br from-teal-50/70 to-emerald-50/70 rounded-3xl p-6 sm:p-8 border border-teal-100 hover:border-teal-300 shadow-sm hover:shadow-xl transition-all duration-300">
          <span class="text-xs font-bold uppercase tracking-wider text-teal-700 bg-white/80 px-2.5 py-1 rounded-md border border-teal-100">Suite</span>
          <h3 class="text-xl font-bold text-slate-900 mt-4 group-hover:text-teal-700 transition-colors">Mental Focus &amp; Wellness</h3>
          <p class="text-sm text-slate-600 mt-2 leading-relaxed">Tech neck posture alarms, eye-strain blink trackers, sleep debt calculators, and breathing trainers.</p>
          <span class="inline-flex items-center gap-1.5 text-xs font-bold text-teal-700 mt-5 group-hover:translate-x-1 transition-transform">
            Open Wellness Suite &rarr;
          </span>
        </a>
      </div>
    </section>

    <!-- Mid-Page Ad Slot (Zero CLS with reserved min-height) -->
    <AdSlot slotId="home-mid-banner" minHeight="250px" />

    <!-- Directory Section - 100% Pre-Rendered Build-Time HTML -->
    <section id="directory">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-2xl font-black text-slate-900 tracking-tight">Full Utility Directory</h2>
          <p class="text-sm text-slate-500 mt-0.5">Pre-rendered static cards loaded with zero DOM lag.</p>
        </div>
        <span class="text-xs font-bold text-slate-400 bg-slate-100 px-3 py-1.5 rounded-full border border-slate-200">
          {tools.length} Tools Available
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="tools-grid">
        {tools.map((tool) => (
          <ToolCard
            id={tool.data.id}
            name={tool.data.name}
            title={tool.data.title}
            description={tool.data.description}
            category={tool.data.category}
            icon={tool.data.icon}
          />
        ))}
      </div>
    </section>
  </div>

  <!-- Client-side Interactive Filter Script -->
  <script is:inline>
    const searchInput = document.getElementById('tool-search-input');
    const cards = document.querySelectorAll('.tool-card');

    if (searchInput && cards.length > 0) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        cards.forEach((card) => {
          const text = (card.getAttribute('data-tool-text') || '').toLowerCase();
          if (!query || text.includes(query)) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });

      // Keyboard shortcut Ctrl+K / Cmd+K focus
      window.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
          e.preventDefault();
          searchInput.focus();
        }
      });
    }
  </script>
</BaseLayout>
