---
import BaseLayout from '@layouts/BaseLayout.astro';
import ToolCard from '@components/ToolCard.astro';
import AdSlot from '@components/AdSlot.astro';
import { getCollection } from 'astro:content';
import { generateJsonLd } from '@lib/schema';
import { HERO_COPY, HOME_INTRO } from '@lib/copy';

const tools = await getCollection('tools');

// Build real build-time subsets
const trendingIds = [
  'docker_compose_linter',
  'amsler_grid_macular',
  'black_scholes_heatmap',
  'airdrop_web_universal',
  'voice_pitch_monitor',
  'sqlite_wasm_explorer',
];
const trendingTools = tools.filter((t) => trendingIds.includes(t.data.id));

// New arrivals (sorted by datePublished descending to showcase fresh additions)
const newArrivalTools = [...tools]
  .sort((a, b) => new Date(b.data.datePublished || '2025-01-01').getTime() - new Date(a.data.datePublished || '2025-01-01').getTime())
  .slice(0, 4);

// Top highlighted utilities in the sidebar (5 verified utilities with category labels, no dummy counts)
const popularSidebarItems = [
  { id: 'amsler_grid_macular', rank: 1, focus: 'Vision & Retina' },
  { id: 'docker_compose_linter', rank: 2, focus: 'DevOps & Containers' },
  { id: 'black_scholes_heatmap', rank: 3, focus: 'Derivatives Pricing' },
  { id: 'airdrop_web_universal', rank: 4, focus: 'P2P WebRTC Transfer' },
  { id: 'voice_pitch_monitor', rank: 5, focus: 'Acoustic Frequency' },
];
const popularSidebarTools = popularSidebarItems
  .map((p) => {
    const found = tools.find((t) => t.data.id === p.id);
    return found ? { ...found, rank: p.rank, focus: p.focus } : null;
  })
  .filter(Boolean);

const jsonLd = generateJsonLd({
  type: 'website',
  title: 'Toolkit Gen | Professional Online Tools and Calculators',
  description: HERO_COPY.sub,
  url: 'https://toolkitgen.com',
});
---

<BaseLayout
  title="Toolkit Gen | Professional Online Tools and Calculators"
  description={HERO_COPY.sub}
  canonical="https://toolkitgen.com"
  jsonLd={jsonLd}
  containerClass="w-full"
>
  <!-- Hero Section with Exact Legacy Radial Gradients & Animated Blobs -->
  <section class="hero-gradient relative pt-28 pb-16 lg:pt-36 lg:pb-24 overflow-hidden text-center text-white">
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none" aria-hidden="true">
      <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-[#EE6C4D] rounded-full mix-blend-multiply filter blur-[128px] opacity-20 animate-blob"></div>
      <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-purple-500 rounded-full mix-blend-multiply filter blur-[128px] opacity-20 animate-blob animation-delay-2000"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-30">
      <!-- Search Intent Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 border border-white/15 backdrop-blur-sm mb-6 animate-fade-up select-none">
        <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
        </svg>
        <span class="text-xs font-semibold text-slate-200 tracking-wide uppercase">Runs in Your Browser</span>
      </div>

      <!-- H1 with Orange Gradient Accent -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold text-white mb-6 tracking-tight leading-tight break-words">
        Professional <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#EE6C4D] to-orange-300">Online Tools</span> and Calculators
      </h1>

      <!-- Subheadline -->
      <p class="text-base sm:text-lg md:text-xl text-slate-300 mb-10 max-w-2xl mx-auto leading-relaxed animate-fade-up break-words" style="animation-delay: 0.2s;">
        {HERO_COPY.sub}
      </p>

      <!-- Search Trigger Input (Opens Command Palette) -->
      <div class="max-w-2xl mx-auto animate-fade-up px-2 sm:px-0" style="animation-delay: 0.3s;">
        <button
          type="button"
          data-open-cmd
          class="relative group w-full flex items-center bg-white shadow-2xl rounded-2xl transition-all hover:ring-4 hover:ring-[#EE6C4D]/30 text-left cursor-pointer p-0"
        >
          <div class="pl-4 sm:pl-5 flex items-center pointer-events-none">
            <svg class="w-5 h-5 sm:w-6 sm:h-6 text-gray-400 group-hover:text-[#EE6C4D] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <span class="w-full pl-3 sm:pl-4 py-4 sm:py-5 text-gray-400 text-base sm:text-lg">
            Search {tools.length} tools by keyword, formula, or discipline...
          </span>
          <kbd class="hidden sm:inline-block mr-4 text-xs bg-slate-100 border border-slate-200 rounded px-2 py-1 text-slate-400 font-mono">Ctrl K</kbd>
        </button>

        <!-- Trust Badges -->
        <div class="mt-8 hidden sm:flex flex-wrap justify-center gap-3 sm:gap-6 text-sm text-slate-300">
          <div class="flex items-center gap-2 px-3 py-1.5 bg-white/5 rounded-full border border-white/10 backdrop-blur-md">
            <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
            <span>No Account Required</span>
          </div>
          <div class="flex items-center gap-2 px-3 py-1.5 bg-white/5 rounded-full border border-white/10 backdrop-blur-md">
            <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
            <span>Free to Use</span>
          </div>
          <div class="flex items-center gap-2 px-3 py-1.5 bg-white/5 rounded-full border border-white/10 backdrop-blur-md">
            <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
            <span>Inputs Processed Locally</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Body Content Container: max-w-7xl Shared Fluid Container System -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">
    <!-- Intro Statement -->
    <section class="max-w-4xl mx-auto text-center space-y-3">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
        {HOME_INTRO.heading}
      </h2>
      <p class="text-slate-600 text-base leading-relaxed">
        {HOME_INTRO.body}
      </p>
    </section>

    <!-- Trending Utilities Section (Build-Time HTML) -->
    <section id="trending" class="space-y-6">
      <div class="flex items-center justify-between border-b border-slate-100 pb-4">
        <div>
          <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#EE6C4D]">
            <span class="w-2 h-2 rounded-full bg-[#EE6C4D] animate-ping"></span>
            High Traffic
          </div>
          <h2 class="text-2xl font-black text-slate-900 tracking-tight mt-1">Trending Utilities</h2>
        </div>
        <a href="/tool" class="text-xs font-bold text-[#EE6C4D] hover:underline flex items-center gap-1">
          View all {tools.length} tools &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {trendingTools.map((tool) => (
          <ToolCard
            id={tool.data.id}
            name={tool.data.name || tool.data.title}
            description={tool.data.description}
            category={tool.data.category}
            featured={true}
          />
        ))}
      </div>
    </section>

    <!-- New Arrivals Section (Build-Time HTML) -->
    <section id="new-arrivals" class="space-y-6">
      <div class="flex items-center justify-between border-b border-slate-100 pb-4">
        <div>
          <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-emerald-600">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            Fresh Releases
          </div>
          <h2 class="text-2xl font-black text-slate-900 tracking-tight mt-1">New Arrivals</h2>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {newArrivalTools.map((tool) => (
          <ToolCard
            id={tool.data.id}
            name={tool.data.name || tool.data.title}
            description={tool.data.description}
            category={tool.data.category}
          />
        ))}
      </div>
    </section>

    <!-- Specialized Hubs & Suites -->
    <section id="hubs" class="space-y-6">
      <div class="flex items-center justify-between border-b border-slate-100 pb-4">
        <div>
          <h2 class="text-2xl font-black text-slate-900 tracking-tight">Specialized Hubs &amp; OS Suites</h2>
          <p class="text-sm text-slate-500 mt-0.5">Multi-engine workflows built for specific disciplines.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <a href="/hubs/freelancer" class="group bg-gradient-to-br from-indigo-50/70 to-purple-50/70 rounded-3xl p-6 sm:p-8 border border-indigo-100 hover:border-indigo-300 shadow-xs hover:shadow-xl transition-all duration-300">
          <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 bg-white/80 px-2.5 py-1 rounded-md border border-indigo-100">Suite</span>
          <h3 class="text-xl font-bold text-slate-900 mt-4 group-hover:text-indigo-600 transition-colors">Freelancer &amp; Creator OS</h3>
          <p class="text-sm text-slate-600 mt-2 leading-relaxed">Integrated rate calculator, LTV/CAC models, contract builder, and global tax calculators.</p>
          <span class="inline-flex items-center gap-1.5 text-xs font-bold text-indigo-600 mt-5 group-hover:translate-x-1 transition-transform">
            Open OS Dashboard &rarr;
          </span>
        </a>

        <a href="/hubs/startup" class="group bg-gradient-to-br from-amber-50/70 to-orange-50/70 rounded-3xl p-6 sm:p-8 border border-amber-100 hover:border-amber-300 shadow-xs hover:shadow-xl transition-all duration-300">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-700 bg-white/80 px-2.5 py-1 rounded-md border border-amber-100">Suite</span>
          <h3 class="text-xl font-bold text-slate-900 mt-4 group-hover:text-amber-700 transition-colors">Founder's Forge Startup OS</h3>
          <p class="text-sm text-slate-600 mt-2 leading-relaxed">Runway calculators, AI server burn death simulators, co-founder equity splits, and SaaS metrics.</p>
          <span class="inline-flex items-center gap-1.5 text-xs font-bold text-amber-700 mt-5 group-hover:translate-x-1 transition-transform">
            Open Startup Suite &rarr;
          </span>
        </a>

        <a href="/hubs/wellness" class="group bg-gradient-to-br from-teal-50/70 to-emerald-50/70 rounded-3xl p-6 sm:p-8 border border-teal-100 hover:border-teal-300 shadow-xs hover:shadow-xl transition-all duration-300">
          <span class="text-xs font-bold uppercase tracking-wider text-teal-700 bg-white/80 px-2.5 py-1 rounded-md border border-teal-100">Suite</span>
          <h3 class="text-xl font-bold text-slate-900 mt-4 group-hover:text-teal-700 transition-colors">Mental Focus &amp; Wellness</h3>
          <p class="text-sm text-slate-600 mt-2 leading-relaxed">Tech neck posture alarms, eye-strain blink trackers, sleep debt calculators, and breathing trainers.</p>
          <span class="inline-flex items-center gap-1.5 text-xs font-bold text-teal-700 mt-5 group-hover:translate-x-1 transition-transform">
            Open Wellness Suite &rarr;
          </span>
        </a>

        <a href="/hubs/gaming" class="group bg-gradient-to-br from-violet-50/70 to-indigo-50/70 rounded-3xl p-6 sm:p-8 border border-violet-100 hover:border-violet-300 shadow-xs hover:shadow-xl transition-all duration-300">
          <span class="text-xs font-bold uppercase tracking-wider text-violet-700 bg-white/80 px-2.5 py-1 rounded-md border border-violet-100">Suite</span>
          <h3 class="text-xl font-bold text-slate-900 mt-4 group-hover:text-violet-700 transition-colors">Gaming Lab Suite</h3>
          <p class="text-sm text-slate-600 mt-2 leading-relaxed">Download bandwidth models, console storage planners, 1% low frame pacing, and controller telemetry.</p>
          <span class="inline-flex items-center gap-1.5 text-xs font-bold text-violet-700 mt-5 group-hover:translate-x-1 transition-transform">
            Open Gaming Suite &rarr;
          </span>
        </a>
      </div>
    </section>

    <!-- Mid-Page Ad Slot (Zero CLS with reserved min-height) -->
    <AdSlot slotId="home-mid-banner" minHeight="280px" />

    <!-- Two-Column Section: Directory (8 cols) + Popular This Week Sidebar (4 cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      <!-- Full Directory (8 cols) -->
      <section id="directory" class="lg:col-span-8 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
          <div>
            <h2 class="text-2xl font-black text-slate-900 tracking-tight">Full Tool Directory</h2>
            <p class="text-sm text-slate-500 mt-0.5">Pre-rendered cards loaded locally in your browser.</p>
          </div>
          <span class="text-xs font-bold text-slate-500 bg-slate-100 px-3 py-1.5 rounded-full border border-slate-200 self-start sm:self-auto">
            {tools.length} Tools Available
          </span>
        </div>

        <!-- Category Filter Chips -->
        <div class="flex flex-wrap gap-2 pt-2" id="category-filter-chips">
          <button
            type="button"
            class="chip-btn px-3.5 py-1.5 text-xs font-bold rounded-xl bg-slate-900 text-white shadow-xs transition-all"
            data-cat="all"
          >
            All ({tools.length})
          </button>
          <button
            type="button"
            class="chip-btn px-3.5 py-1.5 text-xs font-bold rounded-xl bg-white border border-slate-200/80 text-slate-600 hover:bg-slate-50 transition-all"
            data-cat="devops"
            id="cat-chip-devops"
          >
            DevOps &amp; Code
          </button>
          <button
            type="button"
            class="chip-btn px-3.5 py-1.5 text-xs font-bold rounded-xl bg-white border border-slate-200/80 text-slate-600 hover:bg-slate-50 transition-all"
            data-cat="finance"
            id="cat-chip-finance"
          >
            Finance &amp; FIRE
          </button>
          <button
            type="button"
            class="chip-btn px-3.5 py-1.5 text-xs font-bold rounded-xl bg-white border border-slate-200/80 text-slate-600 hover:bg-slate-50 transition-all"
            data-cat="health"
            id="cat-chip-health"
          >
            Health &amp; Diagnostics
          </button>
          <button
            type="button"
            class="chip-btn px-3.5 py-1.5 text-xs font-bold rounded-xl bg-white border border-slate-200/80 text-slate-600 hover:bg-slate-50 transition-all"
            data-cat="hardware"
            id="cat-chip-hardware"
          >
            Hardware &amp; Monitors
          </button>
          <button
            type="button"
            class="chip-btn px-3.5 py-1.5 text-xs font-bold rounded-xl bg-white border border-slate-200/80 text-slate-600 hover:bg-slate-50 transition-all"
            data-cat="audio"
            id="cat-chip-audio"
          >
            Audio &amp; Sensory
          </button>
        </div>

        <!-- Directory Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6" id="tools-grid">
          {tools.map((tool) => (
            <ToolCard
              id={tool.data.id}
              name={tool.data.name || tool.data.title}
              description={tool.data.description}
              category={tool.data.category}
              featured={tool.data.featured}
              tags={tool.data.tags}
            />
          ))}
        </div>
      </section>

      <!-- Sidebar: Popular Utilities (4 cols, sticky on scroll) -->
      <aside class="lg:col-span-4">
        <div class="lg:sticky lg:top-28 bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-xs space-y-6">
          <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 flex items-center gap-2">
              <svg class="w-4 h-4 text-[#EE6C4D]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
              Popular Utilities
            </h3>
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Top 5</span>
          </div>

          <div class="space-y-4">
            {popularSidebarTools.map((tool: any) => (
              <a
                href={`/tool/${tool.data.id}`}
                class="group flex items-start gap-3.5 p-2.5 rounded-xl hover:bg-slate-50 transition-colors"
              >
                <div class="w-7 h-7 rounded-lg bg-slate-100 text-slate-700 font-bold text-xs flex items-center justify-center shrink-0 group-hover:bg-[#EE6C4D] group-hover:text-white transition-colors">
                  {tool.rank}
                </div>
                <div class="min-w-0 flex-1">
                  <h4 class="text-xs font-bold text-slate-800 group-hover:text-[#EE6C4D] transition-colors truncate">
                    {(tool.data.name || tool.data.title || tool.data.id).replace(/\s*\|\s*Toolkit Gen.*$/i, '')}
                  </h4>
                  <div class="flex items-center gap-1.5 mt-1 text-[10px] text-slate-500">
                    <span class="uppercase font-semibold tracking-wider text-slate-600 truncate">{tool.data.category}</span>
                    <span class="text-slate-300">/</span>
                    <span class="text-slate-500 truncate">{tool.focus}</span>
                  </div>
                </div>
              </a>
            ))}
          </div>

          <!-- Sticky Sidebar Ad Slot (Google AdSense responsive sidebar: 5828686602) -->
          <AdSlot slotId="sidebarBanner" minHeight="250px" />
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const chips = document.querySelectorAll('#category-filter-chips .chip-btn');
    const cards = document.querySelectorAll('#tools-grid [data-category]');

    function filterCategory(cat) {
      chips.forEach((btn) => {
        if (btn.getAttribute('data-cat') === cat) {
          btn.classList.remove('bg-white', 'border', 'border-slate-200/80', 'text-slate-600');
          btn.classList.add('bg-slate-900', 'text-white', 'shadow-xs');
        } else {
          btn.classList.remove('bg-slate-900', 'text-white', 'shadow-xs');
          btn.classList.add('bg-white', 'border', 'border-slate-200/80', 'text-slate-600');
        }
      });

      cards.forEach((card) => {
        const itemCat = (card.getAttribute('data-category') || '').toLowerCase();
        if (cat === 'all' || itemCat.includes(cat.toLowerCase())) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    }

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const cat = chip.getAttribute('data-cat') || 'all';
        filterCategory(cat);
      });
    });

    // Hash anchor listener (#devops, #finance, #health, #hardware, #audio)
    function applyHash() {
      const hash = window.location.hash.toLowerCase().replace('#', '');
      if (['devops', 'finance', 'health', 'hardware', 'audio'].includes(hash)) {
        filterCategory(hash);
        document.getElementById('directory')?.scrollIntoView({ behavior: 'smooth' });
      }
    }

    window.addEventListener('hashchange', applyHash);
    if (window.location.hash) {
      setTimeout(applyHash, 100);
    }
  })();
</script>
