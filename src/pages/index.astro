---
import BaseLayout from '@layouts/BaseLayout.astro';
import ToolCard from '@components/ToolCard.astro';
import AdSlot from '@components/AdSlot.astro';
import { getCollection } from 'astro:content';
import { generateJsonLd } from '@lib/schema';
import { HERO_COPY, TRUST_COPY } from '@lib/copy';

// Build-time SSR data fetching - Zero empty containers!
const tools = await getCollection('tools');

const jsonLd = generateJsonLd({
  type: 'website',
  title: 'Toolkit Gen | Professional Online Tools and Calculators',
  description: HERO_COPY.sub,
  url: 'https://toolkitgen.com',
});
---

<BaseLayout
  title="Toolkit Gen | Professional Online Tools and Calculators"
  description={HERO_COPY.sub}
  canonical="https://toolkitgen.com"
  jsonLd={jsonLd}
>
  <!-- Hero Section -->
  <section class="py-12 sm:py-16 text-center space-y-6 max-w-4xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-100 border border-slate-200 text-slate-700 text-xs font-semibold tracking-wide">
      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
      {TRUST_COPY.trustLine}
    </div>

    <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-slate-900 tracking-tight leading-tight">
      {HERO_COPY.h1}
    </h1>

    <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto">
      {HERO_COPY.sub}
    </p>

    <!-- Search / Filter Interactive Bar (Progressive Enhancement) -->
    <div class="pt-2 max-w-xl mx-auto">
      <div class="relative flex items-center">
        <input
          type="search"
          id="tool-search-input"
          placeholder="Filter tools by keyword, category, or tag..."
          class="w-full px-5 py-4 pl-12 rounded-2xl bg-white border border-slate-200/90 shadow-sm text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-[#EE6C4D] focus:border-transparent transition-all"
        />
        <svg class="w-5 h-5 text-slate-400 absolute left-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
      </div>
    </div>
  </section>

  <!-- Hubs Highlights -->
  <section class="my-10">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-2xl font-black text-slate-900 tracking-tight">Specialized Hubs &amp; OS Suites</h2>
        <p class="text-sm text-slate-500 mt-0.5">Multi-engine workflows built for specific disciplines.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <a href="/hubs/freelancer" class="group bg-gradient-to-br from-indigo-50/70 to-purple-50/70 rounded-3xl p-6 sm:p-8 border border-indigo-100 hover:border-indigo-300 shadow-sm hover:shadow-xl transition-all duration-300">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 bg-white/80 px-2.5 py-1 rounded-md border border-indigo-100">Suite</span>
        <h3 class="text-xl font-bold text-slate-900 mt-4 group-hover:text-indigo-600 transition-colors">Freelancer &amp; Creator OS</h3>
        <p class="text-sm text-slate-600 mt-2 leading-relaxed">Integrated rate calculator, LTV/CAC models, Zoom tax estimators, and global tax calculators.</p>
        <span class="inline-flex items-center gap-1.5 text-xs font-bold text-indigo-600 mt-5 group-hover:translate-x-1 transition-transform">
          Open OS Dashboard &rarr;
        </span>
      </a>

      <a href="/hubs/startup" class="group bg-gradient-to-br from-amber-50/70 to-orange-50/70 rounded-3xl p-6 sm:p-8 border border-amber-100 hover:border-amber-300 shadow-sm hover:shadow-xl transition-all duration-300">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-700 bg-white/80 px-2.5 py-1 rounded-md border border-amber-100">Suite</span>
        <h3 class="text-xl font-bold text-slate-900 mt-4 group-hover:text-amber-700 transition-colors">Founder's Forge Startup OS</h3>
        <p class="text-sm text-slate-600 mt-2 leading-relaxed">Runway calculators, AI server burn death simulators, co-founder equity splits, and SaaS metrics.</p>
        <span class="inline-flex items-center gap-1.5 text-xs font-bold text-amber-700 mt-5 group-hover:translate-x-1 transition-transform">
          Open Startup Suite &rarr;
        </span>
      </a>

      <a href="/hubs/wellness" class="group bg-gradient-to-br from-teal-50/70 to-emerald-50/70 rounded-3xl p-6 sm:p-8 border border-teal-100 hover:border-teal-300 shadow-sm hover:shadow-xl transition-all duration-300">
        <span class="text-xs font-bold uppercase tracking-wider text-teal-700 bg-white/80 px-2.5 py-1 rounded-md border border-teal-100">Suite</span>
        <h3 class="text-xl font-bold text-slate-900 mt-4 group-hover:text-teal-700 transition-colors">Mental Focus &amp; Wellness</h3>
        <p class="text-sm text-slate-600 mt-2 leading-relaxed">Tech neck posture alarms, eye-strain blink trackers, brain fog RAM calculators, and breathing trainers.</p>
        <span class="inline-flex items-center gap-1.5 text-xs font-bold text-teal-700 mt-5 group-hover:translate-x-1 transition-transform">
          Open Wellness Suite &rarr;
        </span>
      </a>
    </div>
  </section>

  <!-- Mid-Page Ad Slot (Zero CLS with reserved min-height) -->
  <AdSlot slotId="home-mid-banner" minHeight="250px" />

  <!-- Directory Section - 100% Pre-Rendered Build-Time HTML -->
  <section class="my-12" id="directory">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl font-black text-slate-900 tracking-tight">Active Tools Directory</h2>
        <p class="text-sm text-slate-500 mt-0.5">Pre-rendered static cards loaded with zero client-side DOM lag.</p>
      </div>
      <a href="/tool" class="text-xs font-bold text-[#EE6C4D] hover:underline flex items-center gap-1">
        Full Directory Index &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="tools-grid">
      {tools.map((tool) => (
        <ToolCard
          id={tool.data.id}
          name={tool.data.name}
          description={tool.data.description}
          category={tool.data.category}
          featured={tool.data.featured}
          tags={tool.data.tags}
        />
      ))}
    </div>
  </section>

  <!-- Editorial & Architectural Trust Block -->
  <section class="my-16 bg-white rounded-3xl p-8 sm:p-12 border border-slate-200/80 shadow-sm">
    <div class="max-w-3xl space-y-4">
      <h2 class="text-2xl font-black text-slate-900 tracking-tight">
        {HERO_COPY.introHeading}
      </h2>
      <p class="text-sm text-slate-600 leading-relaxed">
        {HERO_COPY.introBody}
      </p>
      <p class="text-sm text-slate-600 leading-relaxed">
        {TRUST_COPY.browserExecution} {TRUST_COPY.localStorage}
      </p>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // Progressive enhancement search filter
  const searchInput = document.getElementById('tool-search-input');
  const toolsGrid = document.getElementById('tools-grid');
  if (searchInput && toolsGrid) {
    searchInput.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();
      const cards = toolsGrid.querySelectorAll('[data-tool-id]');
      cards.forEach((card) => {
        const text = card.textContent.toLowerCase();
        if (text.includes(q)) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  }
</script>
