---
import { getCollection, type CollectionEntry } from 'astro:content';
import ToolLayout from '@layouts/ToolLayout.astro';
import AmslerGridIsland from '@tools/amsler_grid_macular/AmslerGridIsland';
import DockerLinterIsland from '@tools/docker_compose_linter/DockerLinterIsland';
import AirDropIsland from '@tools/airdrop_web_universal/AirDropIsland';
import { processMath } from '@lib/math';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  const catalogSummary = tools.map((t) => {
    const cleanName = (t.data.name || t.data.title || t.data.id)
      .replace(/\s*\|\s*Toolkit Gen.*$/i, '')
      .trim();
    return {
      id: t.data.id,
      name: cleanName,
      title: `${cleanName} | Toolkit Gen`,
      category: t.data.category,
      description: t.data.description,
      featured: t.data.featured,
    };
  });

  return tools.map((tool) => ({
    params: { slug: tool.data.id },
    props: { tool, allTools: catalogSummary },
  }));
}

interface Props {
  tool: CollectionEntry<'tools'>;
  allTools: Array<{
    id: string;
    name: string;
    title: string;
    category: string;
    description: string;
    featured?: boolean;
  }>;
}

const { tool, allTools } = Astro.props;
const {
  id,
  name,
  title,
  description,
  category,
  quickAnswer,
  faq,
  howTo,
  related,
  datePublished,
  dateModified,
  externalScripts = [],
  articleHtml,
  toolHtml = '',
  toolScript = '',
} = tool.data;

const cleanName = (name || title || id)
  .replace(/\s*\|\s*Toolkit Gen.*$/i, '')
  .trim();

// Preprocess math at build time
const { html: processedArticleHtml, hasMath: articleHasMath } = processMath(articleHtml || '');
const { html: processedToolHtml, hasMath: toolHasMath } = processMath(toolHtml || '');
const { html: processedQuickAnswer, hasMath: qaHasMath } = processMath(quickAnswer || '');
const hasMath = articleHasMath || toolHasMath || qaHasMath;
---

<ToolLayout
  id={id}
  name={cleanName}
  title={title}
  description={description}
  category={category}
  quickAnswer={processedQuickAnswer}
  faq={faq}
  howTo={howTo}
  related={related}
  allTools={allTools}
  datePublished={datePublished}
  dateModified={dateModified}
  hasMath={hasMath}
>
  <div slot="tool-ui">
    {externalScripts && externalScripts.length > 0 && (
      <script is:inline define:vars={{ scripts: externalScripts }}>
        (() => {
          let loaded = false;
          function loadExternalScripts() {
            if (loaded) return;
            loaded = true;
            scripts.forEach((src) => {
              if (!document.querySelector(`script[src="${src}"]`)) {
                const s = document.createElement('script');
                s.src = src;
                s.async = true;
                document.head.appendChild(s);
              }
            });
          }
          // Warm on first pointerenter or focus of tool stage
          const stage = document.getElementById('tool-app-stage');
          if (stage) {
            stage.addEventListener('pointerenter', loadExternalScripts, { once: true, passive: true });
            stage.addEventListener('focusin', loadExternalScripts, { once: true, passive: true });
            stage.addEventListener('click', loadExternalScripts, { once: true, passive: true });
          }
          // Defer fallback loading until after idle
          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(() => { setTimeout(loadExternalScripts, 2500); }, { timeout: 5000 });
          } else {
            setTimeout(loadExternalScripts, 3500);
          }
        })();
      </script>
    )}

    <!-- Crash Guard Error Boundary Fallback -->
    <div
      id="tool-error-fallback"
      class="hidden p-8 text-center bg-rose-50 border border-rose-200 rounded-2xl my-4 text-slate-800"
    >
      <h3 class="text-base font-bold text-rose-900">This tool encountered an initialization error</h3>
      <p class="text-xs text-rose-700 mt-1">Please reload the page to restart the tool session.</p>
      <button
        type="button"
        onclick="window.location.reload()"
        class="mt-4 px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs rounded-xl transition shadow-xs"
      >
        Reload Tool
      </button>
    </div>

    {id === 'amsler_grid_macular' && <AmslerGridIsland client:visible />}
    {id === 'docker_compose_linter' && <DockerLinterIsland client:visible />}
    {id === 'airdrop_web_universal' && <AirDropIsland client:visible />}

    {!['amsler_grid_macular', 'docker_compose_linter', 'airdrop_web_universal'].includes(id) && (
      <div>
        <div class="tool-stage-card overflow-hidden" set:html={processedToolHtml} />
        <script is:inline>
          (() => {
            if (typeof window.Chart === 'undefined') {
              window.Chart = class Chart { constructor() {} destroy() {} update() {} };
            }
            const origGet = document.getElementById.bind(document);
            const safeProxy = new Proxy(document.createElement('div'), {
              get(t, p) {
                if (p === 'getContext') return () => null;
                if (p === 'addEventListener' || p === 'removeEventListener') return () => {};
                if (p === 'style') return {};
                if (p === 'classList') return { add: () => {}, remove: () => {}, toggle: () => {}, contains: () => false };
                if (p === 'querySelector') return () => null;
                if (p === 'querySelectorAll') return () => [];
                return t[p] ?? '';
              },
              set(t, p, v) { t[p] = v; return true; }
            });
            document.getElementById = (id) => origGet(id) || safeProxy;

            // Resource leak prevention & crash listener
            window.addEventListener('pagehide', () => {
              if (window.__activeMediaStreams && Array.isArray(window.__activeMediaStreams)) {
                window.__activeMediaStreams.forEach(stream => {
                  try { stream.getTracks().forEach(track => track.stop()); } catch (e) {}
                });
              }
              if (window.__activeAudioContexts && Array.isArray(window.__activeAudioContexts)) {
                window.__activeAudioContexts.forEach(ctx => {
                  try { ctx.close(); } catch (e) {}
                });
              }
            }, { passive: true });
          })();
        </script>
        {toolScript && (
          <script
            is:inline
            type={/^\s*import\b/m.test(toolScript) ? 'module' : undefined}
            set:html={toolScript}
          />
        )}
      </div>
    )}
  </div>

  <div slot="article" set:html={processedArticleHtml} />
</ToolLayout>
