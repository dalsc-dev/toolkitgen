---
import { getCollection, type CollectionEntry } from 'astro:content';
import ToolLayout from '@layouts/ToolLayout.astro';
import AmslerGridIsland from '@tools/amsler_grid_macular/AmslerGridIsland';
import DockerLinterIsland from '@tools/docker_compose_linter/DockerLinterIsland';
import AirDropIsland from '@tools/airdrop_web_universal/AirDropIsland';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  const catalogSummary = tools.map((t) => ({
    id: t.data.id,
    name: t.data.title || t.data.name,
    title: t.data.title || t.data.name,
    category: t.data.category,
    description: t.data.description,
    featured: t.data.featured,
  }));

  return tools.map((tool) => ({
    params: { slug: tool.data.id },
    props: { tool, allTools: catalogSummary },
  }));
}

interface Props {
  tool: CollectionEntry<'tools'>;
  allTools: Array<{
    id: string;
    name: string;
    title: string;
    category: string;
    description: string;
    featured?: boolean;
  }>;
}

const { tool, allTools } = Astro.props;
const {
  id,
  title,
  description,
  category,
  quickAnswer,
  faq,
  howTo,
  related,
  datePublished,
  dateModified,
  externalScripts = [],
  articleHtml,
  toolHtml = '',
  toolScript = '',
} = tool.data;
---

<ToolLayout
  id={id}
  title={title}
  description={description}
  category={category}
  quickAnswer={quickAnswer}
  faq={faq}
  howTo={howTo}
  related={related}
  allTools={allTools}
  datePublished={datePublished}
  dateModified={dateModified}
>
  <div slot="tool-ui">
    {externalScripts && externalScripts.map((src: string) => (
      <script src={src} is:inline></script>
    ))}

    {id === 'amsler_grid_macular' && <AmslerGridIsland client:visible />}
    {id === 'docker_compose_linter' && <DockerLinterIsland client:visible />}
    {id === 'airdrop_web_universal' && <AirDropIsland client:visible />}

    {!['amsler_grid_macular', 'docker_compose_linter', 'airdrop_web_universal'].includes(id) && (
      <div>
        <div class="tool-stage-card overflow-hidden" set:html={toolHtml} />
        {toolScript && (
          <script
            is:inline
            type={/^\s*import\b/m.test(toolScript) ? 'module' : undefined}
            set:html={toolScript}
          />
        )}
      </div>
    )}
  </div>

  <div slot="article" set:html={articleHtml} />
</ToolLayout>
