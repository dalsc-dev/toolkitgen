---
import { getCollection, type CollectionEntry } from 'astro:content';
import ToolLayout from '@layouts/ToolLayout.astro';
import AmslerGridIsland from '@tools/amsler_grid_macular/AmslerGridIsland';
import DockerLinterIsland from '@tools/docker_compose_linter/DockerLinterIsland';
import AirDropIsland from '@tools/airdrop_web_universal/AirDropIsland';
import { processMath } from '@lib/math';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  const guides = await getCollection('guides');
  const catalogSummary = tools.map((t) => {
    const cleanName = (t.data.name || t.data.title || t.data.id)
      .replace(/\s*\|\s*Toolkit Gen.*$/i, '')
      .trim();
    return {
      id: t.data.id,
      name: cleanName,
      title: `${cleanName} | Toolkit Gen`,
      category: t.data.category,
      description: t.data.description,
      featured: t.data.featured,
    };
  });

  return tools.map((tool) => {
    const id = tool.data.id;
    const related = tool.data.related || [];
    const hotTools = catalogSummary.filter((t) => t.id !== id).slice(0, 2);
    const validRelated = related
      .filter((r: any) => r.id !== id)
      .map((r: any) => {
        const match = catalogSummary.find((t) => t.id === r.id);
        return match
          ? {
              ...match,
              ...r,
              name: r.name || match.name,
              category: r.category || match.category,
              description: r.description || match.description,
            }
          : r;
      });

    const recommendedTool = validRelated.length > 0
      ? validRelated[0]
      : catalogSummary.find((t) => t.id !== id) || {
          id: 'sqlite_wasm_explorer',
          name: 'SQLite WASM Explorer',
          title: 'SQLite WASM Explorer | Toolkit Gen',
          description: 'In-browser SQL sandbox and analyzer.',
          category: 'DevOps & Code',
        };

    const remainingRelated = validRelated.filter((t: any) => t.id !== recommendedTool.id);
    const fallbackTools = catalogSummary.filter(
      (t) => t.id !== id && t.id !== recommendedTool.id && !remainingRelated.some((r: any) => r.id === t.id)
    );
    const diagnosticTools = [...remainingRelated, ...fallbackTools].slice(0, 5);

    const relatedGuides = guides
      .filter((g) => g.data.relatedTools.includes(id))
      .map((g) => ({
        title: g.data.title,
        slug: g.data.slug,
        description: g.data.description,
      }));

    return {
      params: { slug: tool.data.id },
      props: { tool, hotTools, recommendedTool, diagnosticTools, relatedGuides },
    };
  });
}

interface Props {
  tool: CollectionEntry<'tools'>;
  hotTools: Array<{
    id: string;
    name: string;
    title: string;
    category: string;
    description: string;
  }>;
  recommendedTool: {
    id: string;
    name: string;
    title: string;
    category: string;
    description: string;
  };
  diagnosticTools: Array<{
    id: string;
    name: string;
    title: string;
    category: string;
    description: string;
  }>;
  relatedGuides?: Array<{
    title: string;
    slug: string;
    description: string;
  }>;
}

const { tool, hotTools, recommendedTool, diagnosticTools, relatedGuides = [] } = Astro.props;
const {
  id,
  name,
  title,
  description,
  category,
  quickAnswer,
  faq,
  howTo,
  related,
  datePublished,
  dateModified,
  externalScripts = [],
  articleHtml,
  toolHtml = '',
  toolScript = '',
} = tool.data;

const cleanName = (name || title || id)
  .replace(/\s*\|\s*Toolkit Gen.*$/i, '')
  .trim();

// Preprocess math at build time
const { html: processedArticleHtml, hasMath: articleHasMath } = processMath(articleHtml || '');
const { html: processedToolHtml, hasMath: toolHasMath } = processMath(toolHtml || '');
const { html: processedQuickAnswer, hasMath: qaHasMath } = processMath(quickAnswer || '');
const hasMath = articleHasMath || toolHasMath || qaHasMath;
---

<ToolLayout
  id={id}
  name={cleanName}
  title={title}
  description={description}
  category={category}
  quickAnswer={processedQuickAnswer}
  faq={faq}
  howTo={howTo}
  related={related}
  hotTools={hotTools}
  recommendedTool={recommendedTool}
  diagnosticTools={diagnosticTools}
  relatedGuides={relatedGuides}
  datePublished={datePublished}
  dateModified={dateModified}
  hasMath={hasMath}
>
  <div slot="tool-ui">
    {externalScripts && externalScripts.length > 0 && (
      <script is:inline define:vars={{ scripts: externalScripts }}>
        (() => {
          let loaded = false;
          function loadExternalScripts() {
            if (loaded) return;
            loaded = true;
            scripts.forEach((src) => {
              if (!document.querySelector(`script[src="${src}"]`)) {
                const s = document.createElement('script');
                s.src = src;
                s.async = true;
                document.head.appendChild(s);
              }
            });
          }
          // Warm on first pointerenter, focus, or click of tool stage
          const stage = document.getElementById('tool-app-stage');
          if (stage) {
            stage.addEventListener('pointerenter', loadExternalScripts, { once: true, passive: true });
            stage.addEventListener('focusin', loadExternalScripts, { once: true, passive: true });
            stage.addEventListener('click', loadExternalScripts, { once: true, passive: true });
            stage.addEventListener('touchstart', loadExternalScripts, { once: true, passive: true });
          }
        })();
      </script>
    )}

    <!-- Crash Guard Error Boundary Fallback -->
    <div
      id="tool-error-fallback"
      class="hidden p-8 text-center bg-rose-50 border border-rose-200 rounded-2xl my-4 text-slate-800"
    >
      <h3 class="text-base font-bold text-rose-900">This tool could not start</h3>
      <p class="text-xs text-rose-700 mt-1">Calculations run locally in your browser. Please reload to restart your session.</p>
      <div class="mt-4 flex items-center justify-center gap-3">
        <button
          type="button"
          onclick="if (window.resetToolEnvironment) window.resetToolEnvironment(); window.location.reload();"
          class="px-5 py-2.5 bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs rounded-xl transition shadow-xs"
        >
          Reload Tool
        </button>
      </div>
    </div>

    {id === 'amsler_grid_macular' && <AmslerGridIsland client:visible />}
    {id === 'docker_compose_linter' && <DockerLinterIsland client:visible />}
    {id === 'airdrop_web_universal' && <AirDropIsland client:visible />}

    {!['amsler_grid_macular', 'docker_compose_linter', 'airdrop_web_universal'].includes(id) && (
      <div>
        <div class="tool-stage-card overflow-hidden" set:html={processedToolHtml} />
        <script is:inline>
          (() => {
            if (typeof window.Chart === 'undefined') {
              window.Chart = class Chart { constructor() {} destroy() {} update() {} };
            }

            // Mandatory Worker & Resource Tracking Watchdog
            window.__activeWorkers = window.__activeWorkers || [];
            window.__activeMediaStreams = window.__activeMediaStreams || [];
            window.__activeAudioContexts = window.__activeAudioContexts || [];
            window.__activeIntervalIds = window.__activeIntervalIds || new Set();
            window.__activeRafIds = window.__activeRafIds || new Set();

            const origWorker = window.Worker;
            if (typeof origWorker === 'function') {
              window.Worker = function(scriptURL, options) {
                const w = new origWorker(scriptURL, options);
                window.__activeWorkers.push(w);
                return w;
              };
            }

            const origInterval = window.setInterval;
            window.setInterval = function(fn, ms, ...args) {
              const id = origInterval.call(window, fn, ms, ...args);
              window.__activeIntervalIds.add(id);
              return id;
            };
            const origClearInterval = window.clearInterval;
            window.clearInterval = function(id) {
              window.__activeIntervalIds.delete(id);
              origClearInterval.call(window, id);
            };

            const origRaf = window.requestAnimationFrame;
            window.requestAnimationFrame = function(cb) {
              let id;
              id = origRaf.call(window, (t) => {
                window.__activeRafIds.delete(id);
                cb(t);
              });
              window.__activeRafIds.add(id);
              return id;
            };
            const origCancelRaf = window.cancelAnimationFrame;
            window.cancelAnimationFrame = function(id) {
              window.__activeRafIds.delete(id);
              origCancelRaf.call(window, id);
            };

            // Shared runWithTimeout helper for worker processing
            window.runWithTimeout = function(worker, payload, timeoutMs = 5000) {
              return new Promise((resolve, reject) => {
                let timer = setTimeout(() => {
                  try { worker.terminate(); } catch (e) {}
                  reject(new Error('Operation timed out — try smaller input'));
                }, timeoutMs);
                worker.onmessage = (e) => {
                  clearTimeout(timer);
                  resolve(e.data);
                };
                worker.onerror = (e) => {
                  clearTimeout(timer);
                  reject(e);
                };
                worker.postMessage(payload);
              });
            };

            function cleanupAllResources() {
              window.__activeRafIds.forEach(id => {
                try { origCancelRaf.call(window, id); } catch (e) {}
              });
              window.__activeRafIds.clear();

              window.__activeIntervalIds.forEach(id => {
                try { origClearInterval.call(window, id); } catch (e) {}
              });
              window.__activeIntervalIds.clear();

              window.__activeWorkers.forEach(w => {
                try { w.terminate(); } catch (e) {}
              });
              window.__activeWorkers = [];

              window.__activeMediaStreams.forEach(stream => {
                try { stream.getTracks().forEach(track => track.stop()); } catch (e) {}
              });
              window.__activeMediaStreams = [];

              window.__activeAudioContexts.forEach(ctx => {
                try { ctx.close(); } catch (e) {}
              });
              window.__activeAudioContexts = [];
            }

            window.addEventListener('pagehide', cleanupAllResources, { passive: true });
            window.addEventListener('beforeunload', cleanupAllResources, { passive: true });
            window.resetToolEnvironment = cleanupAllResources;

            // Watchdog: detect blank tool render or fatal initialization failure within 5s
            setTimeout(() => {
              try {
                const stage = document.getElementById('tool-app-stage');
                const card = stage ? stage.querySelector('.tool-stage-card') : null;
                const fallback = document.getElementById('tool-error-fallback');
                if (card && (!card.firstElementChild || card.offsetHeight < 20)) {
                  if (fallback) fallback.classList.remove('hidden');
                }
              } catch (e) {}
            }, 5000);
          })();
        </script>
        {toolScript && (
          <script
            is:inline
            type={/^\s*import\b/m.test(toolScript) ? 'module' : undefined}
            set:html={toolScript}
          />
        )}
      </div>
    )}
  </div>

  <div slot="article" set:html={processedArticleHtml} />
</ToolLayout>
