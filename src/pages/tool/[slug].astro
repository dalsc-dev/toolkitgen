---
import { getCollection, type CollectionEntry } from 'astro:content';
import ToolLayout from '@layouts/ToolLayout.astro';
import AmslerGridIsland from '@tools/amsler_grid_macular/AmslerGridIsland';
import DockerLinterIsland from '@tools/docker_compose_linter/DockerLinterIsland';
import AirDropIsland from '@tools/airdrop_web_universal/AirDropIsland';
import { processMath } from '@lib/math';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  const catalogSummary = tools.map((t) => {
    const cleanName = (t.data.name || t.data.title || t.data.id)
      .replace(/\s*\|\s*Toolkit Gen.*$/i, '')
      .trim();
    return {
      id: t.data.id,
      name: cleanName,
      title: `${cleanName} | Toolkit Gen`,
      category: t.data.category,
      description: t.data.description,
      featured: t.data.featured,
    };
  });

  return tools.map((tool) => ({
    params: { slug: tool.data.id },
    props: { tool, allTools: catalogSummary },
  }));
}

interface Props {
  tool: CollectionEntry<'tools'>;
  allTools: Array<{
    id: string;
    name: string;
    title: string;
    category: string;
    description: string;
    featured?: boolean;
  }>;
}

const { tool, allTools } = Astro.props;
const {
  id,
  name,
  title,
  description,
  category,
  quickAnswer,
  faq,
  howTo,
  related,
  datePublished,
  dateModified,
  externalScripts = [],
  articleHtml,
  toolHtml = '',
  toolScript = '',
} = tool.data;

const cleanName = (name || title || id)
  .replace(/\s*\|\s*Toolkit Gen.*$/i, '')
  .trim();

// Preprocess math at build time
const { html: processedArticleHtml, hasMath: articleHasMath } = processMath(articleHtml || '');
const { html: processedToolHtml, hasMath: toolHasMath } = processMath(toolHtml || '');
const { html: processedQuickAnswer, hasMath: qaHasMath } = processMath(quickAnswer || '');
const hasMath = articleHasMath || toolHasMath || qaHasMath;
---

<ToolLayout
  id={id}
  name={cleanName}
  title={title}
  description={description}
  category={category}
  quickAnswer={processedQuickAnswer}
  faq={faq}
  howTo={howTo}
  related={related}
  allTools={allTools}
  datePublished={datePublished}
  dateModified={dateModified}
  hasMath={hasMath}
>
  <div slot="tool-ui">
    {externalScripts && externalScripts.map((src: string) => (
      <script src={src} is:inline defer></script>
    ))}

    {id === 'amsler_grid_macular' && <AmslerGridIsland client:visible />}
    {id === 'docker_compose_linter' && <DockerLinterIsland client:visible />}
    {id === 'airdrop_web_universal' && <AirDropIsland client:visible />}

    {!['amsler_grid_macular', 'docker_compose_linter', 'airdrop_web_universal'].includes(id) && (
      <div>
        <div class="tool-stage-card overflow-hidden" set:html={processedToolHtml} />
        {toolScript && (
          <script
            is:inline
            defer
            type={/^\s*import\b/m.test(toolScript) ? 'module' : undefined}
            src={`/assets/tools/${id}.js`}
          />
        )}
      </div>
    )}
  </div>

  <div slot="article" set:html={processedArticleHtml} />
</ToolLayout>
