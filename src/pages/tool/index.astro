---
import BaseLayout from '@layouts/BaseLayout.astro';
import ToolCard from '@components/ToolCard.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { generateJsonLd } from '@lib/schema';

const tools = await getCollection('tools');

// Unique categories
const categories = Array.from(new Set(tools.map((t) => t.data.category))).sort();

const jsonLd = generateJsonLd({
  type: 'website',
  title: 'All Tools & Categories | Toolkit Gen Directory',
  description: 'Browse our complete directory of free online tools, calculators, and converters categorized by Health, Developer utilities, DevOps, and Privacy.',
  url: 'https://toolkitgen.com/tool',
  breadcrumbs: [
    { name: 'Home', url: '/' },
    { name: 'Directory', url: '/tool' },
  ],
});
---

<BaseLayout
  title="All Tools & Categories | Toolkit Gen Directory"
  description="Browse our complete directory of free online tools, calculators, and converters categorized by Health, Developer utilities, DevOps, and Privacy."
  canonical="https://toolkitgen.com/tool"
  jsonLd={jsonLd}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <Breadcrumbs items={[{ name: 'Directory', url: '/tool' }]} />

    <section class="space-y-4">
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        Tools &amp; Utilities Directory
      </h1>
      <p class="text-sm text-slate-600 max-w-2xl leading-relaxed">
        Explore all {tools.length} active browser-based tools. Calculations run in your browser, and your inputs are not uploaded to our servers.
      </p>

      <!-- Category Filter Tabs -->
      <div class="flex flex-wrap gap-2 pt-4" id="tool-category-tabs">
        <button
          type="button"
          class="category-filter-btn px-4 py-2 text-xs font-bold rounded-xl bg-slate-900 text-white shadow-xs transition-all"
          data-filter="all"
        >
          All Tools ({tools.length})
        </button>
        {categories.map((cat) => (
          <button
            type="button"
            class="category-filter-btn px-4 py-2 text-xs font-bold rounded-xl bg-white border border-slate-200/80 text-slate-600 hover:bg-slate-50 transition-all"
            data-filter={cat}
          >
            {cat}
          </button>
        ))}
      </div>
    </section>

    <!-- Tools Grid -->
    <section class="my-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="directory-grid">
        {tools.map((tool) => (
          <ToolCard
            id={tool.data.id}
            name={tool.data.title || tool.data.name}
            description={tool.data.description}
            category={tool.data.category}
            featured={tool.data.featured}
            tags={tool.data.tags}
          />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const filterBtns = document.querySelectorAll('.category-filter-btn');
    const directoryGrid = document.getElementById('directory-grid');

    function applyFilter(cat) {
      filterBtns.forEach((b) => {
        const filterVal = b.getAttribute('data-filter');
        if (filterVal === cat) {
          b.classList.remove('bg-white', 'border', 'border-slate-200/80', 'text-slate-600');
          b.classList.add('bg-slate-900', 'text-white', 'shadow-xs');
        } else {
          b.classList.remove('bg-slate-900', 'text-white', 'shadow-xs');
          b.classList.add('bg-white', 'border', 'border-slate-200/80', 'text-slate-600');
        }
      });

      if (!directoryGrid) return;
      const cards = directoryGrid.querySelectorAll('[data-category]');

      cards.forEach((card) => {
        const itemCat = card.getAttribute('data-category') || '';
        if (cat === 'all' || itemCat.toLowerCase().includes(cat.toLowerCase())) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    }

    if (directoryGrid) {
      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const cat = btn.getAttribute('data-filter') || 'all';
          applyFilter(cat);
        });
      });
    }

    // Support for URL hash anchors e.g. /tool#health, /tool#devops, /tool#finance, /tool#hardware, /tool#ai
    function checkHashAnchor() {
      const hash = window.location.hash.toLowerCase().replace('#', '');
      if (!hash) return;
      const matchBtn = Array.from(filterBtns).find((btn) => {
        const filter = (btn.getAttribute('data-filter') || '').toLowerCase();
        return filter.includes(hash);
      });
      if (matchBtn) {
        matchBtn.click();
      }
    }

    window.addEventListener('hashchange', checkHashAnchor);
    if (window.location.hash) {
      setTimeout(checkHashAnchor, 100);
    }
  })();
</script>
