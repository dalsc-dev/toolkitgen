---
import BaseLayout from '@layouts/BaseLayout.astro';
import ToolCard from '@components/ToolCard.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { generateJsonLd } from '@lib/schema';
import { CANONICAL_CATEGORIES, getCanonicalCategory } from '@lib/taxonomy';

const tools = await getCollection('tools');
const totalTools = tools.length;

// Group tools by canonical category
const categorizedTools = CANONICAL_CATEGORIES.map((cat) => {
  const matchingTools = tools.filter((t) => {
    const canonical = getCanonicalCategory(t.data.category);
    return canonical.id === cat.id;
  });
  return {
    ...cat,
    tools: matchingTools,
  };
});

const jsonLd = generateJsonLd({
  type: 'website',
  title: 'All Tools & Utilities Directory | Toolkit Gen',
  description: `Browse our complete directory of ${totalTools} free online tools, calculators, and converters categorized across 13 core disciplines. Calculations run in your browser.`,
  url: 'https://toolkitgen.com/tool',
  breadcrumbs: [
    { name: 'Home', url: '/' },
    { name: 'Directory', url: '/tool' },
  ],
});
---

<BaseLayout
  title="All Tools & Utilities Directory | Toolkit Gen"
  description={`Browse our complete directory of ${totalTools} free online tools, calculators, and converters categorized across 13 core disciplines. Calculations run in your browser.`}
  canonical="https://toolkitgen.com/tool"
  jsonLd={jsonLd}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <Breadcrumbs items={[{ name: 'Directory', url: '/tool' }]} />

    <!-- Directory Header Block -->
    <header class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200/80 shadow-xs space-y-6">
      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-orange-50 text-[#EE6C4D] border border-orange-200/70">
          <span>Complete Catalog</span>
          <span class="w-1.5 h-1.5 rounded-full bg-[#EE6C4D]"></span>
          <span>{totalTools} Utilities</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 tracking-tight leading-tight">
          Tools &amp; Utilities Directory
        </h1>
        <p class="text-base sm:text-lg text-slate-600 max-w-3xl leading-relaxed">
          Explore all {totalTools} free utilities across engineering, finance, health, and productivity. Calculations execute locally in your browser, and your inputs are not uploaded to our servers.
        </p>
      </div>

      <!-- Quick Search Bar -->
      <div class="pt-2 max-w-xl">
        <div class="relative">
          <input
            type="search"
            id="directory-search-input"
            placeholder="Search all tools by name, tag, or function..."
            class="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#EE6C4D] focus:bg-white transition-all shadow-inner"
            aria-label="Search directory"
          />
          <div class="absolute left-3.5 top-3.5 text-slate-400 pointer-events-none" aria-hidden="true">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
        </div>
      </div>
    </header>

    <!-- Sticky Category Filter Chips -->
    <nav
      id="sticky-category-chips"
      class="sticky top-16 sm:top-20 z-30 bg-[#f8fafc]/95 backdrop-blur-md py-3 -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8 border-y border-slate-200/80 transition-all"
      aria-label="Directory Categories"
    >
      <div class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none">
        <a
          href="#top"
          class="category-chip shrink-0 px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all bg-slate-900 text-white shadow-xs"
          data-target="all"
        >
          All ({totalTools})
        </a>
        {categorizedTools.map((cat) => (
          <a
            href={`#${cat.id}`}
            class="category-chip shrink-0 px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all bg-white border border-slate-200/80 text-slate-600 hover:text-slate-900 hover:bg-slate-50 shadow-2xs"
            data-target={cat.id}
          >
            {cat.name} ({cat.tools.length})
          </a>
        ))}
      </div>
    </nav>

    <!-- Anchored Category Sections -->
    <div class="space-y-16" id="directory-sections">
      {categorizedTools.map((cat) => (
        <section id={cat.id} class="category-section scroll-mt-36 sm:scroll-mt-40 space-y-6">
          <div class="border-b border-slate-200/80 pb-4">
            <div class="flex items-center justify-between gap-4">
              <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight flex items-center gap-3">
                <span>{cat.name}</span>
                <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600 border border-slate-200/60">
                  {cat.tools.length}
                </span>
              </h2>
              <a
                href="#sticky-category-chips"
                class="text-xs font-semibold text-[#EE6C4D] hover:underline hidden sm:inline-block"
              >
                Back to top
              </a>
            </div>
            <p class="text-xs sm:text-sm text-slate-500 mt-1.5 max-w-3xl leading-relaxed">
              {cat.description}
            </p>
          </div>

          <!-- Responsive Card Grid: 1 col (320-639), 2 (640-1023), 3 (1024-1535), 4 (1536+) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4 gap-6">
            {cat.tools.map((tool) => (
              <ToolCard
                id={tool.data.id}
                name={tool.data.name || tool.data.title}
                description={tool.data.description}
                category={cat.name}
                featured={tool.data.featured}
                tags={tool.data.tags}
              />
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- No Search Results Fallback -->
    <div id="no-search-results" class="hidden text-center py-16 bg-white rounded-3xl border border-slate-200 p-8 space-y-3">
      <h3 class="text-lg font-bold text-slate-800">No matching tools found</h3>
      <p class="text-sm text-slate-500 max-w-md mx-auto">
        Try adjusting your search terms or browse the categorized sections above.
      </p>
      <button
        type="button"
        id="clear-search-btn"
        class="inline-flex items-center gap-2 px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition-colors mt-2"
      >
        Clear Search Filter
      </button>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const searchInput = document.getElementById('directory-search-input');
    const clearBtn = document.getElementById('clear-search-btn');
    const noResults = document.getElementById('no-search-results');
    const sectionsContainer = document.getElementById('directory-sections');
    const chips = document.querySelectorAll('.category-chip');

    const sections = Array.from(document.querySelectorAll('.category-section'));

    function filterDirectory(query) {
      const q = query.toLowerCase().trim();
      let totalVisible = 0;

      sections.forEach((sec) => {
        const secCards = Array.from(sec.querySelectorAll('[data-tool-id]'));
        let secVisible = 0;

        secCards.forEach((card) => {
          const text = (card.textContent || '').toLowerCase();
          const tags = (card.getAttribute('data-tags') || '').toLowerCase();
          const matches = !q || text.includes(q) || tags.includes(q);

          if (matches) {
            card.style.display = '';
            secVisible++;
            totalVisible++;
          } else {
            card.style.display = 'none';
          }
        });

        // Hide section heading if no cards match in this section
        if (secVisible === 0) {
          sec.style.display = 'none';
        } else {
          sec.style.display = '';
        }
      });

      if (noResults) {
        if (totalVisible === 0) {
          noResults.classList.remove('hidden');
          if (sectionsContainer) sectionsContainer.classList.add('hidden');
        } else {
          noResults.classList.add('hidden');
          if (sectionsContainer) sectionsContainer.classList.remove('hidden');
        }
      }
    }

    searchInput?.addEventListener('input', (e) => {
      filterDirectory(e.target.value);
    });

    clearBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      filterDirectory('');
    });

    // Active chip highlight on scroll
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            chips.forEach((chip) => {
              const target = chip.getAttribute('data-target');
              if (target === id) {
                chip.classList.remove('bg-white', 'text-slate-600', 'border-slate-200/80');
                chip.classList.add('bg-slate-900', 'text-white', 'shadow-xs');
              } else {
                chip.classList.remove('bg-slate-900', 'text-white', 'shadow-xs');
                chip.classList.add('bg-white', 'text-slate-600', 'border-slate-200/80');
              }
            });
          }
        });
      },
      { rootMargin: '-20% 0px -70% 0px' }
    );

    sections.forEach((sec) => observer.observe(sec));
  })();
</script>
