{
  "extends": "astro/tsconfigs/strict",
  "include": ["src/**/*", "env.d.ts", ".astro/types.d.ts"],
  "exclude": ["node_modules", "dist", "legacy", "scripts", "scratch"],
  "compilerOptions": {
    "strict": true,
    "strictNullChecks": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@lib/*": ["src/lib/*"],
      "@tools/*": ["src/tools/*"],
      "@content/*": ["src/content/*"]
    }
  }
}
